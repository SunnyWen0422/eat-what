/* Shared current-meal view for Today, result and assistant routes. */
.workspace-screen{background:#F8F7F2}.workspace-context{flex-wrap:wrap;margin:20px 0;gap:8px}.workspace-context button{margin:0;font-size:1em}.workspace-requirements{min-height:96px;height:96px;font-size:1em;margin-top:12px}.workspace-dish{padding:12px 0;border-bottom:1px solid #D9E1D5}.workspace-dish-title{display:flex;align-items:center;gap:12px;width:100%;text-align:left;background:white;font-size:1.14em;margin:0 0 8px;padding:8px 0;line-height:1.5}.workspace-success{width:140px;height:125px;display:block;margin:auto}.workspace-screen .ew-heading{font-size:1.714em}.workspace-screen .ew-subtitle,.workspace-screen .ew-muted{font-size:.929em}.workspace-screen .ew-error,.workspace-screen .ew-notice{font-size:.929em}.workspace-screen .mobile-scroll-content{padding-bottom:32px}.workspace-screen .ew-pill{padding:0 12px}.workspace-screen .ew-bottom{flex-shrink:0}.workspace-screen textarea{box-sizing:border-box}
@media(max-width:360px){.workspace-context{gap:4px}.workspace-context .ew-pill{padding:0 8px}.workspace-dish .ew-row{flex-wrap:wrap}.workspace-screen .mobile-scroll-content{padding:12px}}
