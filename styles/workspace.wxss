 0}.workspace-reasons text{display:block;margin-bottom:4px}.workspace-light-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:8px 0}.workspace-next{margin:20px 0 8px}.workspace-next-row{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;margin:0;padding:16px 0;border-bottom:1px solid #E6EAE1;background:transparent;text-align:left;line-height:1.5;color:#25332B;border-radius:0}.workspace-next-row::after{border:0}.workspace-next-row>view{flex:1;min-width:0}.workspace-next-row text{display:block}.workspace-next-row .ew-muted{margin-top:4px}.workspace-assistant-menu{padding:16px;border-radius:18px;background:#FFFFFF;margin:16px 0}.workspace-assistant-menu>text{display:block;margin:8px 0}.workspace-assistant-menu ui-button{display:block;margin-top:16px}.workspace-legacy{margin-top:24px}.workspace-feedback{margin:8px 0}.workspace-screen .ew-bottom{flex-shrink:0}.workspace-screen .ew-heading{font-size:1.714286em}.workspace-screen textarea{box-sizing:border-box}.mode-assistant .workspace-expression{margin-top:16px}
