server:
  port: ${SERVER_PORT:8080}
  servlet:
    context-path: /api

spring:
  datasource:
    url: ${DB_URL:jdbc:mysql://127.0.0.1:3306/food?useSSL=false&serverTimezone=Asia/Shanghai}
    username: ${DB_USER:food}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: ${DB_POOL_MAX:10}
      minimum-idle: ${DB_POOL_MIN:2}
      connection-timeout: 30000
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: GMT+8
    default-property-inclusion: non_null

mybatis:
  type-aliases-package: com.eatwhat.entity
  mapper-locations: classpath:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

wechat:
  miniapp:
    appid: ${WECHAT_APPID}
    secret: ${WECHAT_SECRET}

recommend:
  service:
    base-url: ${RECOMMEND_SERVICE_BASE_URL:http://127.0.0.1:8000}
recommendation:
  preferences:
    enabled: ${RECOMMENDATION_PREFERENCES_ENABLED:true}

security:
  token:
    secret: ${TOKEN_SECRET}
    ttl-millis: ${TOKEN_TTL_MILLIS:2592000000}
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:https://chishenme.icu,https://www.chishenme.icu}

ai:
  protection:
    anonymous-requests-per-minute: ${AI_ANONYMOUS_REQUESTS_PER_MINUTE:6}
    authenticated-requests-per-minute: ${AI_AUTHENTICATED_REQUESTS_PER_MINUTE:30}
    max-in-flight: ${AI_MAX_IN_FLIGHT:4}
    max-body-bytes: ${AI_MAX_BODY_BYTES:8192}
    window-millis: ${AI_RATE_WINDOW_MILLIS:60000}

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: never
      probes:
        enabled: true
  metrics:
    tags:
      application: ${spring.application.name:eatwhat-backend}

admin:
  user-ids: ${ADMIN_USER_IDS:}

logging:
  pattern:
    level: "%5p [requestId:%X{requestId:-}]"
  level:
    com.eatwhat: info
    org.springframework.web: info

meal-workspace:
  enabled: ${MEAL_WORKSPACE_ENABLED:false}
  service-token: ${MEAL_WORKSPACE_SERVICE_TOKEN:}
