<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px">
  <view class="ew-row ew-between calendar-heading"><view><text class="ew-heading">日历</text><text class="ew-subtitle">安排三餐并保存计划，吃过后再记录饮食。</text></view><view class="calendar-heading-actions"><text aria-role="button" class="ew-hit-target ew-link" bindtap="onReview">饮食回顾</text><text aria-role="button" class="ew-hit-target ew-link" bindtap="onToday">今天</text></view></view>
  <view class="ew-tabs"><view aria-role="button" class="ew-hit-target ew-pill {{viewMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="onModeChange">本周</view><view aria-role="button" class="ew-hit-target ew-pill {{viewMode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="onModeChange">月历</view></view>
  <view class="ew-card calendar-card"><view class="ew-row ew-between period"><button class="ew-hit-target period-nav" bindtap="onPrevMonth" aria-label="上一周期"><ui-icon name="arrow-left" tone="muted" size="20" /></button><text>{{rangeLabel}}</text><button class="ew-hit-target period-nav" bindtap="onNextMonth" aria-label="下一周期"><ui-icon class="rotate-right" name="arrow-left" tone="muted" size="20" /></button></view>
    <view wx:if="{{viewMode === 'month'}}" class="month-weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="day-grid"><view aria-role="button" class="ew-hit-target day {{item.selected ? 'selected' : ''}}" wx:for="{{days}}" wx:key="key" data-date="{{item.fullDate}}" bindtap="onSelectDate"><block wx:if="{{!item.blank}}"><text wx:if="{{viewMode === 'week'}}" class="weekday">{{item.weekLabel}}</text><text class="day-number">{{item.day}}</text><text class="day-mark">{{item.eaten ? '✓' : item.hasPlan ? '•' : item.isToday ? '今' : ''}}</text></block></view></view>
    <text class="ew-muted">• 有安排　✓ 已记录实际用餐</text>
  </view>
  <ui-state wx:if="{{!authenticated}}" kind="auth" title="登录后查看用餐计划" description="计划与实际记录会保存到你的账号。" action-label="去登录" bind:action="onLogin" />
  <ui-state wx:elif="{{loading && !mealCards.length}}" kind="loading" title="正在读取安排" />
  <block wx:else><view wx:if="{{errorMessage}}" class="ew-notice">{{errorMessage}}<text aria-role="button" class="ew-hit-target ew-link" bindtap="loadRecipeRecords">重试</text></view><text class="ew-section-title">{{selectedDate}} 的三餐</text>
    <meal-card wx:for="{{mealCards}}" wx:key="mealType" clickable="{{false}}" title="{{item.label}}" name="{{item.dishSummary || (item.status === 'skipped' ? '这餐没吃' : item.plan ? item.plan.recipeName : '还没有安排')}}" status="{{item.statusLabel}}" description="{{item.status === 'unrecorded' ? '未记录不代表没吃' : ''}}"><button class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onOpenMeal">{{item.status === 'eaten' ? '查看饮食记录' : item.plan ? '查看与调整安排' : '安排这一餐'}}<ui-icon name="chevron-right" tone="muted" size="16" /></button></meal-card>
  </block>
  <view wx:if="{{!selectMode}}" class="calendar-secondary-actions"><button class="ew-hit-target calendar-action-row" bindtap="onPurchaseRange">准备本周期食材<ui-icon name="chevron-right" tone="muted" size="16" /></button><button class="ew-hit-target calendar-action-row" bindtap="onShoppingList">购物清单<ui-icon name="chevron-right" tone="muted" size="16" /></button><button class="ew-hit-target calendar-action-row" bindtap="onAssistant">让助手安排<ui-icon name="chevron-right" tone="muted" size="16" /></button></view>
</view>
