/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
.period { font-size:0.75em; color:#56645B; gap:8rpx; } .period-nav { margin:0; width:88rpx; padding:0; background:#EDF3ED; color:#28634E; font-size:1.125em; border-radius:20rpx; }
.day-grid { display:grid; grid-template-columns:repeat(7,minmax(44px,1fr)); gap:6rpx; margin:24rpx 0; } .day { min-width:44px; min-height:44px; border-radius:20rpx; text-align:center; padding:8rpx 0; box-sizing:border-box; } .day.selected { background:#28634E; color:#FFFFFF; } .weekday,.day-mark { display:block; font-size:0.75em; min-height:26rpx; } .day-number { display:block; font-size:1em; font-weight:500; } .day-mark { color:#28634E; } .selected .day-mark { color:white; }

/* Shared finish for legacy pages; layout and permission-specific states remain local. */
.ew-page { background:#F8F7F2; color:#25332B; }
.ew-page .btn-primary, .ew-page .primary-btn, .ew-page .save-btn, .ew-page .primary-action, .ew-page .generate-btn { background:#28634E; border-radius:24rpx; }
.ew-page .choice-chip, .ew-page .ingredient-chip, .ew-page .count-btn, .ew-page .clear-btn, .ew-page .period-nav, .ew-page .filter-chip { min-height:44px; min-width:44px; box-sizing:border-box; }

.month-weekdays { display:grid; grid-template-columns:repeat(7,minmax(44px,1fr)); gap:6rpx; text-align:center; font-size:0.75em; color:#56645B; margin-top:24rpx; }
@media (max-width:400px) {
  /* Seven date targets need at least 308px on a 320px device. */
  .calendar-card { margin-left:-28rpx; margin-right:-28rpx; padding-left:4rpx; padding-right:4rpx; }
  .calendar-card .day-grid, .calendar-card .month-weekdays { gap:0; }
}

/* Input and touch minima remain fixed under small screens/font changes. */
.ew-page button,.ew-page input,.ew-page .count-btn,.ew-page .choice-chip,.ew-page .filter-chip,.ew-page .date-picker{min-height:44px;box-sizing:border-box}
.ew-page .primary-btn,.ew-page .save-btn,.ew-page .primary-action,.ew-page .wx-login-btn{min-height:48px}

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }

button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }

.calendar-card{background:transparent;border:0;border-radius:0;margin-left:-10px;margin-right:-10px;padding:12px 0}.day-grid{grid-template-columns:repeat(7,minmax(44px,1fr));gap:0}.day{min-width:44px;min-height:60px;box-sizing:border-box;padding:8px 0;border:0;border-radius:14px;height:auto}.day.selected{background:#28634E;color:#FFFFFF}.day-number{font-size:1em}.weekday{font-size:0.75em}.period{padding:0 8px}.meal-list .ew-card{border:0}.meal-link{border:0;border-bottom:1px solid #B8C5B8;background:transparent;border-radius:0;box-shadow:none}

.calendar-heading { flex-wrap:wrap; align-items:center; gap:8px; }
.ew-page .calendar-heading > view:first-child { flex:1 1 160px; min-width:0; }
.calendar-heading-actions { display:flex; flex-wrap:wrap; gap:4px; }
.calendar-heading-actions .ew-link { margin:0; padding:0 4px; font-size:0.875em; }
.calendar-heading .ew-heading { font-size:1.5em; }

.calendar-card button.day { display:flex; flex-direction:column; align-items:center; justify-content:flex-start; width:100%; max-width:100%; min-height:44px; margin:0; padding:4px 0; background:transparent; color:#25332B; border-radius:10px; font-size:1em; font-family:inherit; line-height:1.25; white-space:normal; }
.calendar-card button.day::after { border:0; }
.calendar-card .weekday { min-height:0; line-height:1.25; color:#56645B; }
.calendar-card .day-number { display:flex; align-items:center; justify-content:center; min-width:32px; min-height:32px; padding:0 2px; border-radius:50%; box-sizing:border-box; font-size:1em; line-height:1.25; }
.calendar-card .day.selected .day-number { color:#FFFFFF; background:#28634E; }
.calendar-card .day.selected .weekday { color:#28634E; }
.calendar-legend { font-size:0.75em; line-height:1.5; }

/* Text marks coexist and stay distinct without color. */
.calendar-card .day-mark { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:2px; min-height:14px; color:#28634E; font-size:0.75em; line-height:1.2; }
.day-plan,.day-actual { display:inline-block; min-width:1em; }
.day-actual { font-weight:500; }
