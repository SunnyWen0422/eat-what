<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px"><text class="ew-heading">本机启动记录</text><text class="ew-subtitle">用于查看这台设备的小程序启动时间。</text><ui-state wx:if="{{!logs.length}}" kind="empty" title="暂无启动记录" description="之后打开小程序时会记录启动时间。" /><view wx:else class="ew-card"><view class="log-row" wx:for="{{logs}}" wx:key="index">{{item.date}}</view><button class="ew-hit-target ew-button danger" bindtap="onClear">清空本机记录</button></view></view>
