.preview-page { min-height: 100vh; padding: 24rpx 24rpx 150rpx; background: #f6f8f7; box-sizing: border-box; }
.toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.toolbar-title { font-size: 38rpx; font-weight: 700; color: #1f2d27; }
.people-control { display: flex; align-items: center; gap: 12rpx; color: #61716a; font-size: 26rpx; }
.people-control input { width: 90rpx; padding: 10rpx 14rpx; background: #fff; border: 1rpx solid #dce6e1; border-radius: 8rpx; text-align: center; }
.notice, .loading, .empty { padding: 20rpx; margin-bottom: 16rpx; background: #fff; border-radius: 8rpx; color: #5d6d65; }
.warning-block, .warning { color: #b66a14; }
.dish-group { margin-bottom: 18rpx; background: #fff; border-radius: 8rpx; overflow: hidden; }
.dish-header { display: flex; justify-content: space-between; padding: 22rpx; background: #eaf5ef; color: #36745a; }
.dish-name { font-weight: 700; color: #1e4f3a; }
.ingredient-row { padding: 20rpx 22rpx; border-top: 1rpx solid #edf1ef; }
.ingredient-main { display: flex; justify-content: space-between; font-size: 30rpx; }
.quantity { font-weight: 700; color: #243d31; }
.row-actions { display: flex; justify-content: flex-end; gap: 28rpx; margin-top: 10rpx; color: #4b8c6d; font-size: 25rpx; }
.empty-group { padding: 22rpx; color: #84948c; }
.bottom-actions { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 20rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 18rpx rgba(29, 63, 47, .08); }
.bottom-actions button { flex: 1; border-radius: 8rpx; }
.bottom-actions .primary { color: #fff; background: #2ba471; }
