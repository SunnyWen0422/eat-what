<view class="ew-page ew-screen shopping-preview-page" style="font-size:{{fontBase * fontScale}}px;padding-bottom:{{previewActionHeight}}px">
  <view class="ew-heading">确认食材</view>
  <view class="preview-context"><text class="ew-grow">{{contextLabel}}</text><button class="ew-hit-target ew-link" disabled="{{confirmInFlight || outcomeUnknown || resultMessage || previewLoading}}" bindtap="onPeopleOptions" aria-label="调整用餐人数">{{peopleLabel}}<ui-icon name="chevron-right" tone="muted" size="16" /></button></view>
  <view wx:if="{{unknownMessage}}" class="ew-notice">{{unknownMessage}}</view>
  <view wx:if="{{resultMessage}}" class="ew-notice" aria-role="status">{{resultMessage}}</view>
  <view wx:if="{{errorMessage && !peopleVisible}}" class="ew-notice" aria-role="status">{{errorMessage}}</view>
  <ui-state wx:if="{{previewLoading}}" kind="loading" title="正在计算食材" />
  <ui-state wx:elif="{{!canConfirm && !resultMessage}}" kind="error" title="食材预览暂不可用" description="原来的菜品选择仍然保留" action-label="重新读取" bind:action="loadPreview" />
  <view class="view-tabs"><button class="ew-hit-target ew-link {{viewMode === 'summary' ? 'active' : ''}}" aria-pressed="{{viewMode === 'summary'}}" data-mode="summary" bindtap="onViewMode">食材汇总</button><button class="ew-hit-target ew-link {{viewMode === 'dish' ? 'active' : ''}}" aria-pressed="{{viewMode === 'dish'}}" data-mode="dish" bindtap="onViewMode">按菜查看</button></view>
  <view class="ew-muted view-count">{{itemCount}}项来源食材<text wx:if="{{viewMode === 'summary'}}"> · 合并为{{shoppingView.summaryRowCount}}行</text></view>
  <view wx:if="{{viewMode === 'summary'}}" class="preview-ingredients">
    <view wx:for="{{shoppingView.rows}}" wx:key="key" class="ingredient-row"><view class="ew-grow">{{item.name}}</view><button class="ew-hit-target quantity-readonly" data-key="{{item.key}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onEditRow" aria-label="调整{{item.name}}用量">{{item.quantityLabel}}</button><button class="ew-hit-target source-toggle" data-key="{{item.key}}" bindtap="onSources" aria-label="查看{{item.name}}的{{item.sourceCount}}处来源或标记家里已有"><ui-icon name="chevron-right" tone="muted" size="16" /></button></view>
  </view>
  <block wx:else><view wx:for="{{shoppingView.groups}}" wx:for-item="dish" wx:key="selectionKey" class="preview-dish-group"><button class="ew-hit-target dish-header" data-key="{{dish.selectionKey}}" bindtap="onToggleDish" aria-expanded="{{dish.expanded}}"><view class="ew-grow"><view>{{dish.dishName}}</view><view class="ew-muted">{{dish.contextLabel}} · {{dish.targetPeople}}人 · {{dish.sourceCount}}项</view></view><ui-icon class="dish-chevron {{dish.expanded ? 'expanded' : ''}}" name="chevron-right" tone="muted" size="16" /></button><view wx:if="{{dish.expanded}}"><view wx:for="{{dish.items}}" wx:key="clientKey" class="ingredient-row"><view class="ew-grow">{{item.name}}</view><button class="ew-hit-target quantity-readonly" data-key="{{item.key}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onEditSource" aria-label="调整{{item.name}}用量">{{item.quantityLabel}}</button><button class="ew-hit-target ew-link" data-key="{{item.key}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onRemoveSource">家里有</button></view></view></view></block>
  <view wx:for="{{warnings}}" wx:key="*this" class="ew-notice">{{item}}</view>
  <text class="ew-muted preparation-hint">家里已有的食材可以从本次清单排除。</text>
  <view class="preview-bottom ew-bottom"><ui-button wx:if="{{!resultMessage}}" label="{{outcomeUnknown ? '重试原确认' : '加入购物清单（' + itemCount + '项）'}}" loading="{{confirmInFlight}}" disabled="{{!canConfirm || previewLoading || !itemCount}}" bind:action="onConfirm" /><ui-button wx:else label="查看购物清单" bind:action="onShoppingList" /></view>
  <ui-sheet visible="{{sourcesVisible}}" title="食材来源" bind:close="closeSources"><view wx:for="{{sourceRows}}" wx:key="key" class="source-item"><view>{{item.sourceLabel}}</view><view class="source-actions"><text class="ew-grow">{{item.quantityLabel}}</text><button class="ew-hit-target ew-link" data-dish-index="{{item.dishIndex}}" data-item-index="{{item.itemIndex}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onEditItem">调整用量</button><button class="ew-hit-target ew-link" data-dish-index="{{item.dishIndex}}" data-item-index="{{item.itemIndex}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onRemoveItem">家里有</button></view></view><text wx:if="{{sourceRows.length > 1}}" class="ew-muted">逐项调整来源用量，汇总数量不会自动分摊。</text></ui-sheet>
  <ui-confirm visible="{{peopleVisible}}" title="用餐人数" busy="{{previewLoading}}" confirm-label="应用人数" bind:cancel="closePeople" bind:confirm="onApplyPeople"><ui-field label="统一用餐人数" type="number" maxlength="2" value="{{peopleDraft}}" disabled="{{previewLoading}}" bind:change="onPeopleDraft" /><text class="ew-muted">可靠份量按人数计算；用量未知的保留原文。重新计算前会确认本次修改。</text><text wx:if="{{errorMessage}}" class="ew-error">{{errorMessage}}</text></ui-confirm>
  <ui-confirm visible="{{formVisible}}" title="调整{{editName}}用量" busy="{{confirmInFlight}}" bind:confirm="saveForm" bind:cancel="closeForm"><ui-field disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" label="数量与单位" value="{{formQuantity}}" placeholder="例如：500克、2个或适量" bind:change="onQuantity" /><view class="ew-error">{{formError}}</view></ui-confirm>
</view>
