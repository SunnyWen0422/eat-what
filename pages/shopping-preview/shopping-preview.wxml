<view class="ew-page ew-screen" style="font-size:{{14 * fontScale}}px">
  <view class="ew-heading">准备采购食材</view><view class="ew-subtitle">按餐次保留来源，相同食材在清单汇总。已有食材可以移除。</view>
  <view class="ew-card"><view class="ew-title">{{uniformPeople ? '统一人数' : '按各餐计划人数'}} · {{targetPeople}}人</view><view class="ew-muted">需要统一人数时调整以下数字，会重新生成食材预览。</view><input class="ew-input" type="number" value="{{targetPeople}}" disabled="{{confirmInFlight}}" bindblur="onPeopleChange" /></view>
  <view wx:if="{{errorMessage}}" class="ew-notice">{{errorMessage}}</view>
  <ui-state wx:if="{{previewLoading}}" kind="loading" title="正在计算食材" />
  <ui-state wx:elif="{{!canConfirm}}" kind="error" title="食材预览暂不可用" description="原来的菜品选择仍然保留" action-label="重新读取" bind:action="loadPreview" />
  <view wx:for="{{dishes}}" wx:for-item="dish" wx:for-index="dishIndex" wx:key="selectionKey" class="ew-card"><view class="ew-title">{{dish.dishName}}</view><view class="ew-muted">{{dish.sourceLabel}} · {{dish.targetPeople}}人</view><view wx:for="{{dish.items}}" wx:for-index="itemIndex" wx:key="clientKey" class="ingredient-row"><view class="ew-grow"><view>{{item.displayName}}</view><view class="ew-muted">{{item.quantityText || '用量需调整'}}</view><ui-status wx:if="{{item.calculationStatus !== 'CALCULATED'}}" label="请核对用量" tone="warning" /></view><button class="ew-link" data-dish-index="{{dishIndex}}" data-item-index="{{itemIndex}}" bindtap="onEditItem">编辑</button><button class="ew-link" data-dish-index="{{dishIndex}}" data-item-index="{{itemIndex}}" bindtap="onRemoveItem">已有</button></view><view wx:if="{{!dish.items.length}}" class="ew-muted">这道菜的食材已移除或暂无可解析用量</view></view>
  <view wx:for="{{warnings}}" wx:key="*this" class="ew-notice">{{item}}</view><view class="ew-actions"><ui-button label="返回" variant="secondary" disabled="{{confirmInFlight}}" bind:action="onBack" /><ui-button label="确认加入清单" loading="{{confirmInFlight}}" disabled="{{!canConfirm || previewLoading}}" bind:action="onConfirm" /></view><button class="ew-link" bindtap="onShoppingList">查看购物清单与待确认草稿</button>
  <view class="ew-notice">同一餐次再次采购会更新原来源的用量，已购状态和手动调整会保留。人数变化后请核对已购数量；移除已购或已调整的食材前，需先在清单确认删除。</view>
  <ui-confirm visible="{{formVisible}}" title="调整{{editName}}用量" bind:confirm="saveForm" bind:cancel="closeForm"><ui-field disabled="{{confirmInFlight}}" label="数量与单位" value="{{formQuantity}}" placeholder="例如：500克、2个或适量" bind:change="onQuantity" /><view class="ew-error">{{formError}}</view></ui-confirm>
</view>
