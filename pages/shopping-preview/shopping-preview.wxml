<view class="ew-page ew-screen shopping-preview-page" style="font-size:{{fontBase * fontScale}}px">
  <view class="ew-heading">准备食材</view>
  <view class="ew-card">
    <view wx:for="{{dishes}}" wx:for-item="dish" wx:key="selectionKey" class="meal-label">{{dish.dishName}} · {{dish.targetPeople}}人</view>
    <view class="people-row"><text>{{uniformPeople ? '统一人数' : '按各餐人数'}}，调整为</text><input class="ew-input" type="number" value="{{targetPeople}}" aria-label="统一用餐人数" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindblur="onPeopleChange" /><text>人</text></view>
    <view class="ew-muted">共{{itemCount}}项来源食材 · 家里已有的可从本次准备中排除</view>
    <view wx:if="{{unknownMessage}}" class="ew-notice">{{unknownMessage}}</view>
  </view>
  <view wx:if="{{resultMessage}}" class="ew-notice" aria-role="status">{{resultMessage}}<button class="ew-hit-target ew-link" bindtap="onShoppingList">查看购物清单</button></view>
  <view wx:if="{{errorMessage}}" class="ew-notice" aria-role="status">{{errorMessage}}</view>
  <ui-state wx:if="{{previewLoading}}" kind="loading" title="正在计算食材" />
  <ui-state wx:elif="{{!canConfirm &amp;&amp; !resultMessage}}" kind="error" title="食材预览暂不可用" description="原来的菜品选择仍然保留" action-label="重新读取" bind:action="loadPreview" />
  <view class="view-tabs"><button class="ew-hit-target ew-link" aria-pressed="{{viewMode === 'summary'}}" data-mode="summary" bindtap="onViewMode">汇总</button><button class="ew-hit-target ew-link" aria-pressed="{{viewMode === 'dish'}}" data-mode="dish" bindtap="onViewMode">按菜</button></view>
  <view wx:if="{{viewMode === 'summary'}}" class="ew-card">
    <view wx:for="{{shoppingView.rows}}" wx:key="key" class="ingredient-row"><view class="ew-grow">{{item.name}}</view><text class="quantity-readonly">{{item.quantityLabel}}</text><button class="ew-hit-target ew-link" data-key="{{item.key}}" bindtap="onSources" aria-label="查看{{item.name}}来源并调整">{{item.sourceCount > 1 ? item.sourceCount + '处来源' : '调整'}}</button></view>
  </view>
  <block wx:else><view wx:for="{{shoppingView.groups}}" wx:for-item="dish" wx:for-index="dishIndex" wx:key="selectionKey" class="ew-card"><view class="ew-title">{{dish.dishName}}</view><view class="ew-muted">{{dish.sourceLabel}} · {{dish.targetPeople}}人</view><view wx:for="{{dish.items}}" wx:for-index="itemIndex" wx:key="clientKey" class="ingredient-row"><view class="ew-grow">{{item.name}}</view><text class="quantity-readonly">{{item.quantityLabel}}</text><button class="ew-hit-target ew-link" data-key="{{item.key}}" data-dish-index="{{dishIndex}}" data-item-index="{{itemIndex}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onEditSource">编辑</button><button class="ew-hit-target ew-link" data-key="{{item.key}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onRemoveSource">家里有</button></view></view></block>
  <view wx:for="{{warnings}}" wx:key="*this" class="ew-notice">{{item}}</view>
  <view class="ew-muted">同一餐次重新采购会更新原来源用量，保留已买和手动调整。汇总仅用于阅读，不合并来源。</view>
  <button class="ew-hit-target ew-link" bindtap="onShoppingList">查看购物清单与待确认草稿</button>
  <view class="ew-actions preview-bottom ew-bottom"><ui-button label="返回" variant="secondary" disabled="{{confirmInFlight}}" bind:action="onBack" /><ui-button wx:if="{{!resultMessage}}" label="{{outcomeUnknown ? '重试原确认' : '加入购物清单（' + itemCount + '项）'}}" loading="{{confirmInFlight}}" disabled="{{!canConfirm || previewLoading || !itemCount}}" bind:action="onConfirm" /><ui-button wx:else label="查看购物清单" bind:action="onShoppingList" /></view>
  <ui-sheet visible="{{sourcesVisible}}" title="按来源调整" bind:close="closeSources"><view wx:for="{{sourceRows}}" wx:key="key" class="ingredient-row"><view class="ew-grow"><view>{{item.sourceLabel}}</view><text>{{item.quantityLabel}}</text></view><button class="ew-hit-target ew-link" data-dish-index="{{item.dishIndex}}" data-item-index="{{item.itemIndex}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onEditItem">编辑</button><button class="ew-hit-target ew-link" data-dish-index="{{item.dishIndex}}" data-item-index="{{item.itemIndex}}" disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" bindtap="onRemoveItem">家里有</button></view></ui-sheet>
  <ui-confirm visible="{{formVisible}}" title="调整{{editName}}用量" busy="{{confirmInFlight}}" bind:confirm="saveForm" bind:cancel="closeForm"><ui-field disabled="{{confirmInFlight || outcomeUnknown || resultMessage}}" label="数量与单位" value="{{formQuantity}}" placeholder="例如：500克、2个或适量" bind:change="onQuantity" /><view class="ew-error">{{formError}}</view></ui-confirm>
</view>
