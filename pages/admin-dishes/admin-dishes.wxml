<view class="ew-page page" style="font-size:{{14 * fontScale}}px">
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <block wx:if="{{mode === 'list'}}">
    <view class="heading"><text class="title">菜品管理</text><text class="count">{{total}} 道</text></view>
    <view class="tabs"><button class="{{scope === 'system' ? 'active' : ''}}" data-scope="system" bindtap="switchScope">系统菜品</button><button class="{{scope === 'custom' ? 'active' : ''}}" data-scope="custom" bindtap="switchScope">用户菜品</button></view>
    <view class="search"><input value="{{keywordInput}}" bindinput="onKeyword" bindconfirm="search" confirm-type="search" placeholder="搜索菜名"/><button bindtap="search">搜索</button></view>
    <view class="filters"><picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onType"><view>{{types[typeIndex].label}}⌄</view></picker><picker wx:if="{{scope === 'system'}}" mode="selector" range="{{publishedOptions}}" value="{{publishedIndex}}" bindchange="onPublished"><view>{{publishedOptions[publishedIndex]}}⌄</view></picker></view>
    <view wx:if="{{loading && !ready}}" class="state">正在加载菜品...</view><view wx:elif="{{error && !ready}}" class="state"><text>{{error}}</text><button class="primary" bindtap="retry">重新加载</button></view><view wx:elif="{{ready && !dishes.length}}" class="state">暂无匹配菜品</view>
    <view wx:else class="list"><view class="dish" wx:for="{{dishes}}" wx:key="id" bindtap="openDish" data-id="{{item.id}}"><view class="main"><view class="row"><text class="dish-name">{{item.name}}</text><text wx:if="{{scope === 'system'}}" class="badge {{item.isPublished === 0 ? 'off' : 'on'}}">{{item.isPublished === 0 ? '已下架' : '已发布'}}</text></view><text class="meta">{{item.type}} · ID {{item.id}}{{item.userId ? ' · 用户 ' + item.userId : ''}}</text><text class="ingredients">{{item.cl || item.ingredientsAmounts || '暂无食材信息'}}</text></view><button wx:if="{{scope === 'system'}}" class="status" catchtap="togglePublished" data-id="{{item.id}}" loading="{{updatingId === item.id}}">{{item.isPublished === 0 ? '发布' : '下架'}}</button><text wx:else class="arrow">›</text></view><button wx:if="{{hasMore}}" class="more" bindtap="more" loading="{{loadingMore}}">加载更多</button><text wx:else class="end">已显示全部菜品</text></view>
  </block>
  <view wx:else class="form"><text class="form-title">编辑系统菜品</text><text class="label">菜名</text><input value="{{form.name}}" data-field="name" bindinput="onInput"/><text class="label">分类</text><view class="type-row"><button class="{{form.type === item.code ? 'selected' : ''}}" wx:for="{{types}}" wx:key="code" wx:if="{{item.code}}" data-type="{{item.code}}" bindtap="onFormType">{{item.label}}</button></view><text class="label">食材与用量</text><textarea value="{{form.cl}}" data-field="cl" bindinput="onInput" auto-height/><text class="label">烹饪步骤</text><textarea value="{{form.step}}" data-field="step" bindinput="onInput" auto-height/><text class="label">标签</text><input value="{{form.tags}}" data-field="tags" bindinput="onInput"/><text class="label">烹饪分钟数</text><input value="{{form.cookMinutes}}" type="number" data-field="cookMinutes" bindinput="onInput"/><view class="form-actions"><button bindtap="cancel" disabled="{{saving}}">取消</button><button class="primary" bindtap="save" loading="{{saving}}">保存</button></view></view>
</view>
