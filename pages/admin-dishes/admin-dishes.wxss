page { min-height: 100%; background: #f4f6f5; color: #1f2924; } button::after { border: none; }
.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; } .heading { min-height: 76rpx; display: flex; align-items: baseline; gap: 14rpx; } .title { font-size: 38rpx; font-weight: 700; } .count { color: #78827c; font-size: 23rpx; } .notice { padding: 14rpx 16rpx; margin-bottom: 14rpx; color: #176a47; background: #e3f3eb; border-radius: 8rpx; font-size: 24rpx; }
.tabs { display: grid; grid-template-columns: 1fr 1fr; background: #e8ecea; border-radius: 10rpx; padding: 6rpx; margin-bottom: 14rpx; } .tabs button { min-height: 68rpx; margin: 0; background: transparent; color: #657069; border-radius: 8rpx; font-size: 25rpx; } .tabs button.active { background: #fff; color: #1d6f4e; font-weight: 650; }
.search { display: grid; grid-template-columns: minmax(0, 1fr) 110rpx; gap: 10rpx; } .search input { min-width: 0; height: 80rpx; padding: 0 17rpx; box-sizing: border-box; background: #fff; border: 2rpx solid #dce4df; border-radius: 10rpx; font-size: 26rpx; } .search button, .primary, .more { min-height: 80rpx; background: #237a55; color: #fff; border-radius: 10rpx; font-size: 24rpx; }
.filters { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin: 12rpx 0 16rpx; } .filters picker { min-width: 0; } .filters picker view { min-height: 70rpx; padding: 0 16rpx; display: flex; align-items: center; background: #fff; border: 2rpx solid #dce4df; border-radius: 9rpx; color: #56625b; font-size: 23rpx; }
.state { min-height: 280rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6d7772; gap: 18rpx; } .list { display: flex; flex-direction: column; gap: 12rpx; } .dish { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 14rpx; padding: 20rpx; background: #fff; border: 2rpx solid #e1e7e3; border-radius: 12rpx; } .main { min-width: 0; } .row { display: flex; align-items: center; gap: 10rpx; } .dish-name { font-size: 29rpx; font-weight: 650; word-break: break-word; } .badge { padding: 5rpx 9rpx; border-radius: 7rpx; font-size: 20rpx; } .badge.on { color: #176a47; background: #e3f3eb; } .badge.off { color: #8b5517; background: #fff0d8; } .meta, .ingredients { display: block; margin-top: 7rpx; color: #6d7772; font-size: 22rpx; line-height: 1.45; word-break: break-word; } .ingredients { color: #46524b; } .status { min-width: 88rpx; min-height: 60rpx; margin: 0; padding: 0 10rpx; color: #237a55; background: #f3faf6; border: 2rpx solid #d4e2da; border-radius: 8rpx; font-size: 22rpx; } .arrow { font-size: 42rpx; color: #89928d; } .more { margin-top: 6rpx; } .end { padding: 22rpx; text-align: center; color: #8a948e; font-size: 22rpx; }
.form-title { display: block; margin-bottom: 22rpx; font-size: 31rpx; font-weight: 700; } .label { display: block; margin: 19rpx 0 8rpx; color: #47544d; font-size: 24rpx; font-weight: 600; } .form input, .form textarea { width: 100%; min-height: 80rpx; padding: 16rpx; box-sizing: border-box; background: #fff; border: 2rpx solid #dce4df; border-radius: 10rpx; font-size: 26rpx; } .form textarea { min-height: 160rpx; line-height: 1.5; } .type-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 7rpx; } .type-row button { min-width: 0; min-height: 68rpx; margin: 0; padding: 0; background: #fff; border: 2rpx solid #dce4df; border-radius: 8rpx; font-size: 21rpx; } .type-row .selected { color: #fff; background: #237a55; border-color: #237a55; } .form-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 28rpx; } .form-actions button { min-height: 82rpx; margin: 0; border-radius: 10rpx; font-size: 25rpx; background: #fff; } .form-actions .primary { background: #237a55; color: #fff; }
