<view class="ew-page ew-dish-surface" style="font-size:{{fontBase * fontScale}}px">
  <view class="ew-heading">餐桌助手记录</view>
  <ui-state wx:if="{{errorMessage}}" kind="error" title="历史暂未读到" description="{{errorMessage}}" action-label="重新读取" bind:action="onShow" />
  <ui-state wx:if="{{loading}}" kind="loading" title="正在读取历史" />
  <ui-state wx:if="{{!loading && !errorMessage && !v4Sessions.length && !legacyVisible}}" kind="empty" title="还没有餐桌对话" action-label="回到今天" bind:action="onCurrentMeal" />
  <view wx:for="{{v4Sessions}}" wx:key="sessionId" class="history-entry">
    <button class="ew-hit-target history-session {{v4SessionId === item.sessionId ? 'active' : ''}}" data-id="{{item.sessionId}}" bindtap="onOpenV4Session"><view><text>{{item.label}}</text><view class="ew-muted">{{item.timeLabel}}</view><view wx:if="{{item.statusLabel}}" class="ew-muted">{{item.statusLabel}}</view></view><ui-icon name="chevron-right" tone="muted" size="16" /></button>
    <ui-button label="继续这段对话" variant="secondary" data-id="{{item.sessionId}}" disabled="{{loading || !item.target}}" bind:action="onContinueV4" />
  </view>
  <ui-button wx:if="{{v4NextCursor}}" label="更早的记录" variant="secondary" disabled="{{loading}}" bind:action="onV4More" />
  <view wx:if="{{v4SessionId}}" class="history-content"><view class="ew-title">对话内容</view><view wx:for="{{v4Messages}}" wx:key="id" class="history-message {{item.role === 'user' ? 'history-user' : ''}}"><text class="ew-muted">{{item.role === 'user' ? '你' : '助手'}}</text><view>{{item.text}}</view></view><text wx:if="{{!loading && !v4Messages.length}}" class="ew-muted">这段对话没有保留的文字记录。</text></view>
  <ui-button label="{{legacyVisible ? '收起旧版记录' : '旧版助手记录'}}" variant="tertiary" disabled="{{loading}}" bind:action="onToggleLegacy" />
  <view wx:if="{{legacyVisible}}">
  <button wx:for="{{sessions}}" wx:key="sessionId" class="ew-hit-target history-session {{sessionId === item.sessionId ? 'active' : ''}}" data-id="{{item.sessionId}}" bindtap="onOpenSession"><text>{{item.label}}</text><text wx:if="{{sessionId === item.sessionId}}" class="ew-muted">正在查看</text><ui-icon wx:else name="chevron-right" tone="muted" size="16" /></button>
  <ui-button wx:if="{{nextCursor}}" label="更多历史" variant="secondary" disabled="{{loading}}" bind:action="onMore" />
  <view wx:if="{{sessionId}}" class="history-content"><view class="ew-title">会话内容</view><view wx:for="{{messages}}" wx:key="index" class="history-message {{item.role === 'user' ? 'history-user' : ''}}"><text class="ew-muted">{{item.role === 'user' ? '你' : '助手'}}</text><view>{{item.content}}</view></view><text wx:if="{{!loading && !messages.length}}" class="ew-muted">这段会话没有已保存的消息。</text></view>
  <view wx:for="{{meals}}" wx:key="index" class="ew-glass-card history-meal"><view class="ew-title">{{item.date}} {{item.mealName}} · {{item.people}}人</view><text>{{item.names}}</text><ui-button label="复核并导入这一餐草稿" variant="secondary" data-index="{{index}}" disabled="{{loading}}" bind:action="onImportMeal" /></view>
  </view>
</view>
