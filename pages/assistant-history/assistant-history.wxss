/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
.history-session { width:100%;margin:16rpx 0;white-space:normal; }
.history-message { margin:24rpx 0;white-space:pre-wrap;overflow-wrap:anywhere; }
.ew-page button.history-session { width:100%; max-width:100%; margin:0; white-space:normal; font-family:inherit; font-weight:400; box-sizing:border-box; }

/* Warm table v2: assistant-history */
 .history-session { display:flex; align-items:center; justify-content:space-between; text-align:left; background:#FFFFFF; color:#25332B; border:0; border-bottom:1px solid #E6EAE1; border-radius:0; padding:16px; margin:0; font-size:1em; line-height:1.6; }.history-session.active { background:#EDF3ED; color:#28634E; }.history-message { padding:14px 0; border-bottom:1px solid #E6EAE1; line-height:1.8; font-size:1em; }.history-message > view { white-space:pre-wrap; overflow-wrap:anywhere; }.history-message .ew-muted { font-size:0.75em; margin-bottom:6px; }
.ew-page button.history-session { background:rgba(255,255,255,0.66); border:1px solid rgba(255,255,255,0.74); border-radius:16px; margin:8px 0; }
.ew-page button.history-session.active { background:#EDF3ED; border-color:#7C8E80; }
.history-content { margin:20px 0; }
.history-message { max-width:94%; padding:14px; background:rgba(255,255,255,0.66); border:1px solid rgba(255,255,255,0.74); border-radius:16px 16px 16px 4px; }
.history-message.history-user { margin-left:auto; background:#28634E; color:#FFFFFF; border-color:#28634E; border-radius:16px 16px 4px 16px; }
.history-user .ew-muted { color:#FFFFFF; }
.history-meal { padding:16px; margin:16px 0; }
.history-entry { margin:16px 0; }
.history-entry > ui-button { display:block; margin-top:8px; }

.history-summary { min-width:0; flex:1; }
.history-preview { margin:6px 0; color:#56645B; font-size:0.875em; line-height:1.6; overflow-wrap:anywhere; }
.history-entry { display:flex; align-items:center; gap:8px; }
.ew-page .history-entry > button.history-session { flex:1; width:auto; min-width:0; }
.history-more { flex:none; width:44px; min-width:44px; min-height:44px; font-size:1.25em; }
