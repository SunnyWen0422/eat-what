<block wx:if="{{workspaceEnabled}}"><include src="../../templates/meal-workspace.wxml" /></block>
<block wx:else>
<view class="ew-page ew-dish-surface result-page mobile-screen" style="font-size:{{fontBase * fontScale}}px">
<view wx:if="{{saveError}}" class="ew-error">{{saveError}}</view>
  <!-- 骨架屏加载 -->
  <scroll-view wx:if="{{loading}}" class="skeleton-wrap" scroll-y>
    <view class="generation-status">
      <text class="generation-status-title">{{loadingStage}}</text>
      <text class="generation-status-subtitle">把数量、口味和今天的心情放在一起看看</text>
    </view>
    <view class="skeleton-plan" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-dish" wx:for="{{[1,2,3,4]}}" wx:for-item="n" wx:key="n">
        <view class="skeleton-img shimmer"></view>
        <view class="skeleton-text"><view class="shimmer bar w80"></view><view class="shimmer bar w50"></view></view>
      </view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <scroll-view wx:elif="{{empty}}" class="empty-state" scroll-y>
    
    <text class="empty-title">还没搭出合适的一桌</text>
    <text class="empty-desc" wx:if="{{warnings.length === 0}}">换个数量或口味，我再帮你排一套</text>
    <text class="context-warning empty-warning" wx:for="{{warnings}}" wx:key="*this">{{item}}</text>
    <button class="ew-hit-target empty-btn" bindtap="onRegenerate">重新生成</button>
  </scroll-view>

  <!-- 正常结果 -->
  <view wx:else class="results-content">
    <swiper class="plan-swiper" indicator-dots="true" autoplay="false" circular="false" duration="300" current="{{current}}" bindchange="onPlanChange">
      <block wx:for="{{plans}}" wx:key="index" wx:for-index="planIndex">
        <swiper-item>
          <scroll-view class="dish-scroll" scroll-y enhanced>
            <view class="plan-wrap">
            <view wx:if="{{refreshing}}" class="generation-banner busy">{{loadingStage}}</view>
            <view wx:elif="{{generationNotice}}" class="generation-banner notice">{{generationNotice}}</view>
            <view class="recommend-context" wx:if="{{filterSummary || warnings.length}}">
              <text class="context-summary" wx:if="{{filterSummary}}">按 {{filterSummary}} 给你挑的</text>
              <text class="context-warning" wx:for="{{warnings}}" wx:key="*this">{{item}}</text>
            </view>
            <view class="plan-label">方案 {{planIndex + 1}} / {{plans.length}}</view>
            <view class="legacy-dish-row" wx:for="{{item.dishes}}" wx:key="id" wx:for-index="dishIndex">
              <compact-dish-row font-scale="{{fontScale}}" dish="{{item}}" data-dish="{{item}}" data-plan-index="{{planIndex}}" data-dish-index="{{dishIndex}}" busy="{{refreshing}}" bind:view="onTapDish" bind:replace="onRefreshDish" bind:feedback="onRefreshDish" />
            </view>
            </view>
            </scroll-view>
        </swiper-item>
      </block>
    </swiper>

    <!-- 操作栏 -->
    <view class="bottom-actions">
      <button class="ew-hit-target act-btn act-back" bindtap="onBack">返回</button>
      <button class="ew-hit-target act-btn act-regen" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRegenerate">重新生成</button>
      <button class="ew-hit-target act-btn act-save" bindtap="onSelectForMeal">选择此方案</button>
      <button class="ew-hit-target act-btn act-shopping" bindtap="onAddPlanToShoppingList">加入清单</button>
    </view>
  </view>

  <!-- 日期选择器 -->
  <view aria-role="button" class="ew-hit-target date-overlay" wx:if="{{showDatePicker}}" bindtap="onCancelDatePicker">
    <view class="ew-hit-target date-box" catchtap="">
      <text class="date-title">选择保存日期</text>
      <picker class="ew-hit-target" mode="date" value="{{customDate}}" start="2025-01-01" end="2027-12-31" bindchange="onCustomDateChange">
        <view class="date-btn">点击选择</view>
      </picker>
      <view aria-role="button" class="ew-hit-target date-cancel" bindtap="onCancelDatePicker">取消</view>
    </view>
  </view>
</view>

</block>
