<view class="result-page">
  <!-- 骨架屏加载 -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="generation-status">
      <text class="generation-status-title">{{loadingStage}}</text>
      <text class="generation-status-subtitle">正在为你准备合适的方案</text>
    </view>
    <view class="skeleton-plan" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-dish" wx:for="{{[1,2,3,4]}}" wx:for-item="n" wx:key="n">
        <view class="skeleton-img shimmer"></view>
        <view class="skeleton-text"><view class="shimmer bar w80"></view><view class="shimmer bar w50"></view></view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{empty}}" class="empty-state">
    <view class="empty-illustration">🍽️</view>
    <text class="empty-title">暂无推荐菜品</text>
    <text class="empty-desc" wx:if="{{warnings.length === 0}}">请调整菜品种类数量后重试</text>
    <text class="context-warning empty-warning" wx:for="{{warnings}}" wx:key="*this">{{item}}</text>
    <button class="empty-btn" bindtap="onRegenerate">重新生成</button>
  </view>

  <!-- 正常结果 -->
  <view wx:else class="results-content">
    <view wx:if="{{refreshing}}" class="generation-banner busy">{{loadingStage}}</view>
    <view wx:elif="{{generationNotice}}" class="generation-banner notice">{{generationNotice}}</view>
    <view class="recommend-context" wx:if="{{filterSummary || warnings.length}}">
      <text class="context-summary" wx:if="{{filterSummary}}">已按 {{filterSummary}} 推荐</text>
      <text class="context-warning" wx:for="{{warnings}}" wx:key="*this">{{item}}</text>
    </view>
    <swiper class="plan-swiper" indicator-dots="true" autoplay="false" circular="false" duration="300" current="{{current}}">
      <block wx:for="{{plans}}" wx:key="index" wx:for-index="planIndex">
        <swiper-item>
          <scroll-view class="dish-scroll" scroll-y>
            <view class="plan-label">方案 {{planIndex + 1}} / {{plans.length}}</view>
            <view class="dish-card {{item.type}}" wx:for="{{item.dishes}}" wx:key="name" wx:for-index="dishIndex" bindtap="onTapDish" data-dish="{{item}}">
                <image wx:if="{{item.image}}" class="dish-img" src="{{item.image}}" mode="aspectFill" lazy-load binderror="onImgError" data-plan-index="{{planIndex}}" data-dish-index="{{dishIndex}}" />
                <view wx:else class="dish-img dish-img-placeholder">🍽️</view>
                <!-- 信息区 -->
                <view class="dish-body">
                  <view class="dish-top">
                    <text class="dish-name">{{item.name}}</text>
                    <view class="star-btn {{item.isFavorite ? 'on' : ''}}" catchtap="onToggleFavorite" data-dish="{{item}}" data-plan-index="{{planIndex}}" data-dish-index="{{dishIndex}}">
                      <text>{{item.isFavorite ? '★' : '☆'}}</text>
                    </view>
                  </view>
                  <!-- 标签 -->
                  <view class="dish-tags" wx:if="{{item.tags && item.tags.length > 0}}">
                    <text class="tag" wx:for="{{item.tags.slice(0, 3)}}" wx:key="*this">{{item}}</text>
                  </view>
                  <!-- 属性 -->
                  <view class="dish-meta">
                    <text class="meta-item" wx:if="{{item.kcal}}">🔥 {{item.kcal}}千卡</text>
                    <text class="meta-item" wx:if="{{item.difficulty}}">📋 {{item.difficulty}}</text>
                    <text class="meta-item" wx:if="{{item.cookTime}}">⏱ {{item.cookTime}}</text>
                  </view>
                </view>
                <!-- 换一个 -->
                <view class="refresh-btn" catchtap="onRefreshDish" data-plan-index="{{planIndex}}" data-dish-index="{{dishIndex}}">
                  <text>🔄</text>
                </view>
              </view>
            </scroll-view>
        </swiper-item>
      </block>
    </swiper>

    <!-- 操作栏 -->
    <view class="bottom-actions">
      <button class="act-btn act-back" bindtap="onBack">返回</button>
      <button class="act-btn act-regen" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRegenerate">重新生成</button>
      <button class="act-btn act-save" bindtap="onSelectForMeal">选择此方案</button>
    </view>
  </view>

  <!-- 日期选择器 -->
  <view class="date-overlay" wx:if="{{showDatePicker}}" bindtap="onCancelDatePicker">
    <view class="date-box" catchtap="">
      <text class="date-title">选择保存日期</text>
      <picker mode="date" value="{{customDate}}" start="2025-01-01" end="2027-12-31" bindchange="onCustomDateChange">
        <view class="date-btn">点击选择</view>
      </picker>
      <view class="date-cancel" bindtap="onCancelDatePicker">取消</view>
    </view>
  </view>
</view>
