/* 结果页 */
.result-page {
  min-height: 100vh;
  background: #F7F8FA;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap { padding: 16px; }
.skeleton-plan { margin-bottom: 20px; }
.skeleton-dish {
  display: flex; gap: 12px; margin-bottom: 12px;
  background: #fff; border-radius: 14rpx; padding: 14px;
}
.skeleton-img { width: 100rpx; height: 100rpx; border-radius: 12rpx; background: #e5e5e5; flex-shrink: 0; }
.skeleton-text { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
.bar { height: 18rpx; border-radius: 6rpx; background: #e5e5e5; }
.w80 { width: 80%; } .w50 { width: 50%; }
.shimmer {
  animation: shimmer 1.5s infinite;
  background: linear-gradient(90deg, #e5e5e5 25%, #f0f0f0 50%, #e5e5e5 75%);
  background-size: 200% 100%;
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ===== 空状态 ===== */
.empty-state {
  padding: 100px 40px 60px;
  display: flex; flex-direction: column; align-items: center;
}
.empty-illustration { font-size: 80rpx; margin-bottom: 20px; opacity: 0.6; }
.empty-title { font-size: 34rpx; font-weight: bold; color: #333; }
.empty-desc { font-size: 26rpx; color: #999; margin: 10px 0 30px; }
.empty-btn { background: #2BA471; color: #fff; border-radius: 24px; padding: 10px 40px; font-size: 28rpx; border: none; }

.recommend-context { margin: 10px 16px 0; padding: 10px 12px; background: #edf7f2; border-left: 4rpx solid #2ba471; }
.context-summary, .context-warning { display: block; font-size: 22rpx; line-height: 1.5; }
.context-summary { color: #276548; }
.context-warning { margin-top: 4rpx; color: #9a5f22; }
.empty-warning { max-width: 560rpx; margin: 8rpx auto; text-align: center; }

/* ===== Swiper ===== */
.results-content {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(68px + env(safe-area-inset-bottom));
}
.plan-swiper { flex: 1; min-height: 0; width: 100%; }
.plan-wrap { height: 100%; padding: 10px 16px 0; box-sizing: border-box; }
.plan-label { text-align: center; font-size: 24rpx; color: #bbb; margin-bottom: 8px; }
.dish-scroll { height: calc(100% - 30px); }

/* ===== 菜品卡片 ===== */
.dish-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 14rpx;
  padding: 14px; margin-bottom: 10px;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.dish-card:active { transform: scale(0.98); }

.dish-img {
  width: 110rpx; height: 110rpx; border-radius: 12rpx;
  background: #f5f5f5; flex-shrink: 0; margin-right: 14px;
}

.dish-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8f98;
  font-size: 52rpx;
}

.dish-body { flex: 1; min-width: 0; }
.dish-top { display: flex; align-items: flex-start; justify-content: space-between; }
.dish-name { font-size: 30rpx; font-weight: 600; color: #222; line-height: 1.3; flex: 1; min-width: 0; }
.star-btn { font-size: 36rpx; color: #ddd; padding: 0 4px; flex-shrink: 0; }
.star-btn.on { color: #FF7D3B; }
.dish-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0; }
.tag { font-size: 20rpx; color: #2BA471; background: #E8F5E9; padding: 2rpx 10rpx; border-radius: 10rpx; }
.dish-meta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 2px; }
.meta-item { font-size: 22rpx; color: #999; }
.refresh-btn { font-size: 28rpx; padding: 6px; flex-shrink: 0; margin-left: 4px; color: #2BA471; }

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 10px; padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #f0f0f0;
  z-index: 50;
}
.act-btn { flex: 1; font-size: 28rpx; border-radius: 12rpx; height: 44px; line-height: 44px; padding: 0; }
.act-back { background: #f5f5f5; color: #666; }
.act-regen { background: #E8F5E9; color: #2BA471; border: 1rpx solid #2BA471; }
.act-save { background: #2BA471; color: #fff; font-weight: 600; }

/* ===== 日期选择器 ===== */
.date-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.date-box { width: 76%; background: #fff; border-radius: 18px; padding: 32px 24px; text-align: center; }
.date-title { font-size: 32rpx; font-weight: bold; color: #333; display: block; margin-bottom: 24px; }
.date-btn { background: #2BA471; color: #fff; border-radius: 12rpx; padding: 14px; font-size: 30rpx; }
.date-cancel { margin-top: 16px; font-size: 26rpx; color: #999; }
.generation-status {
  min-height: 104rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  background: #ffffff;
  border-left: 6rpx solid #237a55;
  border-radius: 8rpx;
}

.generation-status-title,
.generation-status-subtitle {
  display: block;
  word-break: break-word;
}

.generation-status-title {
  color: #1f2b25;
  font-size: 29rpx;
  font-weight: 600;
}

.generation-status-subtitle {
  margin-top: 6rpx;
  color: #707a75;
  font-size: 23rpx;
}

.generation-banner {
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-word;
}

.generation-banner.busy {
  color: #176a47;
  background: #e3f3eb;
}

.generation-banner.notice {
  color: #835117;
  background: #fff0d8;
}
