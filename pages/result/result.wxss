/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
/* 结果页 */
.result-page {
  height: 100%;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap { height: 100%; box-sizing: border-box; padding:16px; }
.skeleton-plan { margin-bottom:20px; }
.skeleton-dish {
  display: flex; gap:12px; margin-bottom:12px;
  background: #FFFFFF; border-radius:14rpx; padding:14px;
}
.skeleton-img { width: 160rpx; height: 128rpx; border-radius:12rpx; background: #D9E1D5; flex-shrink: 0; }
.skeleton-text { flex: 1; display: flex; flex-direction: column; justify-content: center; gap:10px; }
.bar { height: 18rpx; border-radius:6rpx; background: #D9E1D5; }
.w80 { width: 80%; } .w50 { width: 50%; }
.shimmer {
  animation: shimmer 1.5s infinite;
  background: linear-gradient(90deg, #D9E1D5 25%, #F8F7F2 50%, #D9E1D5 75%);
  background-size: 200% 100%;
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ===== 空状态 ===== */
.empty-state {
  height: 100%; box-sizing: border-box; padding:48px 24px calc(24px + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; align-items: center;
}
.empty-illustration { margin-bottom:20px; color: #28634E; opacity: 0.72; }
.empty-illustration .line-icon { width: 78rpx; height: 78rpx; }
.empty-title { display: block; font-size:1.125em; font-weight: bold; color: #25332B; }
.empty-desc { display: block; font-size:0.8125em; color: #56645B; margin:10px 0 30px; }
.empty-btn { background: #28634E; color: #FFFFFF; border-radius:24px; padding:10px 40px; font-size:1em; border: none; }

.recommend-context { margin:0 0 12px; padding:10px 12px; background: #edf7f2; border-left: 4rpx solid #28634E; word-break: break-word; }
.context-summary, .context-warning { display: block; font-size:0.75em; line-height: 1.5; }
.context-summary { color:#28634E; }
.context-warning { margin-top:4rpx; color:#75501A; }
.empty-warning { max-width: 560rpx; margin:8rpx auto; text-align: center; }

/* ===== Swiper ===== */
.results-content {
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom:calc(120px + env(safe-area-inset-bottom));
}
.plan-swiper { flex: 1; height: 0; min-height: 0; width: 100%; }
.plan-wrap { padding:12px 16px 32px; box-sizing: border-box; }
.plan-label { text-align: center; font-size:0.75em; color:#56645B; margin-bottom:8px; }
.dish-scroll { height: 100%; box-sizing: border-box; }

/* ===== 菜品卡片 ===== */
.dish-card {
  display: flex; align-items: center;
  background: #FFFFFF; border: 1rpx solid #D9E1D5; border-radius:14rpx;
  padding:14px; margin-bottom:10px;
}

.dish-media { position: relative; width: 160rpx; height: 128rpx; flex: 0 0 auto; overflow: hidden; border-radius:12rpx; margin-right:14px; background: #f2f7f5; }
.dish-img { width: 100%; height: 100%; display: block; background: #f2f7f5; }

.dish-img-placeholder { display: flex; align-items: center; justify-content: center; color:#56645B; }
.dish-img-placeholder .line-icon { width: 52rpx; height: 52rpx; }
.dish-photo-caption { position: absolute; left: 8rpx; bottom: 8rpx; padding:3rpx 8rpx; border-radius:999rpx; color: #FFFFFF; background: #28634E; font-size:0.75em; line-height: 1.2; }

.dish-body { flex: 1; min-width: 0; }
.dish-top { display: flex; align-items: flex-start; justify-content: space-between; }
.dish-name { font-size:1em; font-weight: 600; color: #25332B; line-height: 1.5; flex: 1; min-width: 0; word-break: break-word; }
.star-btn { color:#56645B; padding:0 4px; flex-shrink: 0; }
.star-btn .line-icon { width: 36rpx; height: 36rpx; }
.star-btn.on { color:#28634E; }
.dish-tags { display: flex; flex-wrap: wrap; gap:6px; margin:6px 0; }
.tag { max-width: 100%; word-break: break-word; font-size:0.75em; color: #28634E; background: #EDF3ED; padding:2rpx 10rpx; border-radius:10rpx; }
.dish-meta { display: flex; gap:14px; flex-wrap: wrap; margin-top:2px; }
.meta-item { display: inline-flex; align-items: center; gap:4rpx; font-size:0.75em; color: #56645B; }
.meta-item .line-icon { width: 24rpx; height: 24rpx; color:#56645B; }
.refresh-btn { padding:6px; flex-shrink: 0; margin-left:4px; color: #28634E; }
.refresh-btn .line-icon { width: 30rpx; height: 30rpx; }

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed; bottom: 0; left: 0; right: 0; box-sizing: border-box; width: 100%;
  display: flex; flex-wrap: wrap; gap:10px; padding:12px 16px;
  padding-bottom:calc(12px + env(safe-area-inset-bottom));
  background: #FFFFFF; border-top: 1rpx solid #F8F7F2;
  z-index: 50;
}
.act-btn { flex: 1 1 130px; min-width: 0; margin:0; font-size:1em; border-radius:12rpx; height: 44px; line-height: 44px; padding:0 6px; }
.act-back { background: #F8F7F2; color: #56645B; }
.act-regen { background: #EDF3ED; color: #28634E; border: 1rpx solid #28634E; }
.act-save { background: #28634E; color: #FFFFFF; font-weight: 600; }
.act-shopping { background: #EDF3ED; color: #28634E; }

/* ===== 日期选择器 ===== */
.date-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.date-box { width: 86%; max-height: 90%; box-sizing: border-box; overflow-y: auto; background: #FFFFFF; border-radius:18px; padding:24px; text-align: center; }
.date-title { font-size:1em; font-weight: bold; color: #25332B; display: block; margin-bottom:24px; }
.date-btn { background: #28634E; color: #FFFFFF; border-radius:12rpx; padding:14px; font-size:1em; }
.date-cancel { margin-top:16px; font-size:0.8125em; color: #56645B; }
.generation-status {
  min-height: 104rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-bottom:18rpx;
  padding:18rpx 22rpx;
  background: #FFFFFF;
  border-left: 6rpx solid #28634E;
  border-radius:8rpx;
}

.generation-status-title,
.generation-status-subtitle {
  display: block;
  word-break: break-word;
}

.generation-status-title {
  color:#25332B;
  font-size:1em;
  font-weight: 600;
}

.generation-status-subtitle {
  margin-top:6rpx;
  color:#56645B;
  font-size:0.75em;
}

.generation-banner {
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin:0 24rpx 16rpx;
  padding:12rpx 18rpx;
  border-radius:8rpx;
  font-size:0.75em;
  line-height: 1.4;
  word-break: break-word;
}

.generation-banner.busy {
  color: #28634E;
  background: #EDF3ED;
}

.generation-banner.notice {
  color:#28634E;
  background: #FFF1DB;
}

/* 页面共享主题，适用于本页详情、表单和弹层。 */

/* Shared finish for legacy pages; layout and permission-specific states remain local. */
.ew-page { background:#F8F7F2; color:#25332B; }
.ew-page .btn-primary, .ew-page .primary-btn, .ew-page .save-btn, .ew-page .primary-action, .ew-page .generate-btn { background:#28634E; border-radius:24rpx; }
.ew-page .choice-chip, .ew-page .ingredient-chip, .ew-page .count-btn, .ew-page .clear-btn, .ew-page .period-nav, .ew-page .filter-chip { min-height:44px; min-width:44px; box-sizing:border-box; }

@import "../../styles/workspace.wxss";

/* Input and touch minima remain fixed under small screens/font changes. */
.ew-page button,.ew-page input,.ew-page .count-btn,.ew-page .choice-chip,.ew-page .filter-chip,.ew-page .date-picker{min-height:44px;box-sizing:border-box}
.ew-page .primary-btn,.ew-page .save-btn,.ew-page .primary-action,.ew-page .wx-login-btn{min-height:48px}

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }


button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }
