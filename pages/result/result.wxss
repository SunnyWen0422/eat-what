/* 结果页 */
.result-page {
  height: 100%;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap { height: 100%; box-sizing: border-box; padding: 16px; }
.skeleton-plan { margin-bottom: 20px; }
.skeleton-dish {
  display: flex; gap: 12px; margin-bottom: 12px;
  background: #fff; border-radius: 14rpx; padding: 14px;
}
.skeleton-img { width: 160rpx; height: 128rpx; border-radius: 12rpx; background: #e5e5e5; flex-shrink: 0; }
.skeleton-text { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
.bar { height: 18rpx; border-radius: 6rpx; background: #e5e5e5; }
.w80 { width: 80%; } .w50 { width: 50%; }
.shimmer {
  animation: shimmer 1.5s infinite;
  background: linear-gradient(90deg, #e5e5e5 25%, #f0f0f0 50%, #e5e5e5 75%);
  background-size: 200% 100%;
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ===== 空状态 ===== */
.empty-state {
  height: 100%; box-sizing: border-box; padding: 48px 24px calc(24px + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; align-items: center;
}
.empty-illustration { margin-bottom: 20px; color: #299f91; opacity: 0.72; }
.empty-illustration .line-icon { width: 78rpx; height: 78rpx; }
.empty-title { display: block; font-size: 34rpx; font-weight: bold; color: #333; }
.empty-desc { display: block; font-size: 26rpx; color: #999; margin: 10px 0 30px; }
.empty-btn { background: #2BA471; color: #fff; border-radius: 24px; padding: 10px 40px; font-size: 28rpx; border: none; }

.recommend-context { margin: 0 0 12px; padding: 10px 12px; background: #edf7f2; border-left: 4rpx solid #2ba471; word-break: break-word; }
.context-summary, .context-warning { display: block; font-size: 22rpx; line-height: 1.5; }
.context-summary { color: #276548; }
.context-warning { margin-top: 4rpx; color: #9a5f22; }
.empty-warning { max-width: 560rpx; margin: 8rpx auto; text-align: center; }

/* ===== Swiper ===== */
.results-content {
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120px + env(safe-area-inset-bottom));
}
.plan-swiper { flex: 1; height: 0; min-height: 0; width: 100%; }
.plan-wrap { padding: 12px 16px 32px; box-sizing: border-box; }
.plan-label { text-align: center; font-size: 24rpx; color: #bbb; margin-bottom: 8px; }
.dish-scroll { height: 100%; box-sizing: border-box; }

/* ===== 菜品卡片 ===== */
.dish-card {
  display: flex; align-items: center;
  background: #fff; border: 1rpx solid #e3eeea; border-radius: 14rpx;
  padding: 14px; margin-bottom: 10px;
}
.dish-card:active { transform: scale(0.98); }

.dish-media { position: relative; width: 160rpx; height: 128rpx; flex: 0 0 auto; overflow: hidden; border-radius: 12rpx; margin-right: 14px; background: #f2f7f5; }
.dish-img { width: 100%; height: 100%; display: block; background: #f2f7f5; }

.dish-img-placeholder { display: flex; align-items: center; justify-content: center; color: #8a8f98; }
.dish-img-placeholder .line-icon { width: 52rpx; height: 52rpx; }
.dish-photo-caption { position: absolute; left: 8rpx; bottom: 8rpx; padding: 3rpx 8rpx; border-radius: 999rpx; color: #fff; background: rgba(31, 75, 62, .72); font-size: 18rpx; line-height: 1.2; }

.dish-body { flex: 1; min-width: 0; }
.dish-top { display: flex; align-items: flex-start; justify-content: space-between; }
.dish-name { font-size: 30rpx; font-weight: 600; color: #222; line-height: 1.5; flex: 1; min-width: 0; word-break: break-word; }
.star-btn { color: #aab8b2; padding: 0 4px; flex-shrink: 0; }
.star-btn .line-icon { width: 36rpx; height: 36rpx; }
.star-btn.on { color: #e28a5c; }
.dish-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0; }
.tag { max-width: 100%; word-break: break-word; font-size: 20rpx; color: #2BA471; background: #E8F5E9; padding: 2rpx 10rpx; border-radius: 10rpx; }
.dish-meta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 2px; }
.meta-item { display: inline-flex; align-items: center; gap: 4rpx; font-size: 22rpx; color: #999; }
.meta-item .line-icon { width: 24rpx; height: 24rpx; color: #91a29a; }
.refresh-btn { padding: 6px; flex-shrink: 0; margin-left: 4px; color: #2BA471; }
.refresh-btn .line-icon { width: 30rpx; height: 30rpx; }

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed; bottom: 0; left: 0; right: 0; box-sizing: border-box; width: 100%;
  display: flex; flex-wrap: wrap; gap: 10px; padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #f0f0f0;
  z-index: 50;
}
.act-btn { flex: 1 1 130px; min-width: 0; margin: 0; font-size: 14px; border-radius: 12rpx; height: 44px; line-height: 44px; padding: 0 6px; }
.act-back { background: #f5f5f5; color: #666; }
.act-regen { background: #E8F5E9; color: #2BA471; border: 1rpx solid #2BA471; }
.act-save { background: #299f91; color: #fff; font-weight: 600; }
.act-shopping { background: #e7f8f4; color: #176f66; }

/* ===== 日期选择器 ===== */
.date-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.date-box { width: 86%; max-height: 90%; box-sizing: border-box; overflow-y: auto; background: #fff; border-radius: 18px; padding: 24px; text-align: center; }
.date-title { font-size: 32rpx; font-weight: bold; color: #333; display: block; margin-bottom: 24px; }
.date-btn { background: #2BA471; color: #fff; border-radius: 12rpx; padding: 14px; font-size: 30rpx; }
.date-cancel { margin-top: 16px; font-size: 26rpx; color: #999; }
.generation-status {
  min-height: 104rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  background: #ffffff;
  border-left: 6rpx solid #237a55;
  border-radius: 8rpx;
}

.generation-status-title,
.generation-status-subtitle {
  display: block;
  word-break: break-word;
}

.generation-status-title {
  color: #1f2b25;
  font-size: 29rpx;
  font-weight: 600;
}

.generation-status-subtitle {
  margin-top: 6rpx;
  color: #707a75;
  font-size: 23rpx;
}

.generation-banner {
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-word;
}

.generation-banner.busy {
  color: #176a47;
  background: #e3f3eb;
}

.generation-banner.notice {
  color: #835117;
  background: #fff0d8;
}
