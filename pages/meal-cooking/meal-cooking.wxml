<view class="ew-page ew-screen cooking-page" style="font-size:{{fontBase * fontScale}}px;padding-bottom:{{cookingActionHeight}}px">
  <view class="ew-heading">{{recipeMode ? '大字做法' : '一起做这餐'}}</view><text class="ew-muted">{{recipeMode ? '按步骤慢慢来' : '按本餐安排，一道道来'}}</text>
  <ui-state wx:if="{{loading}}" kind="loading" title="正在读取本餐做法" />
  <ui-state wx:elif="{{errorMessage}}" kind="error" title="{{errorMessage}}" action-label="{{planChanged ? '返回核对本餐' : '重新读取'}}" bind:action="onErrorAction" />
  <block wx:else><text wx:if="{{resumeNotice}}" class="ew-notice" aria-role="status">{{resumeNotice}}</text><scroll-view scroll-x class="dish-switch-scroll"><view class="ew-tabs"><button wx:for="{{dishes}}" wx:key="id" class="ew-hit-target {{dishIndex === index ? 'active' : ''}}" aria-pressed="{{dishIndex === index}}" data-index="{{index}}" bindtap="onChooseDish">{{item.name}}</button></view></scroll-view>
    <button class="ew-hit-target ew-link" aria-expanded="{{ingredientsVisible}}" bindtap="onIngredients">查看食材</button>
    <ui-card><view id="cooking-step-heading" class="cooking-step-heading"><text class="ew-title">{{dishName}}</text><text wx:if="{{steps.length}}" class="ew-muted">步骤 {{stepIndex + 1}} / {{steps.length}}</text></view><view wx:if="{{steps.length}}" class="cooking-step">{{steps[stepIndex]}}</view><text wx:else class="ew-notice">{{recipeMode ? '这份菜谱还没有烹饪步骤。' : '这餐缺少做法步骤，请返回查看原菜谱。'}}</text></ui-card>
    <ui-button wx:if="{{!recipeMode && canRecordActual}}" label="记录这餐" variant="secondary" bind:action="onRecordActual" />
    <view wx:if="{{steps.length}}" class="cooking-bottom"><ui-button label="上一步" variant="secondary" disabled="{{stepIndex === 0}}" bind:action="onPreviousStep" /><ui-button label="{{stepIndex >= steps.length - 1 ? '已到最后一步' : '下一步'}}" disabled="{{stepIndex >= steps.length - 1}}" bind:action="onNextStep" /></view>
  </block>
  <ui-sheet visible="{{ingredientsVisible}}" title="{{dishName}} · 食材" bind:close="closeIngredients"><view class="cooking-ingredients"><text wx:for="{{ingredients}}" wx:key="index" class="ew-reading">{{item}}</text><text wx:if="{{!ingredients.length}}" class="ew-muted">这份菜谱还没有食材用量。</text><text wx:if="{{ingredientNotice}}" class="ew-muted">{{ingredientNotice}}</text></view><text class="ew-muted">仅保存本机阅读位置，关闭后继续当前步骤。</text></ui-sheet>
  <text wx:if="{{actualSavedMessage}}" class="ew-notice" role="status">{{actualSavedMessage}} · 可以继续查看做法</text>
  <ui-confirm visible="{{actualVisible && actualQuick}}" title="这餐吃了" busy="{{actualBusy || actualLoading}}" confirm-label="确认记录" bind:cancel="closeMealActual" bind:confirm="onConfirmActual"><text class="ew-muted">阅读进度不计入实际用餐，请确认这餐吃了什么。</text><text class="ew-label">{{actualTitle}}</text><text class="ew-reading">{{actualText}}</text><text wx:if="{{actualError}}" class="ew-error">{{actualError}}</text><button class="ew-hit-target ew-link" disabled="{{actualBusy || actualLoading}}" bindtap="onActualAdjustment">有调整</button></ui-confirm>
  <block wx:if="{{!actualQuick}}"><include src="../../templates/meal-actual-sheet.wxml" /></block>
</view>
