/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
@import "../../styles/workspace.wxss";
.cooking-page{background:#F8F7F2}
.ew-heading{margin-bottom:8px}
.cooking-page .ew-tabs{overflow-x:auto;flex-wrap:nowrap;margin:0}
.ew-tabs button{flex:0 0 auto;max-width:240px;white-space:normal}
.dish-switch-scroll{width:100%;min-width:0;margin:20px 0}
.cooking-step-heading text{display:block;margin-bottom:12px;overflow-wrap:anywhere}
.cooking-step{font-size:1em;line-height:1.65;margin:20px 0;min-height:180px;white-space:pre-wrap;overflow-wrap:anywhere;color:#25332B}
.cooking-ingredients text{display:block;white-space:pre-wrap;overflow-wrap:anywhere;margin-bottom:12px}
.cooking-bottom{position:fixed;bottom:0;left:0;right:0;z-index:20;display:flex;flex-wrap:wrap;gap:16px;padding:20px;padding-bottom:calc(20px + env(safe-area-inset-bottom));background:#F8F7F2;border-top:1px solid #D9E1D5}
.cooking-bottom > ui-button{flex:1 1 120px;min-width:0}
