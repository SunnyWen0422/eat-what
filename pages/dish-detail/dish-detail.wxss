/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
/* pages/dish-detail/dish-detail.wxss */

.container {
  padding-bottom:calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: linear-gradient(180deg,#EDF3ED 0,#FFFFFF 300rpx);
  min-height: 100vh;
}

/* 菜品图片 */
.dish-image-container {
  position: relative;
  width: 100%;
  height: 500rpx;
  background-color: #FFFFFF;
}

.dish-image {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #f2f7f5;
}

.dish-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap:12rpx;
  background-color: #F8F7F2;
  color: #28634E;
}
.dish-image-placeholder .line-icon { width: 72rpx; height: 72rpx; }

.placeholder-text {
  color: #56645B;
  font-size:1em;
}

.favorite-btn {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #FFFFFF;
  border-radius:50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d7e5df;
}

.favorite-icon {
  width: 48rpx;
  height: 48rpx;
  color: #28634E;
}

.favorite-btn.favorited .favorite-icon {
  color: #28634E;
}

.favorite-btn:not(.favorited) .favorite-icon {
  color:#56645B;
}

.share-btn {
  position: absolute; left: 30rpx; bottom: 30rpx;
  width: 72rpx; height: 72rpx; background: #FFFFFF;
  border-radius:50%; display: flex; align-items: center; justify-content: center;
  border: 1rpx solid #d7e5df;
  padding:0; border: none; font-size:1.142857em;
}
.share-btn::after { border: none; }
.share-btn .line-icon { width: 34rpx; height: 34rpx; color: #28634E; }

/* 菜品信息 */
.dish-info {
  padding:30rpx;
  background-color: #FFFFFF;
  margin-top:20rpx;
}

.dish-header {
  margin-bottom:30rpx;
}

.dish-name {
  font-size:1.285714em;
  font-weight: bold;
  color: #25332B;
  display: block;
  word-break: break-word;
  margin-bottom:16rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap:12rpx;
}

.tag {
  font-size:0.857143em;
  color: #28634E;
  background-color: #fff0f0;
  padding:6rpx 16rpx;
  border-radius:20rpx;
}

/* 菜品属性 */
.dish-attributes {
  display: flex;
  flex-wrap: wrap;
  gap:20rpx;
  padding:24rpx;
  background-color: #f9f9f9;
  border-radius:16rpx;
  margin-bottom:30rpx;
}

.attribute-item {
  flex: 1;
  min-width: 45%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.attribute-label {
  font-size:0.857143em;
  color: #56645B;
  margin-bottom:8rpx;
}

.attribute-value {
  font-size:1em;
  color: #25332B;
  font-weight: 500;
}

/* 段落样式 */
.section {
  margin-bottom:40rpx;
}

.section-title {
  margin-bottom:20rpx;
  padding-bottom:16rpx;
  border-bottom: 2rpx solid #F8F7F2;
}

.section-title-text {
  font-size:1.142857em;
  font-weight: bold;
  color: #25332B;
}

.section-content {
  font-size:1em;
  color: #56645B;
  line-height: 1.6;
}

/* 食材与用量 */
.ingredients-list {
  display: flex;
  flex-direction: column;
  gap:16rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  padding:16rpx 20rpx;
  background-color: #f9f9f9;
  border-radius:12rpx;
  align-items: flex-start;
}

.ingredient-text {
  font-size:1em;
  color: #25332B;
  line-height: 1.5;
  word-break: break-word;
}

/* 烹饪步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap:30rpx;
}

.step-item {
  display: flex;
  gap:20rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  min-width: 48rpx;
  background-color:#28634E;
  color: #FFFFFF;
  border-radius:50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size:0.857143em;
  font-weight: bold;
  margin-top:8rpx;
}

.step-content {
  flex: 1;
}

.step-text {
  font-size:1em;
  color: #25332B;
  line-height: 1.6;
  display: block;
  margin-bottom:16rpx;
}

.step-image {
  width: 100%;
  border-radius:12rpx;
  margin-top:8rpx;
}

.step-images {
  display: flex;
  flex-wrap: wrap;
  gap:8rpx;
  margin-top:10rpx;
}

.step-images .step-image {
  width: 48%;
  border-radius:10rpx;
}

/* 步骤图片汇总 */
.all-images {
  display: flex;
  flex-wrap: wrap;
  gap:10rpx;
}

.all-image {
  width: 31%;
  border-radius:10rpx;
}

/* 小贴士 */
.tips-content {
  padding:24rpx;
  background-color: #f0f9ff;
  border-radius:12rpx;
  border-left: 6rpx solid #4dabf7;
}

.tips-text {
  font-size:1em;
  color: #56645B;
  line-height: 1.6;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #F8F7F2;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #F8F7F2;
  border-top: 6rpx solid #ff6b6b;
  border-radius:50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top:20rpx;
  font-size:1em;
  color: #56645B;
}

/* 错误提示 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #F8F7F2;
}

.error-text {
  font-size:1.142857em;
  color: #56645B;
  margin-bottom:30rpx;
}

.retry-btn {
  background-color:#28634E;
  color: #FFFFFF;
  border: none;
  border-radius:40rpx;
  padding:16rpx 60rpx;
  font-size:1em;
}

/* 页面共享主题，适用于本页详情、表单和弹层。 */

/* Shared finish for legacy pages; layout and permission-specific states remain local. */
.ew-page { background:#F8F7F2; color:#25332B; }
.ew-page .btn-primary, .ew-page .primary-btn, .ew-page .save-btn, .ew-page .primary-action, .ew-page .generate-btn { background:#28634E; border-radius:24rpx; }
.ew-page .choice-chip, .ew-page .ingredient-chip, .ew-page .count-btn, .ew-page .clear-btn, .ew-page .period-nav, .ew-page .filter-chip { min-height:44px; min-width:44px; box-sizing:border-box; }

/* Input and touch minima remain fixed under small screens/font changes. */
.ew-page button,.ew-page input,.ew-page .count-btn,.ew-page .choice-chip,.ew-page .filter-chip,.ew-page .date-picker{min-height:44px;box-sizing:border-box}
.ew-page .primary-btn,.ew-page .save-btn,.ew-page .primary-action,.ew-page .wx-login-btn{min-height:48px}

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }

.favorite-status { color:#28634E; font-size:0.857143em; }

button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }

/* v2 recipe reading: content first, one contextual preparation action. */
.container{background:#F8F7F2;padding:16px 16px calc(104px + env(safe-area-inset-bottom));min-height:100%;height:auto;display:block}.dish-image-container{height:244px;border-radius:18px;overflow:hidden;background:#F5F6F0}.dish-image-container.no-image{height:48px;overflow:visible;background:transparent}.dish-image{border-radius:18px}.favorite-btn,.share-btn{width:44px;height:44px;min-width:44px;min-height:44px;box-shadow:none;background:#FFFFFF;border:1px solid #D9E1D5;display:flex;align-items:center;justify-content:center;border-radius:14px;padding:0;margin:0;top:12px}.favorite-btn{right:12px}.share-btn{right:64px}.dish-info{padding:20px 0;background:transparent}.dish-name{font-size:1.714286em;font-weight:600;line-height:1.4}.dish-tags{gap:8px;margin-top:12px}.tag{background:#EDF3ED;color:#28634E;border:0;border-radius:6px;font-size:0.857143em;padding:4px 8px}.dish-attributes{background:transparent;box-shadow:none;border:0;padding:16px 0;margin:12px 0;display:flex;flex-wrap:wrap;gap:20px;justify-content:flex-start;border-bottom:1px solid #E6EAE1}.attribute-item{background:transparent;text-align:left;width:auto;padding:0}.attribute-label{font-size:0.928571em;color:#56645B}.attribute-value{font-size:1.142857em;font-weight:500}.section{background:transparent;box-shadow:none;border:0;border-radius:0;padding:0;margin:24px 0}.section-title-text{font-size:1.285714em;font-weight:600}.step-item{background:transparent;border:0;border-bottom:1px solid #E6EAE1;padding:16px 0;border-radius:0;box-shadow:none}.step-number{background:#F8F7F2;color:#28634E;border:0;font-size:1em;font-weight:600}.step-text,.ingredient-name,.tips-text{font-size:1.142857em;line-height:1.7}.ingredient-row{background:transparent;border-bottom:1px solid #E6EAE1}.detail-bottom{position:fixed;left:0;right:0;bottom:0;z-index:30;background:#F8F7F2;padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid #E6EAE1}.detail-bottom ui-button{display:block}.detail-bottom .ew-link{margin-bottom:4px}.loading-container,.error-container{background:#F8F7F2}.share-btn::after{border:0}
@media(max-width:360px){.dish-image-container{height:210px}.dish-image-container.no-image{height:48px}}

.step-number { background-color:#F8F7F2; }

/* Override native button sizing as well as the legacy left/bottom anchors. */
button.share-btn { left:auto; bottom:auto; width:44px; max-width:44px; box-sizing:border-box; }

.container .dish-attributes { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; padding:16px 0; }
.container .attribute-item { width:auto; min-width:0; flex:none; text-align:left; }
.container .attribute-label,.container .attribute-value { display:block; }
.container .attribute-label { font-size:0.857143em; margin-bottom:6px; }
.container .section > .ew-muted { display:block; margin-bottom:10px; }
.container .detail-bottom { display:flex; flex-direction:column; gap:8px; }
.container { padding-bottom:calc(156px + env(safe-area-inset-bottom)); }
