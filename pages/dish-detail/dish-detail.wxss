/* pages/dish-detail/dish-detail.wxss */

.container {
  padding-bottom: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 菜品图片 */
.dish-image-container {
  position: relative;
  width: 100%;
  height: 500rpx;
  background-color: #fff;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
}

.placeholder-text {
  color: #999;
  font-size: 28rpx;
}

.favorite-btn {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.favorite-icon {
  font-size: 48rpx;
  color: #ff6b6b;
}

.favorite-btn.favorited .favorite-icon {
  color: #ff6b6b;
}

.favorite-btn:not(.favorited) .favorite-icon {
  color: #ccc;
}

/* 菜品信息 */
.dish-info {
  padding: 30rpx;
  background-color: #fff;
  margin-top: 20rpx;
}

.dish-header {
  margin-bottom: 30rpx;
}

.dish-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #ff6b6b;
  background-color: #fff0f0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 菜品属性 */
.dish-attributes {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx;
  background-color: #f9f9f9;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.attribute-item {
  flex: 1;
  min-width: 45%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.attribute-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.attribute-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 段落样式 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 食材与用量 */
.ingredients-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.ingredient-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 烹饪步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  min-width: 48rpx;
  background-color: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-top: 8rpx;
}

.step-content {
  flex: 1;
}

.step-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.step-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* 小贴士 */
.tips-content {
  padding: 24rpx;
  background-color: #f0f9ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #4dabf7;
}

.tips-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f5f5f5;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f0f0f0;
  border-top: 6rpx solid #ff6b6b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 错误提示 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f5f5f5;
}

.error-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.retry-btn {
  background-color: #ff6b6b;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 60rpx;
  font-size: 28rpx;
}
