<!--pages/dish-detail/dish-detail.wxml-->
<view class="ew-page container" style="font-size:{{fontBase * fontScale}}px" wx:if="{{!loading && !error && dish}}">
  <!-- 菜品图片 -->
  <view wx:if="{{dish.image}}" class="dish-image-container">
    <image
      wx:if="{{dish.image}}"
      class="dish-image"
      src="{{dish.image}}" binderror="onDishImageError"
      mode="aspectFill"
      bindtap="previewImage"
      data-url="{{dish.image}}"
    />
  </view>

  <!-- 菜品信息 -->
  <view class="dish-info {{dish.image ? 'with-hero' : ''}}">
    <text class="ew-subtitle">查看食材用量和烹饪做法。</text>
    <view class="dish-header">
      <view class="dish-title-row">
        <text class="dish-name">{{dish.name}}</text>
        <view class="dish-title-actions">
          <button class="share-btn" open-type="share">
            <ui-icon class="line-icon line-icon-share" name="share" label="分享" />
          </button>
          <view aria-role="button" class="ew-hit-target favorite-btn {{isFavorite ? 'favorited' : ''}}" loading="{{favoriteBusy}}" disabled="{{favoriteBusy}}" bindtap="toggleFavorite">
            <ui-icon class="line-icon line-icon-heart favorite-icon" name="{{isFavorite ? 'favorite-filled' : 'favorite'}}" label="{{isFavorite ? '取消收藏' : '收藏'}}" /><text wx:if="{{favoriteBusy}}" class="favorite-status">处理中</text>
          </view>
        </view>
      </view>
      <view class="dish-tags" wx:if="{{dish.tags}}">
        <text class="tag" wx:for="{{dish.tagsList}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 菜品属性 -->
    <view class="dish-attributes">
      <view class="attribute-item" wx:if="{{dish.difficulty}}">
        <text class="attribute-label">难度</text>
        <text class="attribute-value">{{dish.difficulty}}</text>
      </view>
      <view class="attribute-item" wx:if="{{dish.cookTimeDisplay}}">
        <text class="attribute-label">单菜参考时间</text>
        <text class="attribute-value">{{dish.cookTimeDisplay}}</text>
      </view>
      <view class="attribute-item" wx:if="{{dish.type}}">
        <text class="attribute-label">类型</text>
        <text class="attribute-value">{{dish.typeLabel}}</text>
      </view>
    </view>

    <!-- 烹饪方法 -->
    <view class="section" wx:if="{{dish.methods}}">
      <view class="section-title">
        <text class="section-title-text">烹饪方法</text>
      </view>
      <text class="section-content" user-select>{{dish.methods}}</text>
    </view>

    <!-- 食材与用量 -->
    <view wx:if="{{qualityView}}" class="section"><text class="ew-muted">{{qualityView.statusLabel}} · {{qualityView.nutritionText}}</text><button wx:if="{{qualityView.sourceLines.length}}" class="ew-hit-target ew-link" bindtap="onToggleQualitySources">{{qualitySourcesVisible ? '收起来源记录' : '查看用料来源记录'}}</button><view wx:if="{{qualitySourcesVisible}}"><view wx:for="{{qualityView.sourceLines}}" wx:key="name"><text class="ew-muted">{{item.name}} · {{item.status}}</text><text class="section-content" user-select>{{item.text}}</text></view></view></view>
    <view class="section" wx:if="{{dish.ingredientsList && dish.ingredientsList.length > 0}}">
      <view class="section-title">
        <text class="section-title-text">食材与用量</text>
      </view>
      <view class="ew-muted">{{ingredientNotice}}</view>
      <view class="ingredients-list">
        <view class="ingredient-item" wx:for="{{dish.ingredientsList}}" wx:key="index">
          <text class="ingredient-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 烹饪步骤 -->
    <view class="section" wx:if="{{dish.stepsList && dish.stepsList.length > 0}}">
      <view class="section-title">
        <text class="section-title-text">烹饪步骤</text>
      </view>
      <view class="steps-list">
        <view class="step-item" wx:for="{{dish.stepsList}}" wx:key="index">
          <view class="step-number">{{index + 1}}</view>
          <view class="step-content">
            <text class="step-text" user-select>{{item}}</text>
            <view class="step-images" wx:if="{{dish.stepImagesFlat[index] && dish.stepImagesFlat[index].length > 0}}">
              <image
                wx:for="{{dish.stepImagesFlat[index]}}" wx:for-item="imgUrl" wx:key="*this"
                class="step-image"
                src="{{imgUrl}}"
                mode="widthFix"
                bindtap="previewStepImage"
                data-url="{{imgUrl}}"
              />
            </view>
          </view>
        </view>
      </view>
      <!-- 所有步骤图片汇总 -->
      <view class="section" wx:if="{{dish.allStepImages && dish.allStepImages.length > 0}}">
        <view class="section-title">
          <text class="section-title-text">步骤图片</text>
        </view>
        <view class="all-images">
          <image
            wx:for="{{dish.allStepImages}}" wx:key="*this"
            class="all-image"
            src="{{item}}"
            mode="widthFix"
            bindtap="previewStepImage"
            data-url="{{item}}"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{!dish.stepsList || !dish.stepsList.length}}" class="ew-notice">这份菜谱还没有烹饪步骤，不能猜测做法。</view>
    <button class="ew-hit-target ew-link detail-cooking-link" bindtap="onOpenCooking">大字做法，接着上次步骤看</button>
    <!-- 小贴士 -->
    <view class="section" wx:if="{{dish.tips}}">
      <view class="section-title">
        <text class="section-title-text">小贴士</text>
      </view>
      <view class="tips-content">
        <text class="tips-text" user-select>{{dish.tips}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{copyMessage}}" class="ew-notice" role="status">{{copyMessage}}</view>
  <view wx:if="{{mealAddError}}" class="ew-error">{{mealAddError}}</view>
  <action-feedback wx:if="{{selectionFeedback}}" feedback="{{selectionFeedback}}" />
  <ui-button wx:if="{{selectionFeedback.state === 'unknown'}}" label="核对原请求" variant="secondary" loading="{{selectionBusy}}" bind:action="onRetrySelection" />
  <view class="detail-action-spacer" style="height:{{detailActionHeight}}px" aria-hidden="true" />
  <view class="detail-bottom">
    <view class="detail-context-row">
      <button class="ew-hit-target ew-link detail-selected-summary" bindtap="onShowSelected">{{selectedMeal ? selectedMeal.targetLabel : '本餐'}} · 已选 {{selectedMeal ? selectedMeal.count : 0}} 道 · 查看菜单</button>
      <button class="ew-hit-target ew-link detail-more-button" bindtap="onShowDetailMore">更多</button>
    </view>
    <text wx:if="{{isAddedToMeal}}" class="ew-muted detail-added-state">已加入本餐 ✓</text>
    <ui-button label="{{mealPrimaryLabel}}" loading="{{selectionBusy}}" disabled="{{selectionLoading || (!isAddedToMeal && selectionBlocked)}}" bind:action="onAddToCurrentMeal" />
  </view>
  <ui-sheet visible="{{showDetailMore}}" title="更多菜谱操作" bind:close="onHideDetailMore">
    <ui-button label="准备食材" variant="secondary" bind:action="onAddToShoppingList" />
    <ui-button label="复制为我的菜谱" variant="secondary" bind:action="onCopyPersonal" />
    <button wx:if="{{canEditCustom}}" class="ew-hit-target ew-link" bindtap="onEditCustom">编辑我的菜谱</button>
  </ui-sheet>
  <ui-sheet visible="{{showCopyPreview}}" title="复制为我的菜谱" busy="{{copyBusy}}" bind:close="onCancelCopyPersonal">
    <view class="ew-title">{{copyPreview.name}}</view>
    <view class="ew-notice">确认后会在我的菜谱中创建副本，再进入编辑页。原菜谱和来源记录保留；取消预览不会创建菜谱。</view>
    <view class="ew-label">食材与用量</view><text class="section-content copy-preview-text" user-select>{{copyPreview.ingredients}}</text>
    <view class="ew-label">做法</view><text class="section-content copy-preview-text" user-select>{{copyPreview.steps}}</text>
    <view wx:if="{{copyPending}}" class="ew-notice">上次复制结果待确认，重试使用原请求，不会另建副本。</view>
    <view wx:if="{{copyError}}" class="ew-error">{{copyError}}</view>
    <ui-button label="取消预览" variant="tertiary" disabled="{{copyBusy}}" bind:action="onCancelCopyPersonal" />
    <ui-button slot="footer" label="{{copyPending ? '核对原复制' : '确认创建副本并编辑'}}" loading="{{copyBusy}}" bind:action="onConfirmCopyPersonal" />
  </ui-sheet>
  <include src="../../templates/recipe-selected-sheet.wxml" />
</view>

<!-- 加载中 -->
<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<!-- 错误提示 -->
<view class="error-container" wx:if="{{!loading && error}}">
  <text class="error-text">{{detailError || '加载失败，请重试'}}</text>
  <button class="ew-hit-target retry-btn" bindtap="onRetry">重试</button>
</view>
