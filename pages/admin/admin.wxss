.page{min-height:100vh;background:#F7F8FA;padding:16rpx;}
.title{font-size:34rpx;font-weight:bold;color:#333;margin-bottom:16rpx;}
.loading{text-align:center;color:#999;margin-top:40rpx;}
.user-item{display:flex;align-items:center;background:#fff;border-radius:14rpx;padding:18rpx 20rpx;margin-bottom:10rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}
.u-name{font-size:30rpx;font-weight:600;color:#222;flex:1;}
.u-info{font-size:22rpx;color:#999;}
.u-arrow{font-size:30rpx;color:#ccc;margin-left:8rpx;}
.bar{display:flex;justify-content:space-between;margin-bottom:14rpx;}
.bar-btn{font-size:28rpx;color:#2BA471;padding:8rpx 0;}
.u-detail{background:#fff;border-radius:14rpx;padding:20rpx;margin-bottom:12rpx;}
.u-title{font-size:32rpx;font-weight:bold;color:#222;}
.u-sub{font-size:24rpx;color:#999;margin-top:6rpx;display:block;}
.dish-list{display:flex;flex-direction:column;gap:8rpx;}
.d-item{display:flex;align-items:center;background:#fff;border-radius:10rpx;padding:14rpx;}
.d-name{flex:1;font-size:28rpx;color:#333;}
.d-remove{font-size:24rpx;color:#E74C3C;padding:4rpx 8rpx;}
.empty{text-align:center;color:#ccc;padding:40rpx 0;}
.modal{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:200;display:flex;align-items:center;justify-content:center}
.modal-box{width:85%;background:#fff;border-radius:16rpx;padding:30rpx}
.modal-title{font-size:34rpx;font-weight:bold;color:#333;display:block;margin-bottom:20rpx}
.inp{width:100%;border:1rpx solid #E5E5E5;border-radius:10rpx;padding:14rpx;font-size:28rpx;margin-bottom:12rpx;box-sizing:border-box}
.modal-btns{display:flex;gap:12rpx;margin-top:16rpx}
.btn-cancel{flex:1;background:#f5f5f5;color:#666;border-radius:10rpx;font-size:28rpx}
.btn-save{flex:1;background:#2BA471;color:#fff;border-radius:10rpx;font-size:28rpx}
