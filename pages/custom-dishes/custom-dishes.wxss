.page { padding: 16px; background: #f5f5f5; min-height: 100vh; }
.tip { text-align: center; padding-top: 80px; color: #999; font-size: 16px; }
.tip-sub { display: block; font-size: 13px; margin-top: 8px; color: #bbb; }
.item { display: flex; align-items: center; background: #fff; border-radius: 10px; padding: 14px 16px; margin-bottom: 8px; }
.item-info { flex: 1; }
.item-name { font-size: 16px; color: #333; }
.item-type { font-size: 12px; color: #07c160; margin-left: 8px; }
.item-del { font-size: 14px; color: #f56c6c; padding: 4px 8px; }
.loading { text-align: center; padding-top: 40px; color: #999; }
