<button wx:if="{{assistantReturnVisible}}" class="ew-hit-target ew-link" bindtap="onAssistantReturn">{{assistantReturnLabel}}</button>
<view class="ew-page ew-dish-surface ew-screen" style="font-size:{{fontBase * fontScale}}px"><view class="personal-page-heading"><view class="ew-heading">{{editing ? (copyDraft ? '编辑副本' : '编辑我的菜谱') : '我的菜谱'}}</view><button wx:if="{{!editing}}" class="ew-hit-target ew-link" bindtap="onAdd">添加菜谱</button></view><view wx:if="{{personalSaveMessage}}" class="ew-notice" role="status">{{personalSaveMessage}}</view><view wx:if="{{errorMessage && !editing}}" class="ew-error">{{errorMessage}}<button class="ew-hit-target ew-link" bindtap="onRetryRead">重新读取</button></view><view wx:if="{{!editing && recoveryError}}" class="ew-error">{{recoveryError}}</view><view wx:if="{{!editing && pendingCopies.length}}" class="ew-card"><view class="ew-label">待确认的复制</view><view class="ew-muted">上次请求结果待确认，可能已经保存。查看后可重试原请求，不会自动另建副本。</view><button wx:for="{{pendingCopies}}" wx:key="id" class="ew-hit-target ew-link" data-id="{{item.id}}" data-generation="{{pendingCopyGeneration}}" bindtap="onRecoverCopy">查看待确认复制 · {{item.name}}</button></view><view wx:if="{{pendingDeletes.length}}" class="ew-card"><view class="ew-label">删除结果待核对</view><view class="ew-muted">列表中没有该项也不能确认原删除结果。点击核对会重试原删除请求。</view><button wx:for="{{pendingDeletes}}" wx:key="id" class="ew-hit-target ew-link" data-id="{{item.id}}" data-generation="{{pendingDeleteGeneration}}" bindtap="onRecoverDelete" disabled="{{saving}}">核对原删除 · {{item.name}}</button></view><ui-state wx:if="{{loading}}" kind="loading" title="正在读取我的菜谱" /><block wx:elif="{{!editing}}"><view wx:for="{{dishes}}" wx:key="id" class="private-dish-row"><compact-dish-row font-scale="{{fontScale}}" dish="{{item}}" mode="read" bind:view="onViewDish" /><button class="ew-hit-target ew-link private-dish-manage" data-id="{{item.id}}" bindtap="onManageDish" disabled="{{saving || errorMessage}}" aria-label="管理{{item.name}}">管理</button></view><ui-state wx:if="{{!dishes.length && !errorMessage}}" kind="empty" title="记下自己的拿手菜" description="选择“添加菜谱”，填写食材和步骤。" /></block><view wx:else class="ew-card"><view class="ew-notice personal-edit-status" role="status">{{editPending ? '上次保存结果待确认，可能已经保存。请核对原请求。' : formError ? '输入仍保留，请检查下方提示。' : copyDraft ? '保存后才会加入我的菜谱，取消不会创建副本。' : '修改尚未保存，完成后保存到我的菜谱。'}}</view><view class="ew-label">菜名</view><input class="ew-input" id="edit-name" focus="{{formFocus === 'name'}}" aria-label="菜名" value="{{form.name}}" maxlength="255" data-field="name" disabled="{{saving || editPending}}" bindinput="onInput" /><view class="ew-field"><view class="ew-label">分类</view><picker class="ew-hit-target" range="{{types}}" value="{{typeIndex}}" disabled="{{saving || editPending}}" bindchange="onType"><view class="ew-input">{{types[typeIndex]}}</view></picker></view><view class="ew-field"><view class="ew-label">食材与用量 · 每行一项</view><textarea class="ew-input" id="edit-ingredients" focus="{{formFocus === 'ingredients'}}" aria-label="食材与用量" value="{{form.ingredients}}" maxlength="10000" data-field="ingredients" disabled="{{saving || editPending}}" bindinput="onInput" cursor-spacing="24" auto-height /></view><view class="ew-field"><view class="ew-label">步骤 · 每行一步</view><textarea class="ew-input" id="edit-steps" focus="{{formFocus === 'steps'}}" aria-label="做法步骤" value="{{form.steps}}" maxlength="20000" data-field="steps" disabled="{{saving || editPending}}" bindinput="onInput" cursor-spacing="24" auto-height /></view><button class="ew-hit-target ew-link" bindtap="onToggleEditExtras">{{editExtrasVisible ? '收起可选资料' : '添加时间、份数说明或图片（可选）'}}</button><view wx:if="{{editExtrasVisible}}" class="personal-recipe-extras"><view class="ew-field"><view class="ew-label">烹饪分钟数（可选）</view><input id="edit-cookMinutes" focus="{{formFocus === 'cookMinutes'}}" class="ew-input" value="{{form.cookMinutes}}" type="number" data-field="cookMinutes" disabled="{{saving || editPending}}" bindinput="onInput" /></view><view class="ew-label">原配方份数说明（可选）</view><input class="ew-input" value="{{form.servingDescription}}" maxlength="1000" data-field="servingDescription" disabled="{{saving || editPending}}" bindinput="onInput" /><view class="ew-label">图片 HTTPS 地址（可选）</view><input id="edit-image" focus="{{formFocus === 'image'}}" class="ew-input" value="{{form.image}}" maxlength="2048" data-field="image" disabled="{{saving || editPending}}" bindinput="onInput" /></view><view wx:if="{{formError && !editPending}}" class="ew-error">{{formError}}<button wx:if="{{!editPending}}" class="ew-hit-target ew-link" disabled="{{saving}}" bindtap="onReloadEdit">放弃输入，重新读取</button></view><view class="ew-actions {{fontScale > 1.5 ? 'personal-edit-actions-large' : ''}}"><ui-button label="取消" variant="secondary" disabled="{{saving}}" bind:action="cancelEdit" /><ui-button label="{{legacyCopyPending ? '确认上次复制' : editPending ? '核对原请求' : copyDraft ? '保存到我的菜谱' : '保存菜谱'}}" loading="{{saving}}" bind:action="saveEdit" /></view></view></view>
