<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px"><view class="personal-page-heading"><view class="ew-heading">{{editing ? '编辑我的菜谱' : '我的菜谱'}}</view><button wx:if="{{!editing}}" class="ew-hit-target ew-link" bindtap="onAdd">添加菜谱</button></view><view wx:if="{{personalSaveMessage}}" class="ew-notice" role="status">{{personalSaveMessage}}</view><view class="ew-subtitle">{{editing ? '完整修改菜品，保存失败会保留输入' : '自己的菜品可以编辑和删除，记录的用餐历史会保留'}}</view><view wx:if="{{errorMessage && !editing}}" class="ew-error">{{errorMessage}}<button class="ew-hit-target ew-link" bindtap="loadCustomDishes">重试读取</button></view><ui-state wx:if="{{loading}}" kind="loading" title="正在读取我的菜谱" /><block wx:elif="{{!editing}}"><view wx:for="{{dishes}}" wx:key="id" class="private-dish-row"><compact-dish-row dish="{{item}}" mode="read" bind:view="onViewDish" /><button class="ew-hit-target ew-link private-dish-manage" data-id="{{item.id}}" bindtap="onManageDish" disabled="{{saving || errorMessage}}" aria-label="管理{{item.name}}">管理</button></view><ui-state wx:if="{{!dishes.length && !errorMessage}}" kind="empty" title="记下自己的拿手菜" description="把常做的菜保存下来，下次可直接选择。" /></block><view wx:else class="ew-card"><view class="ew-label">菜名</view><input class="ew-input" id="edit-name" focus="{{formFocus === 'name'}}" aria-label="菜名" value="{{form.name}}" maxlength="255" data-field="name" disabled="{{saving || editPending}}" bindinput="onInput" /><view class="ew-field"><view class="ew-label">分类</view><picker class="ew-hit-target" range="{{types}}" value="{{typeIndex}}" disabled="{{saving || editPending}}" bindchange="onType"><view class="ew-input">{{types[typeIndex]}}</view></picker></view><view class="ew-field"><view class="ew-label">食材与用量 · 每行一项</view><textarea class="ew-input" id="edit-ingredients" focus="{{formFocus === 'ingredients'}}" aria-label="食材与用量" value="{{form.ingredients}}" maxlength="10000" data-field="ingredients" disabled="{{saving || editPending}}" bindinput="onInput" cursor-spacing="24" auto-height /></view><view class="ew-field"><view class="ew-label">步骤 · 每行一步</view><textarea class="ew-input" id="edit-steps" focus="{{formFocus === 'steps'}}" aria-label="做法步骤" value="{{form.steps}}" maxlength="20000" data-field="steps" disabled="{{saving || editPending}}" bindinput="onInput" cursor-spacing="24" auto-height /></view><view class="ew-notice">{{editQualityNotice}}</view><button class="ew-hit-target ew-link" bindtap="onToggleEditExtras">{{editExtrasVisible ? '收起可选资料' : '添加时间、份数说明或图片（可选）'}}</button><view wx:if="{{editExtrasVisible}}" class="personal-recipe-extras"><view class="ew-field"><view class="ew-label">烹饪分钟数（可选）</view><input id="edit-cookMinutes" focus="{{formFocus === 'cookMinutes'}}" class="ew-input" value="{{form.cookMinutes}}" type="number" data-field="cookMinutes" disabled="{{saving || editPending}}" bindinput="onInput" /></view><view class="ew-label">原配方份数说明（可选）</view><input class="ew-input" value="{{form.servingDescription}}" maxlength="1000" data-field="servingDescription" disabled="{{saving || editPending}}" bindinput="onInput" /><text class="ew-muted">只保留你的说明，不会自动核验或换算份量。</text><view class="ew-label">图片 HTTPS 地址（可选）</view><input id="edit-image" focus="{{formFocus === 'image'}}" class="ew-input" value="{{form.image}}" maxlength="2048" data-field="image" disabled="{{saving || editPending}}" bindinput="onInput" /></view><view wx:if="{{formError}}" class="ew-error">{{formError}}<button wx:if="{{!editPending}}" class="ew-hit-target ew-link" disabled="{{saving}}" bindtap="onReloadEdit">放弃输入，重新读取</button></view><view class="ew-actions"><ui-button label="取消" variant="secondary" disabled="{{saving}}" bind:action="cancelEdit" /><ui-button label="{{editPending ? '重试原保存' : '保存菜谱'}}" loading="{{saving}}" bind:action="saveEdit" /></view></view></view>
