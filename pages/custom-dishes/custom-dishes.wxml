<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px"><view class="ew-heading">{{editing ? '编辑私房菜' : '我的私房菜'}}</view><view class="ew-subtitle">{{editing ? '完整修改菜品，保存失败会保留输入' : '自己的菜品可以编辑和删除，记录的用餐历史会保留'}}</view><view wx:if="{{errorMessage && !editing}}" class="ew-error">{{errorMessage}}<button class="ew-hit-target ew-link" bindtap="loadCustomDishes">重试读取</button></view><ui-state wx:if="{{loading}}" kind="loading" title="正在读取私房菜" /><block wx:elif="{{!editing}}"><view wx:for="{{dishes}}" wx:key="id" class="private-dish-row"><view class="ew-title">{{item.name}}</view><view class="ew-actions"><button class="ew-hit-target ew-link" data-id="{{item.id}}" bindtap="onViewDish">查看做法</button><button class="ew-hit-target ew-link" data-id="{{item.id}}" bindtap="onEdit" disabled="{{saving || errorMessage}}">编辑</button><button class="ew-hit-target ew-link danger" data-id="{{item.id}}" bindtap="onDelete" disabled="{{saving || errorMessage}}">删除</button></view></view><ui-state wx:if="{{!dishes.length && !errorMessage}}" kind="empty" title="还没有自己的菜品" description="把常做的菜保存下来，下次可直接选择。" /><ui-button label="添加私房菜" bind:action="onAdd" /></block><view wx:else class="ew-card"><view class="ew-label">菜名</view><input class="ew-input" value="{{form.name}}" maxlength="255" data-field="name" disabled="{{saving || editPending}}" bindinput="onInput" /><view class="ew-field"><view class="ew-label">分类</view><picker class="ew-hit-target" range="{{types}}" value="{{typeIndex}}" disabled="{{saving || editPending}}" bindchange="onType"><view class="ew-input">{{types[typeIndex]}}</view></picker></view><view class="ew-field"><view class="ew-label">食材与用量 · 每行一项</view><textarea class="ew-input" value="{{form.ingredients}}" maxlength="10000" data-field="ingredients" disabled="{{saving || editPending}}" bindinput="onInput" auto-height /></view><view class="ew-field"><view class="ew-label">步骤 · 每行一步</view><textarea class="ew-input" value="{{form.steps}}" maxlength="20000" data-field="steps" disabled="{{saving || editPending}}" bindinput="onInput" auto-height /></view><view class="ew-field"><view class="ew-label">烹饪分钟数（可选）</view><input class="ew-input" value="{{form.cookMinutes}}" type="number" data-field="cookMinutes" disabled="{{saving || editPending}}" bindinput="onInput" /></view><view wx:if="{{formError}}" class="ew-error">{{formError}}<button wx:if="{{!editPending}}" class="ew-hit-target ew-link" disabled="{{saving}}" bindtap="onReloadEdit">放弃输入，重新读取</button></view><view class="ew-actions"><ui-button label="取消" variant="secondary" disabled="{{saving}}" bind:action="cancelEdit" /><ui-button label="{{editPending ? '重试原保存' : '保存修改'}}" loading="{{saving}}" bind:action="saveEdit" /></view></view></view>
