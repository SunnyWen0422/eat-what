<view class="ew-page ew-screen shopping-page" style="font-size:{{fontBase * fontScale}}px">
  <view class="ew-between"><view><view class="ew-heading">购物清单</view><view class="ew-subtitle">{{offline ? '上次清单 · 云端结果待确认' : '把这几餐的食材一起备好'}}</view></view><button class="ew-hit-target ew-link compact" loading="{{refreshing}}" disabled="{{busy}}" bindtap="loadList">刷新</button></view>
  <view wx:if="{{errorMessage}}" class="ew-notice">{{errorMessage}}</view>
  <action-feedback feedback="{{feedback}}" busy="{{busy}}" reduced-motion="{{reducedMotion}}" bind:undo="onUndoCheck" />
  <view wx:if="{{drafts.length}}" class="ew-card"><view class="ew-title">待确认草稿 {{drafts.length}}</view><view class="ew-muted">草稿尚未确认保存到云端，重试不会自动覆盖冲突。</view><view wx:for="{{drafts}}" wx:key="operationId" class="ew-between"><button class="ew-hit-target ew-link" data-id="{{item.operationId}}" bindtap="onReviewDraft">{{item.conflict ? '查看冲突并确认' : '查看草稿'}} · {{item.label || '清单修改'}}</button><button class="ew-hit-target ew-link danger" data-id="{{item.operationId}}" bindtap="onDiscardDraft">丢弃</button></view><ui-button label="重试草稿" loading="{{busy}}" bind:action="onRetryDrafts" /></view>
  <view class="ew-tabs"><button class="ew-hit-target {{statusFilter === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="onFilterChange">待买 {{pendingCount}} 项</button><button class="ew-hit-target {{statusFilter === 'checked' ? 'active' : ''}}" data-status="checked" bindtap="onFilterChange">已买 {{checkedCount}} 项</button></view>
  <view class="ew-tabs"><button class="ew-hit-target {{viewMode === 'summary' ? 'active' : ''}}" data-mode="summary" bindtap="onViewMode">食材汇总</button><button class="ew-hit-target {{viewMode === 'byDish' ? 'active' : ''}}" data-mode="byDish" bindtap="onViewMode">按菜查看</button></view>
  <view class="ew-muted view-count">{{statusFilter === 'pending' ? '待买' : '已买'}} {{statusFilter === 'pending' ? pendingCount : checkedCount}} 项<text wx:if="{{viewMode === 'summary'}}"> · 已合并为 {{summaryRowCount}} 行</text></view>
  <ui-state wx:if="{{loading}}" kind="loading" title="正在读取清单" />
  <view wx:elif="{{viewMode === 'summary'}}">
    <view wx:for="{{summaryRows}}" wx:key="key" class="shopping-row {{item.justChecked ? 'just-checked' : ''}}">
      <compact-ingredient-row row="{{item}}" checked="{{item.checkedState === 'all'}}" busy="{{busy || item.justChecked}}" data-key="{{item.key}}" bind:check="onToggleSummary" bind:edit="onEditRow" bind:sources="onSourceDetails" />
      <view wx:if="{{item.justChecked}}" class="row-result" aria-live="polite">已买</view>
      <view wx:if="{{!item.userOverride && (item.calculationStatus === 'NEEDS_ADJUSTMENT' || (item.warnings && item.warnings.length > 0))}}" class="quantity-warning">原始用量或份数待核对，请调整后再采购</view>
      <view wx:if="{{item.sourceExpanded}}" class="ingredient-details">
        <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="key" class="source-row"><view class="source-text"><view>{{source.sourceLabel}}</view><view class="ew-muted">{{source.quantityText}}{{source.userOverride ? ' · 手动调整' : ''}}</view><view wx:if="{{source.note}}" class="ew-muted">备注：{{source.note}}</view></view><button class="ew-hit-target ew-link" disabled="{{busy}}" data-id="{{source.itemId}}" bindtap="onEditItem">编辑此项</button><button class="ew-hit-target ew-link danger" disabled="{{busy}}" data-id="{{source.itemId}}" bindtap="onDeleteItem">删除</button></view>
        <text wx:if="{{item.sourceCount > 1}}" class="ew-muted">逐项编辑来源用量，汇总数量不会分摊。</text>
      </view>
    </view>
  </view>
  <view wx:else>
    <view wx:for="{{dishes}}" wx:for-item="dish" wx:key="key" class="dish-group">
      <button class="ew-hit-target dish-header" disabled="{{busy}}" data-key="{{dish.key}}" bindtap="onToggleDish" aria-expanded="{{dish.expanded}}"><view class="source-text"><view>{{dish.dishName || '手动添加'}}</view><view class="ew-muted">{{dish.contextLabel}}{{dish.targetPeople ? ' · ' + dish.targetPeople + '人' : ''}} · {{dish.items.length}} 项</view></view><ui-icon class="dish-chevron {{dish.expanded ? 'expanded' : ''}}" name="chevron-right" tone="muted" size="18" /></button>
      <view wx:if="{{dish.expanded}}"><view wx:for="{{dish.items}}" wx:key="key" class="shopping-row {{item.justChecked ? 'just-checked' : ''}}"><compact-ingredient-row row="{{item}}" checked="{{item.checkedState === 'all'}}" busy="{{busy || item.justChecked}}" data-id="{{item.id}}" data-key="{{item.key}}" bind:check="onToggleItem" bind:edit="onEditItem" bind:sources="onSourceDetails" /><view wx:if="{{item.justChecked}}" class="row-result" aria-live="polite">已买</view><view wx:if="{{!item.userOverride && (item.calculationStatus === 'NEEDS_ADJUSTMENT' || (item.warnings && item.warnings.length > 0))}}" class="quantity-warning">原始用量或份数待核对，请调整后再采购</view><view wx:if="{{item.sourceExpanded}}" class="ingredient-details"><text>{{dish.sourceLabel}}</text><button class="ew-hit-target ew-link danger" disabled="{{busy}}" data-id="{{item.id}}" bindtap="onDeleteItem">删除此项</button></view></view></view>
    </view>
  </view>
  <ui-state wx:if="{{!loading && !offline && !errorMessage && !drafts.length && pendingCount === 0 && checkedCount > 0 && statusFilter === 'pending'}}" kind="empty" density="inline" title="清单里的食材都买齐了" description="回到今天，核对这餐的安排并开始做饭。" action-label="回到今天" bind:action="onBackToToday" /><ui-state wx:elif="{{!loading && !dishes.length}}" kind="empty" density="{{pendingCount + checkedCount > 0 ? 'inline' : 'page'}}" illustration="{{pendingCount + checkedCount > 0 ? '' : 'empty-shopping'}}" title="{{statusFilter === 'pending' ? '当前没有待买食材' : '当前没有已买食材'}}" description="从菜谱或计划准备食材，也可以手动添加。" action-label="选择菜谱" bind:action="onAddFromRecipe" />
  <view class="shopping-bottom ew-bottom"><ui-button label="添加食材" disabled="{{busy}}" bind:action="onAddOptions" /><ui-button label="更多操作" variant="tertiary" disabled="{{busy}}" bind:action="onMore" /></view>
  <ui-sheet visible="{{addVisible}}" title="添加食材" busy="{{busy}}" bind:close="onAddOptions"><ui-button label="从菜谱准备食材" bind:action="onAddFromRecipe" /><ui-button label="手动添加几样" variant="secondary" bind:action="onAddManual" /></ui-sheet>
  <ui-sheet visible="{{moreVisible}}" title="清单操作" busy="{{busy}}" bind:close="onMore"><ui-button label="复制待买清单" variant="secondary" bind:action="onCopyList" /><button class="ew-hit-target ew-link danger" disabled="{{busy || checkedCount === 0}}" bindtap="onClearCompleted">移除已买 {{checkedCount}} 项</button><button class="ew-hit-target ew-link danger" disabled="{{busy || pendingCount + checkedCount === 0}}" bindtap="onClearAll">删除全部 {{pendingCount + checkedCount}} 项</button></ui-sheet>
  <ui-confirm visible="{{formVisible}}" title="{{formMode === 'manual' ? '手动添加食材' : '调整食材'}}" busy="{{busy}}" confirm-label="保存到云端" bind:cancel="closeForm" bind:confirm="saveForm"><ui-field disabled="{{busy}}" label="食材名称" required value="{{formName}}" bind:change="onName" /><ui-field disabled="{{busy}}" label="数量与单位" required value="{{formQuantity}}" placeholder="例如：2个、500克或适量" bind:change="onQuantity" /><ui-field disabled="{{busy}}" wx:if="{{formMode === 'manual'}}" label="备注" value="{{formNote}}" maxlength="500" bind:change="onNote" /><view wx:if="{{formError}}" class="ew-error">{{formError}}</view></ui-confirm>
</view>
