<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px">
  <view class="ew-between"><view><view class="ew-heading">购物清单</view><view class="ew-subtitle">{{offline ? '上次清单 · 云端结果待确认' : '食材与餐次一起准备'}}</view></view><button class="ew-hit-target ew-button secondary compact" loading="{{refreshing}}" disabled="{{busy}}" bindtap="loadList">刷新</button></view>
  <view wx:if="{{errorMessage}}" class="ew-notice">{{errorMessage}}</view>
  <view wx:if="{{drafts.length}}" class="ew-card"><view class="ew-title">待确认草稿 {{drafts.length}}</view><view class="ew-muted">草稿尚未确认保存到云端，重试不会自动覆盖冲突。</view><view wx:for="{{drafts}}" wx:key="operationId" class="ew-between"><button class="ew-hit-target ew-link" data-id="{{item.operationId}}" bindtap="onReviewDraft">{{item.conflict ? '查看冲突并确认' : '查看草稿'}} · {{item.label || '清单修改'}}</button><button class="ew-hit-target ew-link danger" data-id="{{item.operationId}}" bindtap="onDiscardDraft">丢弃</button></view><ui-button label="重试草稿" loading="{{busy}}" bind:action="onRetryDrafts" /></view>
  <view class="ew-tabs"><button class="ew-hit-target {{statusFilter === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="onFilterChange">待买 {{pendingCount}}</button><button class="ew-hit-target {{statusFilter === 'all' ? 'active' : ''}}" data-status="all" bindtap="onFilterChange">全部</button><button class="ew-hit-target {{statusFilter === 'checked' ? 'active' : ''}}" data-status="checked" bindtap="onFilterChange">已买 {{checkedCount}}</button></view>
  <view class="ew-tabs"><button class="ew-hit-target {{viewMode === 'summary' ? 'active' : ''}}" data-mode="summary" bindtap="onViewMode">按食材汇总</button><button class="ew-hit-target {{viewMode === 'dishes' ? 'active' : ''}}" data-mode="dishes" bindtap="onViewMode">按餐次查看</button></view>
  <ui-card wx:if="{{pricingRows.length}}" title="采购费用"><text>待买参考估算 {{pendingPrice}} · 已记录实付 {{actualSpend}}</text><view class="ew-muted">上海零售参考价，缺价不估算；{{missingPrices}} 个来源暂无可核算价格。</view><view wx:if="{{priceNotice}}" class="ew-muted">{{priceNotice}}</view><view wx:for="{{pricingRows}}" wx:key="ingredientKey" class="ew-between"><view class="ew-grow"><text>{{item.displayName}} · {{item.referenceText}}</text><view class="ew-muted">{{item.quoteLabel}} · 实付 {{item.actualText}}</view></view><ui-button wx:if="{{expensesEnabled}}" label="记实付" variant="secondary" data-key="{{item.ingredientKey}}" bind:action="onEditExpense" /></view></ui-card>
  <ui-state wx:if="{{loading}}" kind="loading" title="正在读取清单" />
  <view wx:elif="{{viewMode === 'summary'}}"><view wx:for="{{summaryRows}}" wx:key="rowKey" class="ew-card"><view class="ew-row"><button class="ew-hit-target check {{item.checkedState === 'all' ? 'checked' : ''}}" disabled="{{busy}}" data-index="{{index}}" bindtap="onToggleSummary">{{item.checkedState === 'all' ? '✓' : item.checkedState === 'partial' ? '−' : '○'}}</button><view class="ew-grow"><view class="ew-title">{{item.displayName}}</view><view>{{item.quantityText || '用量需调整'}}</view><view wx:if="{{!item.userOverride && (item.calculationStatus === 'NEEDS_ADJUSTMENT' || (item.warnings && item.warnings.length > 0))}}" class="quantity-warning">原始用量或份数待核对，请调整后再采购</view></view></view><view class="ew-muted source">{{item.sourceLabel}}</view><view wx:if="{{item.note}}" class="ew-muted">备注：{{item.note}}</view><view wx:if="{{item.checkedState === 'partial'}}" class="ew-muted">部分来源已买，点击可全部标记已买</view><button wx:if="{{item.itemIds.length === 1}}" class="ew-hit-target ew-link" data-id="{{item.itemIds[0]}}" bindtap="onEditItem">调整数量</button><view wx:else class="ew-muted">各来源数量可在“按餐次查看”中调整</view></view></view>
  <view wx:else><view wx:for="{{dishes}}" wx:for-item="dish" wx:key="selectionKey" class="ew-card"><view class="ew-title">{{dish.dishName}}</view><view class="ew-muted">{{dish.sourceLabel}}{{dish.targetPeople ? ' · ' + dish.targetPeople + '人' : ''}}</view><view wx:for="{{dish.items}}" wx:key="id" class="item-row"><button class="ew-hit-target check {{item.checked ? 'checked' : ''}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="onToggleItem">{{item.checked ? '✓' : '○'}}</button><view class="ew-grow"><view>{{item.displayName}}</view><view class="ew-muted">{{item.quantityText || '用量需调整'}}{{item.userOverride ? ' · 手动调整' : ''}}</view><view wx:if="{{!item.userOverride && (item.calculationStatus === 'NEEDS_ADJUSTMENT' || (item.warnings && item.warnings.length > 0))}}" class="quantity-warning">原始用量或份数待核对，请调整后再采购</view></view><button class="ew-hit-target ew-link" data-id="{{item.id}}" bindtap="onEditItem">编辑</button><button class="ew-hit-target ew-link danger" data-id="{{item.id}}" bindtap="onDeleteItem">删除</button></view></view></view>
  <ui-state wx:if="{{!loading && !dishes.length}}" kind="empty" illustration="empty-shopping" title="{{statusFilter === 'pending' ? '当前没有待买食材' : '当前筛选没有食材'}}" description="从菜谱或计划准备食材，也可以手动添加。" action-label="选择菜谱" bind:action="onAddFromRecipe" />
  <view class="ew-actions"><ui-button label="手动添加" bind:action="onAddManual" /><ui-button label="从菜谱添加" variant="secondary" bind:action="onAddFromRecipe" /></view><view class="ew-actions"><ui-button label="复制待买清单" variant="secondary" bind:action="onCopyList" /><ui-button label="更多操作" variant="secondary" bind:action="onMore" /></view><view wx:if="{{moreVisible}}" class="ew-actions"><button class="ew-hit-target ew-link danger" disabled="{{busy}}" bindtap="onClearCompleted">清空已买</button><button class="ew-hit-target ew-link danger" disabled="{{busy}}" bindtap="onClearAll">清空全部</button></view>
  <ui-confirm visible="{{expenseVisible}}" title="{{expenseName}} · 实际花费" confirm-label="保存实付" busy="{{busy}}" bind:cancel="closeExpense" bind:confirm="saveExpense"><ui-field label="本次实际金额（元）" value="{{expenseAmount}}" type="digit" bind:change="onExpenseAmount" /><picker class="ew-hit-target" mode="selector" range="{{channels}}" bindchange="onExpenseChannel"><view class="ew-hit-target">采购渠道：{{expenseChannel || '可选'}}</view></picker><text class="ew-muted">当前清单同一食材填写一次，不按菜品分摊；0 元有效，记录后不自动勾选。</text><button class="ew-hit-target ew-link danger" disabled="{{busy}}" bindtap="removeExpense">移除此笔实付</button><view wx:if="{{formError}}" class="ew-error">{{formError}}</view></ui-confirm>
  <ui-confirm visible="{{formVisible}}" title="{{formMode === 'manual' ? '手动添加食材' : '调整食材'}}" busy="{{busy}}" confirm-label="保存到云端" bind:cancel="closeForm" bind:confirm="saveForm"><ui-field disabled="{{busy}}" label="食材名称" required value="{{formName}}" bind:change="onName" /><ui-field disabled="{{busy}}" label="数量与单位" required value="{{formQuantity}}" placeholder="例如：2个、500克或适量" bind:change="onQuantity" /><ui-field disabled="{{busy}}" wx:if="{{formMode === 'manual'}}" label="备注" value="{{formNote}}" maxlength="500" bind:change="onNote" /><view wx:if="{{formError}}" class="ew-error">{{formError}}</view></ui-confirm>
</view>
