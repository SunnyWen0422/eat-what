<button wx:if="{{assistantReturnVisible}}" class="ew-hit-target ew-link" bindtap="onAssistantReturn">{{assistantReturnLabel}}</button>
<view class="ew-page ew-screen shopping-page {{fontScale > 1.5 ? 'shopping-large' : ''}}" style="font-size:{{fontBase * fontScale}}px">
  <view class="ew-between"><view><view class="ew-heading">购物清单</view><view wx:if="{{offline}}" class="ew-subtitle">上次清单</view></view><button class="ew-hit-target ew-link compact" loading="{{refreshing}}" disabled="{{busy}}" bindtap="loadList">刷新</button></view>
  <view wx:if="{{errorMessage}}" class="ew-notice">{{errorMessage}}</view>
  <button wx:if="{{sourceMeals.length}}" class="ew-hit-target ew-link shopping-context" disabled="{{busy}}" bindtap="onOpenSourceMeal">{{pagePresentation.contextLabel}}</button>
  <action-feedback feedback="{{feedback}}" busy="{{busy}}" reduced-motion="{{reducedMotion}}" bind:undo="onUndoCheck" />
  <view wx:if="{{drafts.length}}" class="ew-card"><view class="ew-title">待确认草稿 {{drafts.length}}</view><view class="ew-muted">修改尚未确认保存，请查看后重试。</view><view wx:for="{{drafts}}" wx:key="operationId" class="ew-between"><button class="ew-hit-target ew-link" data-id="{{item.operationId}}" bindtap="onReviewDraft">{{item.conflict ? '查看冲突并确认' : '查看草稿'}} · {{item.label || '清单修改'}}</button><button class="ew-hit-target ew-link danger" data-id="{{item.operationId}}" bindtap="onDiscardDraft">丢弃</button></view><ui-button label="重试草稿" loading="{{busy}}" bind:action="onRetryDrafts" /></view>
  <view class="ew-tabs"><button class="ew-hit-target {{statusFilter === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="onFilterChange">待买 {{pendingCount}} 项</button><button class="ew-hit-target {{statusFilter === 'checked' ? 'active' : ''}}" data-status="checked" bindtap="onFilterChange">已买 {{checkedCount}} 项</button></view>
  <view class="ew-tabs"><button class="ew-hit-target {{viewMode === 'summary' ? 'active' : ''}}" data-mode="summary" bindtap="onViewMode">食材汇总</button><button class="ew-hit-target {{viewMode === 'byDish' ? 'active' : ''}}" data-mode="byDish" bindtap="onViewMode">按菜查看</button></view>
  <view wx:if="{{viewMode === 'summary' && summaryRowCount > 0}}" class="ew-muted view-count">已合并为 {{summaryRowCount}} 行</view>
  <ui-state wx:if="{{loading}}" kind="loading" title="正在读取清单" />
  <view wx:elif="{{viewMode === 'summary'}}">
    <view wx:for="{{summaryRows}}" wx:key="key" class="shopping-row {{item.justChecked ? 'just-checked' : ''}}">
      <compact-ingredient-row row="{{item}}" checked="{{item.checkedState === 'all'}}" busy="{{busy || item.justChecked}}" data-key="{{item.key}}" bind:check="onToggleSummary" bind:edit="onEditRow" bind:sources="onSourceDetails" />
      <view wx:if="{{item.justChecked}}" class="row-result" aria-live="polite">已买</view>
      <button wx:if="{{item.quantityUncertain}}" class="ew-hit-target ew-link quantity-warning" data-key="{{item.key}}" aria-expanded="{{item.sourceExpanded}}" bindtap="onSourceDetails">用量待核对 · {{item.sourceExpanded ? '收起原文' : '查看原文'}}</button>
      <view wx:if="{{item.sourceExpanded}}" class="ingredient-details">
        <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="key" class="source-row"><view class="source-text"><view>{{source.sourceLabel}}</view><view class="ew-muted">{{source.quantityText}}{{source.userOverride ? ' · 手动调整' : ''}}</view><view wx:if="{{item.quantityUncertain}}" class="ew-muted">原用量：{{source.sourceQuantityText}}</view><view wx:for="{{source.warnings}}" wx:for-item="warning" wx:key="*this" class="ew-muted">{{warning}}</view><view wx:if="{{source.note}}" class="ew-muted">备注：{{source.note}}</view></view><button class="ew-hit-target ew-link" disabled="{{busy}}" data-id="{{source.itemId}}" bindtap="onEditItem">编辑此项</button><button class="ew-hit-target ew-link danger" disabled="{{busy}}" data-id="{{source.itemId}}" bindtap="onDeleteItem">删除</button></view>
      </view>
    </view>
  </view>
  <view wx:else>
    <view wx:for="{{dishes}}" wx:for-item="dish" wx:key="key" class="dish-group">
      <button class="ew-hit-target dish-header" disabled="{{busy}}" data-key="{{dish.key}}" bindtap="onToggleDish" aria-expanded="{{dish.expanded}}"><view class="source-text"><view>{{dish.dishName || '手动添加'}}</view><view class="ew-muted">{{dish.contextLabel}}{{dish.targetPeople ? ' · ' + dish.targetPeople + '人' : ''}}</view></view><ui-icon class="dish-chevron {{dish.expanded ? 'expanded' : ''}}" name="chevron-right" tone="muted" size="18" /></button>
      <view wx:if="{{dish.expanded}}"><view wx:for="{{dish.items}}" wx:key="key" class="shopping-row {{item.justChecked ? 'just-checked' : ''}}"><compact-ingredient-row row="{{item}}" checked="{{item.checkedState === 'all'}}" busy="{{busy || item.justChecked}}" data-id="{{item.id}}" data-key="{{item.key}}" bind:check="onToggleItem" bind:edit="onEditItem" bind:sources="onSourceDetails" /><view wx:if="{{item.justChecked}}" class="row-result" aria-live="polite">已买</view><button wx:if="{{item.quantityUncertain}}" class="ew-hit-target ew-link quantity-warning" data-key="{{item.key}}" aria-expanded="{{item.sourceExpanded}}" bindtap="onSourceDetails">用量待核对 · {{item.sourceExpanded ? '收起原文' : '查看原文'}}</button><view wx:if="{{item.sourceExpanded}}" class="ingredient-details"><text>{{dish.sourceLabel}}</text><view class="ew-muted">原用量：{{item.sourceQuantityText || item.sourceText || item.quantityText}}</view><view wx:for="{{item.warnings}}" wx:for-item="warning" wx:key="*this" class="ew-muted">{{warning}}</view><button class="ew-hit-target ew-link danger" disabled="{{busy}}" data-id="{{item.id}}" bindtap="onDeleteItem">删除此项</button></view></view></view>
    </view>
  </view>
  <ui-state wx:if="{{!loading && !offline && !errorMessage && !drafts.length && pendingCount === 0 && checkedCount > 0 && statusFilter === 'pending'}}" kind="empty" density="inline" title="清单里的食材都买齐了" description="回到今天，核对这餐的安排并开始做饭。" action-label="回到今天" bind:action="onBackToToday" /><ui-state wx:elif="{{!loading && !dishes.length}}" kind="empty" density="{{pendingCount + checkedCount > 0 ? 'inline' : 'page'}}" illustration="{{pendingCount + checkedCount > 0 ? '' : 'empty-shopping'}}" title="{{statusFilter === 'pending' ? '当前没有待买食材' : '当前没有已买食材'}}" description="从菜谱或计划准备食材，也可以手动添加。" action-label="从日历准备食材" bind:action="onAddFromCalendar" />
  <ui-sheet visible="{{sourceMealsVisible}}" title="选择对应餐次" bind:close="onCloseSourceMeals"><button wx:for="{{sourceMeals}}" wx:key="label" class="ew-hit-target ew-link" data-key="{{item.date}}:{{item.mealType}}" bindtap="onOpenSourceMeal">{{item.label}}</button></ui-sheet>
  <button id="shopping-price-details" class="ew-hit-target ew-link" aria-expanded="{{detailsExpanded}}" bindtap="onPriceDetails">{{detailsExpanded ? '收起费用' : '参考价与实际支出'}}</button>
  <view wx:if="{{detailsExpanded}}" class="shopping-costs">
    <ui-state wx:if="{{priceLoading}}" kind="loading" density="inline" title="正在读取费用" />
    <text wx:if="{{priceNotice}}" class="ew-muted">{{priceNotice}}</text>
    <view class="cost-totals"><text>待买参考估算 {{pendingPrice}}</text><text>已记录支出 {{actualSpend}}</text></view>
    <text wx:if="{{pendingMissing}}" class="ew-muted">{{pendingMissing}}项暂无可靠估算，合计仅包含可估算部分。</text>
    <view wx:for="{{pricingRows}}" wx:key="ingredientKey" class="cost-row"><view class="ew-grow"><text class="ew-label">{{item.displayName}}</text><text class="ew-muted">{{item.quantityText}}</text><text class="ew-muted">参考 {{item.referenceText}} · {{item.quoteLabel}}</text></view><button class="ew-hit-target ew-link" data-key="{{item.ingredientKey}}" disabled="{{busy || !expensesEnabled || priceLoading}}" aria-label="记录{{item.displayName}}的实际支出" bindtap="onEditExpense">{{item.expense ? item.actualText : '记支出'}}</button></view>
  </view>
  <view class="shopping-bottom ew-bottom"><ui-button label="添加食材" variant="{{pagePresentation.addEmphasis}}" disabled="{{busy}}" bind:action="onAddOptions" /><ui-button label="更多操作" variant="tertiary" disabled="{{busy}}" bind:action="onMore" /></view>
  <ui-sheet visible="{{addVisible}}" title="添加食材" busy="{{busy}}" bind:close="onAddOptions"><ui-button label="从日历准备食材" bind:action="onAddFromCalendar" /><ui-button variant="secondary" label="从菜谱准备食材" bind:action="onAddFromRecipe" /><ui-button label="手动添加几样" variant="secondary" bind:action="onAddManual" /></ui-sheet>
  <ui-sheet visible="{{moreVisible}}" title="清单操作" busy="{{busy}}" bind:close="onMore"><ui-button label="复制待买清单" variant="secondary" bind:action="onCopyList" /><button class="ew-hit-target ew-link danger" disabled="{{busy || checkedCount === 0}}" bindtap="onClearCompleted">移除已买 {{checkedCount}} 项</button><button class="ew-hit-target ew-link danger" disabled="{{busy || pendingCount + checkedCount === 0}}" bindtap="onClearAll">删除全部 {{pendingCount + checkedCount}} 项</button></ui-sheet>
  <ui-confirm visible="{{expenseVisible}}" title="{{expenseName + ' · 实际支出'}}" busy="{{busy}}" confirm-label="保存支出" bind:cancel="closeExpense" bind:confirm="saveExpense"><ui-field label="实际金额（元）" type="digit" value="{{expenseAmount}}" disabled="{{busy}}" bind:change="onExpenseAmount" /><picker class="ew-hit-target" mode="selector" range="{{channels}}" disabled="{{busy}}" bindchange="onExpenseChannel"><view class="ew-hit-target ew-input">{{expenseChannel || '购买渠道（选填）'}}</view></picker><text class="ew-muted">记录本次汇总食材的支出，不分摊到每道菜。</text><text wx:if="{{formError}}" class="ew-error">{{formError}}</text><button class="ew-hit-target ew-link" disabled="{{busy}}" bindtap="removeExpense">清除这笔记录</button></ui-confirm>
  <ui-confirm visible="{{formVisible}}" title="{{formMode === 'manual' ? '手动添加食材' : '调整食材'}}" busy="{{busy}}" confirm-label="保存" bind:cancel="closeForm" bind:confirm="saveForm"><ui-field disabled="{{busy}}" label="食材名称" required value="{{formName}}" bind:change="onName" /><ui-field disabled="{{busy}}" label="数量与单位" required value="{{formQuantity}}" placeholder="例如：2个、500克或适量" bind:change="onQuantity" /><ui-field disabled="{{busy}}" wx:if="{{formMode === 'manual'}}" label="备注" value="{{formNote}}" maxlength="500" bind:change="onNote" /><view wx:if="{{formError}}" class="ew-error">{{formError}}</view></ui-confirm>
</view>
