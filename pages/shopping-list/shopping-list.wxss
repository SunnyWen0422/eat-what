.shopping-page{
  min-height:100vh;
  background:#f7f8fa;
  padding:24rpx;
}
.header{
  background:#fff;
  border-radius:16rpx;
  padding:24rpx;
  display:flex;
  flex-direction:column;
  gap:18rpx;
  margin-bottom:24rpx;
}
.title{
  font-size:32rpx;
  font-weight:700;
}
.btn{
  align-self:flex-start;
}
.content{
  background:#fff;
  border-radius:16rpx;
  padding:16rpx 18rpx;
}
.empty{
  padding:40rpx 0;
  text-align:center;
  color:#888;
}
.list{
  display:flex;
  flex-direction:column;
  gap:12rpx;
}
.item{
  padding:16rpx 16rpx;
  border:1rpx solid rgba(0,0,0,0.06);
  border-radius:12rpx;
}
.name{
  font-size:28rpx;
  font-weight:600;
}
.meta{
  margin-top:8rpx;
  color:#666;
  display:flex;
  gap:12rpx;
  font-size:24rpx;
}
.qty{
  font-weight:600;
}

