.list-page { min-height: 100vh; padding: 24rpx; background: #f6f8f7; box-sizing: border-box; }
.list-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; color: #20362c; }
.sync { display: block; margin-top: 6rpx; color: #7b8a82; font-size: 24rpx; }
.head-actions { display: flex; gap: 18rpx; color: #398762; font-size: 24rpx; }
.notice, .loading, .empty-state, .summary-panel { padding: 20rpx; margin-bottom: 16rpx; background: #fff; border-radius: 8rpx; }
.filters { display: flex; gap: 18rpx; margin-bottom: 18rpx; }
.filter { padding: 12rpx 20rpx; border-radius: 999rpx; color: #6f7d75; background: #e8eeeb; font-size: 26rpx; }
.filter.active { color: #fff; background: #2ba471; }
.summary-toggle { display: flex; justify-content: space-between; padding: 20rpx 22rpx; margin-bottom: 12rpx; background: #e8f5ee; border-radius: 8rpx; color: #246748; font-weight: 600; }
.summary-row { display: grid; grid-template-columns: 1fr auto; gap: 10rpx; padding: 16rpx 0; border-bottom: 1rpx solid #edf1ef; color: #33483e; }
.summary-row text:last-child { grid-column: 1 / -1; color: #8a9891; font-size: 23rpx; }
.summary-row.separate { color: #a56720; }
.dish-group { margin-bottom: 18rpx; background: #fff; border-radius: 8rpx; overflow: hidden; }
.dish-header { display: flex; justify-content: space-between; padding: 22rpx; background: #eaf5ef; color: #275b43; font-weight: 700; }
.item-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 22rpx; border-top: 1rpx solid #edf1ef; }
.check { width: 38rpx; height: 38rpx; border: 2rpx solid #b6c5bd; border-radius: 50%; color: #fff; background: #fff; text-align: center; line-height: 38rpx; }
.check.checked { border-color: #2ba471; background: #2ba471; }
.item-body { flex: 1; min-width: 0; }
.item-name { display: block; font-size: 30rpx; color: #263a30; }
.item-name.done { color: #9aa69f; text-decoration: line-through; }
.item-source { display: block; margin-top: 6rpx; color: #738179; font-size: 24rpx; }
.delete { color: #b65f54; font-size: 24rpx; }
.empty-small { padding: 18rpx 0; color: #8b9891; font-size: 24rpx; text-align: center; }
.empty-state { padding: 70rpx 24rpx; text-align: center; color: #738179; }
.empty-state button { margin-top: 20rpx; color: #2ba471; background: #eef8f2; }
