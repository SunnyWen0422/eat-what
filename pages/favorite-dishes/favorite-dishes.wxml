<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px"><view class="ew-heading">收藏的好菜</view><view class="ew-field"><input placeholder-class="ew-placeholder" class="ew-input" placeholder="搜索收藏的菜名" value="{{searchKeyword}}" bindinput="onSearchInput" /></view><ui-state wx:if="{{loading}}" kind="loading" title="正在读取收藏" /><ui-state wx:elif="{{errorMessage}}" kind="error" title="收藏暂未读到" description="{{errorMessage}}" action-label="重试" bind:action="loadFavorites" /><ui-state wx:elif="{{!favorites.length}}" kind="empty" illustration="empty-favorites" title="还没有收藏好菜" description="从菜谱详情收藏，下次更容易找到。" action-label="去看菜谱" bind:action="onBrowse" /><ui-state wx:elif="{{!filtered.length}}" kind="empty" density="inline" title="没有符合搜索的收藏" description="试试短一点的菜名关键词" /><view wx:else><view wx:if="{{mealAddError}}" class="ew-notice">{{mealAddError}}</view><view wx:for="{{filtered}}" wx:key="id" class="favorite-row"><dish-card dish="{{item}}" data-dish="{{item}}" bind:open="onViewDish" /><button class="ew-hit-target ew-link" data-id="{{item.id}}" loading="{{addingId === item.id}}" disabled="{{addingId || removingId}}" bindtap="onAddToMeal">加入本餐</button><button class="ew-hit-target ew-link" data-id="{{item.id}}" disabled="{{removingId}}" bindtap="onRemoveFavorite">取消收藏</button></view></view></view>
