.page { min-height: 100vh; background: #F7F8FA; padding: 16px; }

/* 搜索框 */
.search-bar { margin-bottom: 14px; }
.search-input {
  width: 100%; height: 44px; background: #fff; border-radius: 22px;
  padding: 0 20px; font-size: 28rpx; box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 加载 */
.loading-box { padding: 20px 0; }

/* 空状态 */
.empty-box { text-align: center; padding: 120rpx 40rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 20px; opacity: 0.5; }
.empty-title { font-size: 32rpx; font-weight: bold; color: #333; display: block; }
.empty-desc { font-size: 26rpx; color: #999; margin-top: 10px; display: block; }

/* 收藏列表 */
.favorites-list { display: flex; flex-direction: column; gap: 10px; }
.favorite-item {
  display: flex; align-items: center;
  background: #fff; border-radius: 14rpx; padding: 14px;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.favorite-item:active { background: #f9f9f9; }

.fav-img { width: 90rpx; height: 90rpx; border-radius: 12rpx; background: #f0f0f0; flex-shrink: 0; margin-right: 14px; }
.fav-img-fb {
  width: 90rpx; height: 90rpx; border-radius: 12rpx; flex-shrink: 0;
  margin-right: 14px; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; background: #f0f0f0;
}

.fav-info { flex: 1; min-width: 0; }
.fav-name { font-size: 30rpx; font-weight: 600; color: #222; display: block; }
.fav-type { font-size: 24rpx; color: #2BA471; display: block; margin-top: 4px; }

.fav-action { flex-shrink: 0; margin-left: 8px; }
.fav-remove { font-size: 24rpx; color: #E74C3C; padding: 8rpx 12rpx; }
