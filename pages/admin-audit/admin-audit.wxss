page { min-height: 100%; background: #f4f6f5; color: #1f2924; } button::after { border: none; }
.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; } .heading { min-height: 78rpx; display: flex; align-items: baseline; gap: 14rpx; } .title { font-size: 38rpx; font-weight: 700; } .count { color: #78827c; font-size: 23rpx; }
.filters { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; } .filters picker view, .filters input { min-width: 0; min-height: 76rpx; padding: 0 15rpx; box-sizing: border-box; display: flex; align-items: center; background: #fff; border: 2rpx solid #dce4df; border-radius: 9rpx; color: #56625b; font-size: 22rpx; } .buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin: 12rpx 0 16rpx; } .buttons button, .more, .primary { min-height: 76rpx; margin: 0; background: #fff; color: #46524b; border-radius: 9rpx; font-size: 24rpx; } .buttons .primary, .primary, .more { color: #fff; background: #237a55; }
.notice { padding: 14rpx 16rpx; margin-bottom: 14rpx; color: #176a47; background: #e3f3eb; border-radius: 8rpx; font-size: 24rpx; } .state { min-height: 280rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #6d7772; gap: 18rpx; } .list { display: flex; flex-direction: column; gap: 12rpx; } .log { padding: 19rpx; background: #fff; border: 2rpx solid #e1e7e3; border-radius: 12rpx; } .log-top { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; } .action { min-width: 0; font-size: 27rpx; font-weight: 650; word-break: break-word; } .result { padding: 5rpx 9rpx; border-radius: 7rpx; font-size: 20rpx; } .result.ok { color: #176a47; background: #e3f3eb; } .result.bad { color: #9d3d37; background: #fff0ef; } .meta, .detail, .time { display: block; margin-top: 8rpx; color: #69746d; font-size: 22rpx; line-height: 1.45; word-break: break-word; } .detail { color: #3f4c45; } .time { color: #8a948e; font-size: 20rpx; } .more { margin-top: 4rpx; } .end { padding: 22rpx; text-align: center; color: #8a948e; font-size: 22rpx; }
