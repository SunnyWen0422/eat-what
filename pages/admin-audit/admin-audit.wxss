/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
page { min-height: 100%; background: #F8F7F2; color: #25332B; } button::after { border: none; }
.page { min-height: 100vh; padding:24rpx; box-sizing: border-box; } .heading { min-height: 78rpx; display: flex; align-items: baseline; gap:14rpx; } .title { font-size:1.125em; font-weight: 700; } .count { color: #56645B; font-size:0.75em; }
.filters { display: grid; grid-template-columns: 1fr 1fr; gap:10rpx; } .filters picker view, .filters input { min-width: 0; min-height: 76rpx; padding:0 15rpx; box-sizing: border-box; display: flex; align-items: center; background: #FFFFFF; border: 2rpx solid #D9E1D5; border-radius:9rpx; color: #56645B; font-size:0.75em; } .buttons { display: grid; grid-template-columns: 1fr 1fr; gap:10rpx; margin:12rpx 0 16rpx; } .buttons button, .more, .primary { min-height: 76rpx; margin:0; background: #FFFFFF; color: #25332B; border-radius:9rpx; font-size:0.75em; } .buttons .primary, .primary, .more { color: #FFFFFF; background: #28634E; }
.notice { padding:14rpx 16rpx; margin-bottom:14rpx; color: #28634E; background: #EDF3ED; border-radius:8rpx; font-size:0.75em; } .state { min-height: 280rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #56645B; gap:18rpx; } .list { display: flex; flex-direction: column; gap:12rpx; } .log { padding:19rpx; background: #FFFFFF; border: 2rpx solid #D9E1D5; border-radius:12rpx; } .log-top { display: flex; justify-content: space-between; align-items: center; gap:12rpx; } .action { min-width: 0; font-size:1em; font-weight: 650; word-break: break-word; } .result { padding:5rpx 9rpx; border-radius:7rpx; font-size:0.75em; } .result.ok { color: #28634E; background: #EDF3ED; } .result.bad { color: #A93B30; background: #FFF0ED; } .meta, .detail, .time { display: block; margin-top:8rpx; color: #56645B; font-size:0.75em; line-height: 1.45; word-break: break-word; } .detail { color: #25332B; } .time { color: #56645B; font-size:0.75em; } .more { margin-top:4rpx; } .end { padding:22rpx; text-align: center; color: #56645B; font-size:0.75em; }

/* 页面共享主题，适用于本页详情、表单和弹层。 */

/* Shared finish for legacy pages; layout and permission-specific states remain local. */
.ew-page { background:#F8F7F2; color:#25332B; }
.ew-page .btn-primary, .ew-page .primary-btn, .ew-page .save-btn, .ew-page .primary-action, .ew-page .generate-btn { background:#28634E; border-radius:24rpx; }
.ew-page .choice-chip, .ew-page .ingredient-chip, .ew-page .count-btn, .ew-page .clear-btn, .ew-page .period-nav, .ew-page .filter-chip { min-height:44px; min-width:44px; box-sizing:border-box; }

/* Input and touch minima remain fixed under small screens/font changes. */
.ew-page button,.ew-page input,.ew-page .count-btn,.ew-page .choice-chip,.ew-page .filter-chip,.ew-page .date-picker{min-height:44px;box-sizing:border-box}
.ew-page .primary-btn,.ew-page .save-btn,.ew-page .primary-action,.ew-page .wx-login-btn{min-height:48px}

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }

button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }
