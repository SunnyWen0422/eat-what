<view class="ew-page page" style="font-size:{{14 * fontScale}}px">
  <ui-state wx:if="{{authStatus}}" kind="{{authStatus}}" title="{{authMessage}}" />
  <view class="heading"><text class="title">审计日志</text><text class="count">{{total}} 条</text></view>
  <view class="filters"><picker mode="selector" range="{{actions}}" value="{{actionIndex}}" bindchange="onAction"><view>{{actions[actionIndex] || '全部操作'}}⌄</view></picker><input type="number" value="{{targetUserId}}" bindinput="onUser" placeholder="目标用户 ID"/><picker mode="date" value="{{from}}" bindchange="onFrom"><view>{{from || '开始日期'}}⌄</view></picker><picker mode="date" value="{{to}}" bindchange="onTo"><view>{{to || '结束日期'}}⌄</view></picker></view>
  <view class="buttons"><button bindtap="reset">重置</button><button class="primary" bindtap="search" loading="{{loading}}">查询</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading && !ready}}" class="state">正在加载审计记录...</view><view wx:elif="{{error && !ready}}" class="state"><text>{{error}}</text><button class="primary" bindtap="retry">重新加载</button></view><view wx:elif="{{ready && !logs.length}}" class="state">当前条件下暂无记录</view>
  <view wx:else class="list"><view class="log" wx:for="{{logs}}" wx:key="id"><view class="log-top"><text class="action">{{item.action}}</text><text class="result {{item.result === 'SUCCESS' ? 'ok' : 'bad'}}">{{item.result}}</text></view><text class="meta">管理员 {{item.adminUserId}} · {{item.target}}</text><text wx:if="{{item.detail}}" class="detail">{{item.detail}}</text><text class="time">{{item.createdAt}} · 请求 {{item.requestId || '-'}}</text></view><button wx:if="{{hasMore}}" class="more" bindtap="more" loading="{{loadingMore}}">加载更多</button><text wx:else class="end">已显示全部记录</text></view>
</view>
