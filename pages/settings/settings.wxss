/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
.settings-page { min-height: 100vh; box-sizing: border-box; padding:16px 16px 32px; background: #f5f7f6; color:#25332B; }
.sync-row { display: flex; align-items: center; gap:7px; margin-bottom:14px; color:#56645B; font-size:0.75em; }
.sync-dot { width: 7px; height: 7px; border-radius:50%; background:#28634E; }
.sync-dot.online { background: #28634E; }
.section { padding:17px 0; border-bottom: 1px solid #dde3e0; }
.section-title { margin-bottom:5px; font-size:1em; font-weight: 700; }
.section-desc { margin-bottom:12px; color:#56645B; font-size:0.75em; line-height: 1.5; }
.chip-grid { display: flex; flex-wrap: wrap; gap:8px; }
.choice-chip { min-width: 66px; box-sizing: border-box; padding:9px 12px; border: 1px solid #d5dcd8; border-radius:6px; background: #FFFFFF; color: #56645B; text-align: center; font-size:0.8125em; }
.choice-chip.selected { border-color: #28634E; background: #EDF3ED; color:#28634E; font-weight: 600; }
.choice-chip.danger.selected { border-color: #bd5143; background: #FFF0ED; color:#A93B30; }
.ingredient-row { display: flex; gap:8px; }
.ingredient-input { min-width: 0; flex: 1; height: 42px; box-sizing: border-box; padding:0 12px; border: 1px solid #d5dcd8; border-radius:6px; background: #FFFFFF; font-size:1em; }
.add-btn { width: 76px; height: 42px; line-height: 42px; padding:0; border-radius:6px; background: #EDF3ED; color:#28634E; font-size:1em; }
.top-gap { margin-top:10px; }
.ingredient-chip { padding:7px 10px; border-radius:5px; background: #FFF0ED; color:#28634E; font-size:0.75em; }
.save-btn { margin-top:24px; height: 46px; line-height: 46px; border-radius:6px; background: #28634E; color: #FFFFFF; font-size:1em; font-weight: 600; }

/* 页面共享主题，适用于本页详情、表单和弹层。 */

/* Shared finish for legacy pages; layout and permission-specific states remain local. */
.ew-page { background:#F8F7F2; color:#25332B; }
.ew-page .btn-primary, .ew-page .primary-btn, .ew-page .save-btn, .ew-page .primary-action, .ew-page .generate-btn { background:#28634E; border-radius:24rpx; }
.ew-page .choice-chip, .ew-page .ingredient-chip, .ew-page .count-btn, .ew-page .clear-btn, .ew-page .period-nav, .ew-page .filter-chip { min-height:44px; min-width:44px; box-sizing:border-box; }

/* Input and touch minima remain fixed under small screens/font changes. */
.ew-page button,.ew-page input,.ew-page .count-btn,.ew-page .choice-chip,.ew-page .filter-chip,.ew-page .date-picker{min-height:44px;box-sizing:border-box}
.ew-page .primary-btn,.ew-page .save-btn,.ew-page .primary-action,.ew-page .wx-login-btn{min-height:48px}

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }

button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }

/* Warm table v2: settings */
 .settings-page { padding:20px 16px 28px; background:#F8F7F2; }.sync-row { padding:0 0 16px; color:#56645B; font-size:1em; gap:8px; }.section { border:0; background:#FFFFFF; border-radius:18px; padding:18px 16px; margin-bottom:14px; box-shadow:none; }.section-title { font-size:1.125em; color:#25332B; line-height:1.5; }.section-desc { font-size:1em; line-height:1.7; margin:6px 0 12px; }.chip-grid { display:flex; flex-wrap:wrap; gap:8px; }.choice-chip, .ingredient-chip { min-height:44px; border-radius:12px; padding:10px 12px; background:#F5F6F0; color:#25332B; border:1px solid transparent; box-sizing:border-box; line-height:1.5; font-size:1em; }.choice-chip.selected { background:#EDF3ED; color:#28634E; border-color:#28634E; }.choice-chip.danger.selected { background:#A93B30; color:#FFFFFF; border-color:#A93B30; }.ingredient-row { display:flex; gap:8px; }.ingredient-input { flex:1; min-width:0; background:#FFFFFF; border:1px solid #7C8E80; border-radius:12px; min-height:48px; padding:0 12px; }.add-btn { padding:0 12px; min-height:48px; color:#28634E; background:#EDF3ED; border-radius:12px; }.save-btn { min-height:48px; height:auto; padding:12px 16px; border-radius:14px; background:#28634E; color:#FFFFFF; margin:20px 0; font-size:1em; }.save-btn[disabled] { background:#E8EBE5; color:#25332B; }

/* App-local motion preference remains independent of recommendation persistence. */
.appearance-row { display:flex; align-items:center; flex-wrap:wrap; gap:12px; min-width:0; }
.appearance-copy { flex:1 1 180px; min-width:0; }
.appearance-copy .section-title, .appearance-copy .section-desc { overflow-wrap:anywhere; }
.motion-switch { min-width:44px; min-height:44px; display:flex; align-items:center; }
.motion-status { display:block; margin-top:8px; font-size:0.8125em; line-height:1.5; color:#56645B; overflow-wrap:anywhere; }
