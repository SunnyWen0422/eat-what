<block wx:if="{{workspaceEnabled}}"><include src="../../templates/meal-workspace.wxml" /></block>
<block wx:else>
<!--index.wxml-->
<scroll-view class="ew-page scrollarea" style="font-size:{{fontBase * fontScale}}px" scroll-y enhanced>
  <view class="container">
    <!-- 标题区 -->
    <view class="header-area">
      <view class="header-title"><text>今天我们吃什么？</text></view>
      <text class="header-subtitle">家常菜随手搭，今天吃什么不用想太久</text>
    </view>

    <view class="meal-options">
      <view class="ew-hit-target meal-option {{mealType === 'breakfast' ? 'active' : ''}}" bindtap="onMealTypeSelect" data-type="breakfast">早餐</view>
      <view class="ew-hit-target meal-option {{mealType === 'lunch' ? 'active' : ''}}" bindtap="onMealTypeSelect" data-type="lunch">午餐</view>
      <view class="ew-hit-target meal-option {{mealType === 'dinner' ? 'active' : ''}}" bindtap="onMealTypeSelect" data-type="dinner">晚餐</view>
    </view>

    <view class="ew-card"><view class="ew-title">这餐几个人吃？</view><input class="ew-input" type="number" value="{{people}}" bindblur="onPeopleChange" /><button class="ew-hit-target ew-link" bindtap="onAdvancedToggle">{{advancedExpanded ? '收起菜品数量' : '调整荤素、汤与主食数量'}}</button></view>
    <!-- 参数配置卡片（独立模块） -->
    <view class="params-grid" wx:if="{{advancedExpanded}}">
      <!-- 荤菜数量 -->
      <view class="param-card">
        <view class="card-label"><text>荤菜数量</text></view>
        <view class="card-count">
          <view class="ew-hit-target count-btn minus" bindtap="onMeatMinus">−</view>
          <text class="card-num">{{meat}}</text>
          <view class="ew-hit-target count-btn plus" bindtap="onMeatPlus">+</view>
        </view>
      </view>

      <!-- 素菜数量 -->
      <view class="param-card">
        <view class="card-label"><text>素菜数量</text></view>
        <view class="card-count">
          <view class="ew-hit-target count-btn minus" bindtap="onVegMinus">−</view>
          <text class="card-num">{{veg}}</text>
          <view class="ew-hit-target count-btn plus" bindtap="onVegPlus">+</view>
        </view>
      </view>

      <!-- 汤品数量 -->
      <view class="param-card">
        <view class="card-label"><text>汤品数量</text></view>
        <view class="card-count">
          <view class="ew-hit-target count-btn minus" bindtap="onSoupMinus">−</view>
          <text class="card-num">{{soup}}</text>
          <view class="ew-hit-target count-btn plus" bindtap="onSoupPlus">+</view>
        </view>
      </view>

      <!-- 甜品数量 -->
      <view class="param-card">
        <view class="card-label"><text>甜品数量</text></view>
        <view class="card-count">
          <view class="ew-hit-target count-btn minus" bindtap="onDessertMinus">−</view>
          <text class="card-num">{{dessert}}</text>
          <view class="ew-hit-target count-btn plus" bindtap="onDessertPlus">+</view>
        </view>
      </view>

      <!-- 主食数量 -->
      <view class="param-card">
        <view class="card-label"><text>主食数量</text></view>
        <view class="card-count">
          <view class="ew-hit-target count-btn minus" bindtap="onStapleMinus">−</view>
          <text class="card-num">{{staple}}</text>
          <view class="ew-hit-target count-btn plus" bindtap="onStaplePlus">+</view>
        </view>
      </view>
    </view>

    <view class="ew-section-title">今天的用餐</view><view wx:if="{{todayError}}" class="ew-hit-target ew-notice" bindtap="onTodayMeal">{{todayError}}</view><meal-card wx:for="{{todayMeals}}" wx:key="mealType" title="{{item.label}}" name="{{item.plan ? item.plan.recipeName : '还没有安排'}}" status="{{item.statusLabel}}" description="{{item.actualNames ? '实际：' + item.actualNames : '安排和实际用餐分别保存'}}" bind:open="onTodayMeal" />
    <!-- 今日小提示 -->
    <view class="tip-card">
      
      <text class="tip-text">今天想吃得清爽一点？荤素搭配，刚刚好。</text>
    </view>

    <!-- 推荐筛选 -->
    <view class="tags-area" wx:if="{{recommendationPreferencesEnabled}}">
      <view class="filter-header">
        <text class="tags-label">快捷筛选</text>
        <text class="ew-hit-target filter-more" bindtap="onOpenRecommendationFilter">更多筛选{{filterCount > 0 ? ' (' + filterCount + ')' : ''}}</text>
      </view>
      <scroll-view class="tag-group" scroll-x enhanced show-scrollbar="false">
        <view
          class="ew-hit-target hot-tag {{item.selected ? 'active' : ''}}"
          wx:for="{{homeQuickOptions}}"
          wx:key="id"
          bindtap="onQuickFilterTap"
          data-id="{{item.id}}"
        >
          <text>{{item.label}}</text>
          <text class="selected-mark" wx:if="{{item.selected}}">✓</text>
        </view>
      </scroll-view>
      <view class="preference-toggle-row">
        <text>使用我的偏好</text>
        <switch checked="{{useSavedPreferences}}" bindchange="onUseSavedPreferencesChange" color="{{theme.brand}}" />
      </view>
      <view class="filter-feedback" wx:if="{{filterCount > 0}}">
        <text class="filter-summary">当前：{{filterSummary}}</text>
        <text class="ew-hit-target filter-clear" bindtap="onClearFilters">清除</text>
      </view>
    </view>

    <!-- 我的菜谱区域 -->
    <view class="my-recipes" wx:if="{{savedRecipes.length > 0}}">
      <view class="section-header-row">
        <view class="section-header-title"><text>我的菜谱</text></view>
        <text class="section-header-hint">点击应用配置</text>
      </view>
      <view class="recipe-list">
        <view class="ew-hit-target recipe-item {{selectedRecipeId === item.id ? 'selected' : ''}}"
              wx:for="{{savedRecipes}}"
              wx:key="id"
              bindtap="onSelectRecipe"
              data-id="{{item.id}}">
          <view class="recipe-header">
            <text class="recipe-name">{{item.name}}</text>
            <view class="ew-hit-target delete-btn" catchtap="onDeleteRecipe" data-id="{{item.id}}">×</view>
          </view>
          <view class="recipe-info">
            <text class="info-tag">{{item.people}}人</text>
            <text class="info-tag meat-tag">{{item.meatCount}}荤</text>
            <text class="info-tag veg-tag">{{item.vegCount}}素</text>
            <text class="info-tag soup-tag">{{item.soupCount}}汤</text>
            <text class="info-tag dessert-tag" wx:if="{{item.dessertCount > 0}}">{{item.dessertCount}}甜</text>
          </view>
          <view class="recipe-dishes" wx:if="{{item.selectedDishes && item.selectedDishes.length > 0}}">
            <text class="dish-tag" wx:for="{{item.selectedDishes}}" wx:for-item="dish" wx:key="name">{{dish.name}}</text>
          </view>
          <view class="selected-badge" wx:if="{{selectedRecipeId === item.id}}">✓ 已选</view>
        </view>
      </view>
      <view class="ew-hit-target unselect-btn" wx:if="{{selectedRecipeId}}" bindtap="onUnselectRecipe">取消选择</view>
    </view>

    <!-- 数据加载提示 -->
    <view class="loading-tip" wx:if="{{isDataLoading}}">
      <view class="loading-tip-content">
        <view class="loading-spinner"></view>
        <text class="loading-text">数据加载中，请稍后...</text>
      </view>
    </view>

    <!-- 按钮区 -->
    <view class="cta-area">
      <button class="ew-hit-target chat-btn" bindtap="onOpenChat"><text>问问助手</text></button>
      <button class="ew-hit-target primary-btn" bindtap="onStart" disabled="{{isDataLoading}}">生成这餐方案</button>
      <button class="ew-hit-target secondary-btn" bindtap="onCustomize"><text>自己选择菜品</text></button>
    </view>
  </view>
</scroll-view>

</block>
