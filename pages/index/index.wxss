/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8faf9;
  padding-top: 0;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  padding-top: 0;
}

/* ==================== 标题区 ==================== */
.header-area {
  padding: 8px 16px 10px;
  text-align: center;
}
.header-title {
  font-size: 22px;
  font-weight: bold;
  color: #2d5a3d;
  letter-spacing: 1px;
  display: block;
}
.header-subtitle {
  font-size: 12px;
  color: #8fa996;
  margin-top: 8px;
  display: block;
}

/* ==================== 参数卡片列表（单列） ==================== */
.params-grid {
  margin: 0 16px 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.param-card {
  background: #fff;
  border-radius: 14px;
  padding: 16px 18px;
  box-shadow: 0 2px 10px rgba(45, 90, 61, 0.06);
  border: 1px solid rgba(45, 90, 61, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-label {
  font-size: 15px;
  color: #555;
  font-weight: 500;
  flex-shrink: 0;
}
.card-count {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.card-num {
  font-size: 24px;
  font-weight: bold;
  color: #2d5a3d;
  width: 32px;
  text-align: center;
}

/* 加减按钮 */
.count-btn {
  width: 36px;
  height: 36px;
  min-width: 36px;
  min-height: 36px;
  border-radius: 50%;
  background: #5cb85c;
  color: #fff;
  font-size: 20px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 36px;
  box-sizing: border-box;
  overflow: hidden;
}
.count-btn::after { border: none; }
.count-btn.minus {
  background: #7ec87e;
}
.count-btn.plus {
  background: #5cb85c;
}

/* ==================== 今日小提示 ==================== */
.tip-card {
  margin: 0 16px 8px;
  background: linear-gradient(135deg, #f0f9ee 0%, #e8f5e4 100%);
  border-radius: 10px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(92, 184, 92, 0.15);
}
.tip-icon {
  font-size: 15px;
  flex-shrink: 0;
}
.tip-text {
  font-size: 12px;
  color: #3d7a4d;
  line-height: 1.4;
}

/* ==================== 热门搭配标签组 ==================== */
.tags-area {
  margin: 0 16px 10px;
}
.tags-label {
  font-size: 13px;
  font-weight: bold;
  color: #555;
  margin-bottom: 10px;
  display: block;
}
.tag-group {
  display: flex;
  gap: 10px;
}
.hot-tag {
  padding: 8px 16px;
  background: #f5f7f4;
  border-radius: 20px;
  font-size: 13px;
  color: #666;
  border: 1px solid #e0e8dc;
  transition: all 0.25s;
}
.hot-tag.active {
  background: linear-gradient(135deg, #5cb85c 0%, #4cae4c 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 3px 10px rgba(92, 184, 92, 0.3);
}

/* ==================== 已选菜品提示区 ==================== */
.selected-dishes-hint {
  margin: 0 16px 10px;
  padding: 10px 12px;
  background: #f0f9ee;
  border: 1px solid #c8e6c9;
  border-radius: 10px;
}
.hint-header {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}
.hint-icon {
  color: #5cb85c;
  font-size: 14px;
  font-weight: bold;
  margin-right: 4px;
}
.hint-title {
  font-size: 13px;
  font-weight: bold;
  color: #3d7a4d;
  flex: 1;
}
.hint-clear {
  font-size: 11px;
  color: #999;
  padding: 2px 8px;
}
.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.dish-tag {
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 4px;
}
.meat-tag {
  color: #d4380d;
  background: #fff2e8;
  border: 1px solid #ffbb96;
}
.veg-tag {
  color: #52c41a;
  background: #f6ffed;
  border: 1px solid #b7e1b0;
}
.soup-tag {
  color: #1890ff;
  background: #e6f7ff;
  border: 1px solid #91d5ff;
}

/* ==================== 我的菜谱区域 ==================== */
.my-recipes {
  margin: 0 16px 16px;
  padding: 14px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
}
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}
.section-header-title {
  font-size: 14px;
  font-weight: bold;
  color: #333;
}
.section-header-hint {
  font-size: 11px;
  color: #aaa;
}
.recipe-list {
  height: 180px;
}
.recipe-item {
  padding: 10px;
  background: #fafbfa;
  border-radius: 8px;
  border: 1px solid #eee;
  position: relative;
  margin-bottom: 8px;
  transition: all 0.2s;
}
.recipe-item.selected {
  background: #f0f9ee;
  border-color: #5cb85c;
}
.recipe-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}
.recipe-name {
  font-size: 13px;
  font-weight: bold;
  color: #333;
}
.delete-btn {
  width: 18px;
  height: 18px;
  line-height: 17px;
  text-align: center;
  background: #ff7875;
  color: #fff;
  border-radius: 50%;
  font-size: 14px;
  font-weight: bold;
}
.recipe-info {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}
.info-tag {
  font-size: 11px;
  color: #777;
  background: #fff;
  padding: 2px 5px;
  border-radius: 3px;
}
.recipe-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
  margin-top: 5px;
}
.recipe-dishes .dish-tag {
  font-size: 10px;
  color: #5cb85c;
  background: #fff;
  padding: 1px 4px;
  border-radius: 3px;
  border: 1px solid #5cb85c;
}
.selected-badge {
  position: absolute;
  top: -6px;
  right: -6px;
  background: #5cb85c;
  color: #fff;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 10px;
  box-shadow: 0 1px 4px rgba(92, 184, 92, 0.3);
}
.unselect-btn {
  margin-top: 10px;
  text-align: center;
  padding: 6px;
  background: #f5f5f5;
  border-radius: 4px;
  color: #888;
  font-size: 12px;
}

/* ==================== 按钮区 ==================== */
.cta-area {
  padding: 2px 16px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.primary-btn {
  width: 80%;
  height: 48px;
  background: linear-gradient(135deg, #5cb85c 0%, #449d44 100%);
  color: #fff;
  font-size: 17px;
  font-weight: bold;
  border-radius: 24px;
  border: none;
  box-shadow: 0 5px 20px rgba(76, 175, 80, 0.35);
  letter-spacing: 1px;
}
.primary-btn::after { border: none; }

.secondary-btn {
  width: 80%;
  height: 42px;
  background: #fff;
  color: #d4a017;
  font-size: 14px;
  font-weight: bold;
  border-radius: 21px;
  border: 1.5px solid #e8d59e;
  box-shadow: 0 2px 8px rgba(212, 160, 23, 0.08);
}
.secondary-btn::after { border: none; }
