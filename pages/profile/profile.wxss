/* pages/profile/profile.wxss */
.profile-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20px;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #3cc51f 0%, #2e8b57 100%);
  margin: 20px;
  border-radius: 16px;
  padding: 24px;
  display: flex;
  align-items: center;
  position: relative;
  box-shadow: 0 4px 12px rgba(60, 197, 31, 0.2);
}

.user-avatar {
  position: relative;
  margin-right: 16px;
}

.avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.8);
}

.edit-btn {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24px;
  height: 24px;
  background-color: #3cc51f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid white;
}

.edit-icon {
  font-size: 12px;
  line-height: 1;
}

.user-info {
  flex: 1;
  color: white;
}

.nickname {
  font-size: 20px;
  font-weight: bold;
  display: block;
  margin-bottom: 4px;
}

.level {
  font-size: 14px;
  opacity: 0.9;
}

/* 统计区域 */
.stats-section {
  background-color: white;
  margin: 0 20px 20px;
  border-radius: 12px;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 24px;
  font-weight: bold;
  color: #3cc51f;
  display: block;
  margin-bottom: 4px;
}

.stat-label {
  font-size: 12px;
  color: #666;
}

.stat-divider {
  width: 1px;
  height: 40px;
  background-color: #e5e5e5;
}

/* 菜单区域 */
.menu-section {
  background-color: white;
  margin: 0 20px;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #f5f5f5;
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f8f8;
}

.menu-icon {
  font-size: 20px;
  margin-right: 16px;
  width: 24px;
  text-align: center;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 16px;
  color: #333;
  display: block;
  margin-bottom: 2px;
}

.menu-desc {
  font-size: 12px;
  color: #999;
}

.menu-arrow {
  font-size: 16px;
  color: #ccc;
  margin-left: 8px;
}

/* 版本信息 */
.version-info {
  text-align: center;
  margin-top: 40px;
  padding: 0 20px;
}

.version-text {
  font-size: 12px;
  color: #999;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .user-card {
    padding: 20px;
  }

  .avatar {
    width: 56px;
    height: 56px;
  }

  .nickname {
    font-size: 18px;
  }

  .stats-section {
    padding: 16px;
  }

  .stat-value {
    font-size: 20px;
  }
}
