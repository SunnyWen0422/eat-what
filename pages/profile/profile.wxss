/* pages/profile/profile.wxss */
.profile-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20px;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(150deg, #2BA471 0%, #1A7A4C 60%, #0D5C35 100%);
  margin: 24rpx 20rpx;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(43,164,113,0.25);
}

.user-avatar {
  position: relative;
  margin-bottom: 16rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}

.edit-btn {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #E8F5E9;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.edit-icon {
  font-size: 20rpx;
}

.user-info {
  color: #fff;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}

.level {
  font-size: 24rpx;
  opacity: 0.85;
}

.phone-num { display: none; }

.user-avatar {
  position: relative;
  margin-right: 16px;
}

.avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.8);
}

.edit-btn {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24px;
  height: 24px;
  background-color: #3cc51f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid white;
}

.edit-icon {
  font-size: 12px;
  line-height: 1;
}

.user-info {
  flex: 1;
  color: white;
}

.nickname {
  font-size: 20px;
  font-weight: bold;
  display: block;
  margin-bottom: 4px;
}

.level {
  font-size: 14px;
  opacity: 0.9;
}

.phone-num {
  font-size: 13px;
  opacity: 0.85;
  display: block;
  display: block;
  margin-top: 2px;
}

/* 菜单区域 */
.menu-section {
  background-color: white;
  margin: 0 20px;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #f5f5f5;
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f8f8;
}

.menu-icon {
  font-size: 20px;
  margin-right: 16px;
  width: 24px;
  text-align: center;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 16px;
  color: #333;
  display: block;
  margin-bottom: 2px;
}

.menu-desc {
  font-size: 12px;
  color: #999;
}

.menu-arrow {
  font-size: 16px;
  color: #ccc;
  margin-left: 8px;
}

/* 版本信息 */
.version-info {
  text-align: center;
  margin-top: 40px;
  padding: 0 20px;
}

.version-text {
  font-size: 12px;
  color: #999;
}

/* 游客登录弹窗 */
.login-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.login-modal {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 201;
  padding: 24px 20px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s;
}

.modal-show {
  transform: translateY(0);
}

.login-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.login-modal-title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}

.login-modal-close {
  font-size: 22px;
  color: #999;
  padding: 4px 8px;
}

.login-modal-desc {
  font-size: 14px;
  color: #999;
  margin-bottom: 20px;
}

.wx-login-btn {
  background: #07c160;
  color: #fff;
  font-size: 16px;
  border-radius: 12px;
  height: 48px;
  line-height: 48px;
  margin-bottom: 12px;
}

.login-skip {
  text-align: center;
  font-size: 14px;
  color: #999;
  padding: 8px;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .user-card {
    padding: 20px;
  }

  .avatar {
    width: 56px;
    height: 56px;
  }

  .nickname {
    font-size: 18px;
  }

  .stats-section {
    padding: 16px;
  }

  .stat-value {
    font-size: 20px;
  }
}
