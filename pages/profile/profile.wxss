/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
page { background:#F8F7F2; }
.profile-page { min-height:100vh; box-sizing:border-box; padding:16px 16px calc(20px + env(safe-area-inset-bottom)); background:#F8F7F2; }
.profile-page .ew-heading { margin-bottom:8px; }
.profile-page button { width:100%; min-width:44px; min-height:48px; height:auto; margin:0; font-family:inherit; font-size:1em; line-height:1.5; text-align:left; border:0; box-sizing:border-box; }
.profile-page button::after { border:0; }
.user-card { display:flex; align-items:center; flex-wrap:wrap; gap:12px; padding:16px 0; background:transparent; color:#25332B; border-bottom:1px solid #E6EAE1; border-radius:0; }
.user-avatar { width:48px; height:48px; flex:0 0 48px; }
.avatar, .avatar-fallback { width:48px; height:48px; border-radius:14px; }
.avatar-fallback { display:flex; align-items:center; justify-content:center; background:#F4E4D5; color:#854A2F; font-size:1.5em; }
.user-info { flex:1; min-width:0; text-align:left; }
.nickname, .level { display:block; overflow-wrap:anywhere; }
.nickname { font-size:1.125em; font-weight:600; color:#25332B; }
.level { margin-top:2px; color:#56645B; font-size:0.8125em; }
.profile-edit-label { color:#28634E; font-size:0.8125em; overflow-wrap:anywhere; }
.shopping-shortcut { display:flex; align-items:center; gap:12px; margin:12px 0 !important; padding:12px; background:#EDF3ED; border-radius:14px; }
.shopping-shortcut-body { flex:1; min-width:0; }
.shopping-shortcut-title, .shopping-shortcut-sync { display:block; overflow-wrap:anywhere; }
.shopping-shortcut-title { color:#25332B; font-weight:600; font-size:1em; }
.shopping-shortcut-sync { color:#56645B; font-size:0.8125em; margin-top:2px; }
.menu-section { margin:12px 0; padding:0; }
.menu-list { background:transparent; }
.menu-item { display:flex; align-items:center; gap:12px; padding:12px 0; min-height:52px; border-bottom:1px solid #E6EAE1 !important; border-radius:0; background:transparent; }
.menu-title { flex:1; min-width:0; color:#25332B; font-size:1em; overflow-wrap:anywhere; }
.admin-entry { margin-top:12px !important; }
.version-info { text-align:center !important; padding:12px 0; background:transparent; }
.version-text { display:block; color:#56645B; font-size:0.75em; overflow-wrap:anywhere; }
