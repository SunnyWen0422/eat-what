<view class="ew-page profile-page" style="font-size:{{fontBase * fontScale}}px">
  <text class="ew-heading">我的</text>
  <button class="ew-hit-target user-card" bindtap="onUserInfoTap"><view class="user-avatar"><image wx:if="{{userInfo.avatar}}" class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" binderror="onAvatarError" /><view wx:else class="avatar-fallback">我</view></view><view class="user-info"><text class="nickname">{{userInfo.nickname}}</text><text class="level">{{userInfo.level}}</text></view><text class="profile-edit-label">{{userInfo.level === '游客模式' ? '登录' : '编辑资料'}}</text><ui-icon name="chevron-right" tone="muted" size="16" /></button>
  <button class="ew-hit-target shopping-shortcut" bindtap="onShoppingListTap"><ui-icon name="shopping-basket" tone="muted" size="22" /><view class="shopping-shortcut-body"><text class="shopping-shortcut-title">购物清单 · {{shoppingSummary.pendingCount}} 项待买</text><text class="shopping-shortcut-sync">{{shoppingSummary.refreshing ? '更新中 · 已显示本地清单' : shoppingSummary.syncLabel}}</text></view><ui-icon name="chevron-right" tone="muted" size="16" /></button>
  <view class="menu-section"><view class="menu-list"><button wx:for="{{menuItems}}" wx:key="title" class="ew-hit-target menu-item" bindtap="onMenuTap" data-index="{{index}}" aria-label="{{item.title}}"><ui-icon name="{{item.icon}}" tone="muted" size="20" /><text class="menu-title">{{item.title}}</text><ui-icon name="chevron-right" tone="muted" size="16" /></button></view></view>
  <button wx:if="{{isAdmin}}" class="ew-hit-target menu-item admin-entry" bindtap="onAdminWorkbench"><ui-icon name="settings" tone="muted" size="22" /><text class="menu-title">管理工作台</text><ui-icon name="chevron-right" tone="muted" size="16" /></button>
  <button class="ew-hit-target version-info" bindtap="onVersionTap"><text class="version-text">吃什么 {{productVersion}} · 本机体验</text></button>
  <ui-sheet visible="{{showLoginModal}}" title="登录吃什么" busy="{{loginBusy}}" bind:close="onCloseLoginModal"><text class="ew-reading">登录后保存你的餐单、购物清单与实际用餐记录。</text><text wx:if="{{loginError}}" class="ew-error">{{loginError}}</text><button slot="footer" disabled="{{loginBusy}}" loading="{{loginBusy}}" class="ew-hit-target ew-button" bindtap="onWxLogin">微信一键登录</button><button class="ew-hit-target ew-link" disabled="{{loginBusy}}" bindtap="onCloseLoginModal">暂不登录</button></ui-sheet>
</view>
