.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; } .notice { padding: 14rpx 16rpx; margin-bottom: 14rpx; color: #176a47; background: #e3f3eb; border-radius: 8rpx; font-size: 24rpx; } .state { min-height: 300rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6d7772; gap: 20rpx; } .state.compact { min-height: 180rpx; }
.summary { padding: 22rpx; background: #fff; border: 2rpx solid #e1e7e3; border-radius: 12rpx; } .summary-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; } .name { display: block; font-size: 34rpx; font-weight: 700; word-break: break-word; } .meta { display: block; margin-top: 8rpx; color: #6d7772; font-size: 23rpx; word-break: break-word; } .badge { padding: 6rpx 11rpx; border-radius: 7rpx; font-size: 21rpx; } .badge.on { color: #176a47; background: #e3f3eb; } .badge.off { color: #8b5517; background: #fff0d8; } .status { width: 100%; margin-top: 20rpx; min-height: 70rpx; border: 2rpx solid #d7e2dc; background: #f4faf6; color: #237a55; border-radius: 9rpx; font-size: 24rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin: 28rpx 0 14rpx; } .section-title, .form-title { font-size: 30rpx; font-weight: 700; } .add { min-width: 104rpx; min-height: 66rpx; margin: 0; background: #237a55; color: #fff; border-radius: 9rpx; font-size: 24rpx; } .list { display: flex; flex-direction: column; gap: 12rpx; } .dish { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14rpx; padding: 20rpx; background: #fff; border: 2rpx solid #e1e7e3; border-radius: 12rpx; } .dish-main { min-width: 0; } .dish-name { font-size: 29rpx; font-weight: 650; } .ingredients { display: block; margin-top: 9rpx; color: #46524b; font-size: 23rpx; line-height: 1.5; word-break: break-word; } .actions { display: flex; flex-direction: column; gap: 8rpx; } .actions button { min-width: 88rpx; min-height: 58rpx; margin: 0; padding: 0 10rpx; border-radius: 8rpx; background: #eef4f0; color: #237a55; font-size: 22rpx; } .actions .danger { color: #a13b36; background: #fff0ef; }
.form { padding-bottom: 30rpx; } .form-title { display: block; margin-bottom: 22rpx; } .label { display: block; margin: 20rpx 0 9rpx; color: #47544d; font-size: 24rpx; font-weight: 600; } .form input, .form textarea { width: 100%; min-height: 80rpx; padding: 17rpx; box-sizing: border-box; background: #fff; border: 2rpx solid #dce4df; border-radius: 10rpx; font-size: 26rpx; } .form textarea { min-height: 160rpx; line-height: 1.5; } .types { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8rpx; } .types button { min-width: 0; min-height: 68rpx; margin: 0; padding: 0; background: #fff; border: 2rpx solid #dce4df; border-radius: 8rpx; font-size: 21rpx; } .types button.selected { color: #fff; background: #237a55; border-color: #237a55; } .form-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 28rpx; } .form-actions button, .primary { min-height: 82rpx; margin: 0; border-radius: 10rpx; font-size: 26rpx; } .form-actions button { background: #fff; color: #46524b; } .form-actions .primary, .primary { background: #237a55; color: #fff; }
