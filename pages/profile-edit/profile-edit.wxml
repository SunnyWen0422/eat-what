<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px"><view class="ew-heading">个人资料</view><view class="ew-card"><button aria-label="选择个人头像" class="ew-hit-target avatar-btn" open-type="chooseAvatar" disabled="{{busy}}" bindchooseavatar="onChooseAvatar"><image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" class="avatar-img" mode="aspectFill" binderror="onAvatarError" /><view wx:else class="avatar-placeholder">我</view></button><view class="ew-muted avatar-tip">更换头像</view><view class="ew-field"><view class="ew-label">昵称</view><input aria-label="昵称" class="ew-input" type="nickname" maxlength="64" value="{{nickname}}" bindinput="onNicknameInput" disabled="{{busy}}" /></view><view wx:if="{{errorMessage}}" class="ew-error">{{errorMessage}}</view><view class="ew-actions"><ui-button label="取消" variant="secondary" disabled="{{busy}}" bind:action="onCancel" /><ui-button label="保存资料" loading="{{busy}}" bind:action="onSave" /></view></view></view>
