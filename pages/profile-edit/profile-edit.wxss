.page { min-height: 100vh; background: #F7F8FA; }

/* 头像区 */
.avatar-section {
  background: linear-gradient(150deg, #2BA471 0%, #1A7A4C 60%, #0D5C35 100%);
  padding: 60rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-btn {
  position: relative; width: 160rpx; height: 160rpx;
  padding: 0; margin: 0; background: transparent; border: none;
  display: flex; align-items: center; justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.2);
  position: absolute;
}
.avatar-badge {
  position: absolute; bottom: 10rpx; right: 10rpx;
  width: 44rpx; height: 44rpx; background: #fff;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  z-index: 2;
}
.avatar-hint { color: rgba(255,255,255,0.7); font-size: 24rpx; margin-top: 20rpx; }

/* 信息卡片 */
.info-card {
  margin: 24rpx 20rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  overflow: hidden;
}
.info-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 30rpx; color: #333; font-weight: 500; flex-shrink: 0; width: 120rpx; }
.info-value { font-size: 28rpx; color: #222; text-align: right; flex: 1; }
.info-value.muted { color: #999; }

/* 微信昵称输入框 */
.nick-input {
  flex: 1; text-align: right;
  font-size: 28rpx; color: #222;
  height: 50rpx; padding: 0;
}

/* 底部提示 */
.tip { text-align: center; padding: 30rpx; color: #ccc; font-size: 24rpx; }
