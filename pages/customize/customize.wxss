/* pages/customize/customize.wxss */
.customize-container {
  display: flex;
  flex-direction: row;
  height: 100vh;
}

.sidebar {
  width: 80px;
  background-color: #f5f5f5;
  padding-top: 20px;
}

.tab-item {
  padding: 20px 0;
  text-align: center;
  font-size: 14px;
  color: #666;
  border-left: 3px solid transparent;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #fff;
  border-left-color: #07c160;
  color: #07c160;
  font-weight: bold;
}

.content-area {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
}

.content-section {
  min-height: 100%;
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 20px;
  color: #333;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.add-btn {
  background-color: #07c160;
  color: #fff;
}

.people-selector {
  margin-top: 40px;
}

.hint {
  display: block;
  margin-top: 12px;
  font-size: 12px;
  color: #999;
}

.search-box {
  margin-bottom: 20px;
}

.search-input {
  width: 100%;
  padding: 12px;
  background-color: #f5f5f5;
  border-radius: 8px;
  font-size: 14px;
}

.dish-scroll {
  max-height: calc(100vh - 300px);
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.dish-item {
  padding: 16px;
  background-color: #f9f9f9;
  border-radius: 8px;
  border: 1px solid #e5e5e5;
  transition: all 0.3s;
  position: relative;
}

.dish-item:active {
  background-color: #e8f5e9;
  border-color: #07c160;
}

.dish-item.dish-selected {
  background-color: #e8f5e9;
  border-color: #07c160;
}

.check-mark {
  position: absolute;
  top: 8px;
  right: 12px;
  color: #07c160;
  font-size: 20px;
  font-weight: bold;
}

.dish-name {
  display: block;
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 8px;
}

.dish-tags {
  display: block;
  font-size: 12px;
  color: #999;
}

.custom-dish-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.custom-dish-item {
  padding: 16px;
  background-color: #fff;
  border-radius: 8px;
  border: 1px solid #e5e5e5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-type {
  display: inline-block;
  padding: 2px 8px;
  background-color: #07c160;
  color: #fff;
  border-radius: 4px;
  font-size: 12px;
  margin-left: 8px;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px;
  background-color: #fff;
  border-top: 1px solid #e5e5e5;
  display: flex;
  gap: 12px;
}

.bottom-actions button {
  flex: 1;
}

.param-item {
  margin-bottom: 16px;
}

.meal-type {
  display: flex;
  gap: 16px;
}

.meal-type label {
  display: flex;
  align-items: center;
}

.selected-count {
  padding: 8px 12px;
  background: #e8f5e9;
  border-radius: 6px;
  margin-bottom: 12px;
  text-align: center;
  color: #07c160;
  font-size: 14px;
  font-weight: bold;
}

