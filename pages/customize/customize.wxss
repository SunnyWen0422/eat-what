.recipe-page-header .ew-heading { margin:0; min-width:0; }
.page .search-wrap { padding:0; margin:4px 0 0; }
.page .search-input { font-size:1em; min-height:44px; height:44px; padding:8px 12px; border-color:#D9E1D5; }
.ew-page button.browse-filter-command { display:flex; justify-content:space-between; align-items:center; width:100%; min-height:44px; padding:0; margin:0; border:0; background:transparent; border-radius:0; font-size:0.8125em; line-height:1.5; color:#25332B; }
.browse-filter-command::after { border:0; }
.browse-filter-caption { display:flex; align-items:center; gap:6px; font-weight:500; }
.browse-filter-command .browse-filter-arrow { flex:0 0 auto; margin-left:16px; color:#56645B; font-size:.9230769em; font-weight:400; }
