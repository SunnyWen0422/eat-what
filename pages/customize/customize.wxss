.page .recipe-sources button { flex:1 1 0; min-width:0; min-height:44px; padding:8px 4px; font-size:0.8125em; border:0; border-radius:10px; }
.page .recipe-sources button::after { border:0; }
.recipe-catalog { flex:1; display:flex; align-items:stretch; gap:10px; min-height:0; min-width:0; }
.recipe-catalog .category-scroll { flex:0 0 56px; width:56px; max-width:56px; height:100%; min-height:0; border:0; background:transparent; white-space:normal; }
.recipe-catalog .sidebar { display:flex; flex-direction:column; width:100%; min-width:0; height:auto; gap:4px; padding:4px 0 12px; }
.page .recipe-catalog .sidebar-item { display:flex; align-items:center; justify-content:center; width:100%; min-width:44px; min-height:48px; padding:8px 4px; border:0; border-left:3px solid transparent; border-radius:10px; background:transparent; color:#56645B; font-size:0.8125em; line-height:1.5; font-weight:400; }
.page .recipe-catalog .sidebar-active { border-left-color:#28634E; background:#EDF3ED; color:#28634E; font-weight:500; }
.recipe-catalog .recipe-browse-scroll { flex:1; width:0; min-width:0; height:100%; min-height:0; }
.recipe-catalog .dish-list-content { padding:0 0 16px; }
.recipe-catalog .recipe-item { margin:0; }
.recipe-catalog.is-editing { display:flex; }
.recipe-catalog.is-editing .recipe-browse-scroll { width:100%; }
.page .personal-recipe-entry { padding-bottom:6px; font-size:0.8125em; }
.page .personal-recipe-entry .ew-muted { font-size:inherit; }
.ew-page .personal-recipe-entry button { min-height:44px; padding:6px 8px; font-size:inherit; }
.page .browse-filter-panel { margin:0; padding:0; background:transparent; }
.browse-filter-group { padding:8px 0 12px; margin:0; border-bottom:1px solid #B8C5B8; }
.page .browse-filter-label { margin:0 0 4px; color:#56645B; font-size:0.8125em; line-height:1.5; font-weight:500; }
.page .browse-filter-options { width:100%; white-space:normal; }
.page .browse-active-filters { gap:2px 6px; padding:0; }
.ew-page button.browse-active-chip { padding:5px 8px; min-height:44px; font-size:0.8125em; }
.ew-page .common-menu-summary .ew-title { font-weight:500; }
.ew-page button.menu-target-context { display:flex; justify-content:space-between; background:transparent; padding:10px 0; border:0; border-bottom:1px solid #B8C5B8; border-radius:0; font-size:0.8125em; }
.ew-page .personal-recipe-entry button, .ew-page .custom-form button.custom-form-secondary { background:transparent; }

/* Reusable menus: pick dishes, name the combination, then save once. */
.menu-edit-context { flex:0 0 auto; display:flex; align-items:center; justify-content:space-between; gap:8px; min-width:0; padding:0 10px; margin:0 0 8px; border-radius:10px; background:#EDF3ED; color:#28634E; font-size:0.8125em; }
.menu-edit-context > text { min-width:0; font-weight:500; }
.ew-page .menu-edit-context button, .ew-page .common-menu-meta button, .ew-page .menu-reload { flex:0 0 auto; width:auto; min-height:44px; padding:6px 4px; margin:0; border:0; border-radius:0; background:transparent; color:#28634E; font-size:inherit; line-height:1.5; }
.ew-page .menu-edit-context button::after, .ew-page .common-menu-meta button::after, .ew-page .menu-reload::after { border:0; }
.ew-page .bottom-bar .selected-wrap { flex:1 1 0; padding:4px 0; background:transparent; border:0; border-radius:0; gap:4px; }
.bottom-bar .selected-num { font-size:0.8125em; font-weight:500; }
.ew-page .bottom-bar button.menu-next { flex:0 0 auto; width:auto; min-width:88px; min-height:44px; padding:10px 16px; margin:0; border:0; border-radius:12px; background:#28634E; color:#FFFFFF; font-size:0.8125em; line-height:1.5; }
.menu-next::after { border:0; }
.ew-page .bottom-bar button.menu-next[disabled], .ew-page button.menu-use-primary[disabled] { color:#56645B; background:#F5F6F0; }
.common-menu-meta { display:flex; justify-content:space-between; align-items:center; gap:12px; min-width:0; color:#56645B; font-size:0.8125em; }
.common-menu-meta > text { min-width:0; }
.ew-page button.menu-create { display:flex; align-items:center; justify-content:center; gap:8px; }
.common-menu-form { padding:0; }
.menu-field { padding:8px 0 12px; }
.menu-field-label { display:block; margin:0 0 6px; color:#56645B; font-size:0.8125em; line-height:1.5; font-weight:400; }
.menu-field .ew-input { height:44px; min-height:44px; line-height:44px; font-size:1em; padding:0 12px; border-color:#D9E1D5; border-radius:12px; }
.menu-people-field { display:flex; align-items:center; gap:8px; border-bottom:1px solid #B8C5B8; }
.menu-people-field .menu-field-label { flex:1; margin:0; }
.menu-people-field .ew-input { width:76px; flex:0 0 76px; text-align:center; }
.menu-people-field > text:last-child { font-size:0.8125em; color:#56645B; }
.common-menu-form .common-menu-edit-row { padding:10px 0; }
.common-menu-form .common-menu-edit-row .ew-title { font-size:1em; font-weight:500; }
.menu-form-actions { display:flex; flex-wrap:wrap; gap:8px; }
.menu-form-actions .menu-use-primary { flex:1 1 160px; }
.ew-page .menu-save-as { flex:1 1 120px; min-height:48px; padding:10px 12px; margin:0; border:0; border-radius:12px; background:#EDF3ED; color:#28634E; font-size:0.8125em; line-height:1.5; }
.menu-save-as::after { border:0; }
.ew-page .menu-reload { font-size:0.8125em; text-align:left; white-space:normal; }

/* Search shares the title row; live search and clear keep their original handlers. */
.page .recipe-page-header { display:flex; align-items:center; flex-wrap:nowrap; gap:12px; margin:0 0 4px; }
.recipe-search { flex:1; min-width:0; display:flex; align-items:center; gap:8px; padding:0 10px; min-height:44px; border:1px solid #D9E1D5; border-radius:14px; background:#FFFFFF; box-sizing:border-box; }
.recipe-search > ui-icon { flex:0 0 18px; display:flex; align-items:center; }
.page .recipe-search .search-input { flex:1; width:0; min-width:0; min-height:44px; height:44px; padding:0; margin:0; border:0; border-radius:0; background:transparent; font-size:0.8125em; line-height:1.5; }
.page button.recipe-search-clear { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; min-height:44px; height:44px; line-height:1.5; margin:0 -8px 0 0; padding:0; border:0; background:transparent; }
.recipe-search-clear::after { border:0; }
