/* pages/customize/customize.wxss */

.page {
  display: flex;
  flex-direction: row;
  height: 100vh;
  background: #f5f5f5;
}

/* ===== 左侧竖边栏 ===== */
.sidebar {
  width: 80px;
  background: #fff;
  border-right: 1px solid #e5e5e5;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.sidebar-item {
  padding: 20px 0;
  text-align: center;
  font-size: 16px;
  color: #666;
  border-left: 3px solid transparent;
  transition: all 0.2s;
}

.sidebar-active {
  background: #E8F5E9;
  color: #2BA471;
  font-weight: bold;
  border-left-color: #2BA471;
}

.custom-btn {
  margin-top: auto;
  color: #2BA471;
  border-top: 1px solid #e5e5e5;
}

.custom-btn sidebar-active {
  color: #fff;
  background: #1A7A4C;
}

/* ===== 右侧内容区 ===== */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100vh;
}

/* 搜索框 */
.search-wrap {
  padding: 10px 12px;
  background: #fff;
  border-bottom: 1px solid #e5e5e5;
}

.search-input {
  width: 100%;
  height: 36px;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 15px;
  box-sizing: border-box;
}

.hot-tags {
  display: flex; gap: 8px; padding: 10px 0 4px; flex-wrap: wrap;
}
.hot-tag {
  font-size: 22rpx; color: #2BA471; background: #E8F5E9;
  padding: 4rpx 16rpx; border-radius: 12rpx;
  border: 1rpx solid #C8E6C9;
}

.browse-filter-header,
.browse-filter-command {
  display: flex;
  align-items: center;
}
.browse-filter-header { justify-content: space-between; margin-top: 10px; }
.browse-filter-command { gap: 8px; color: #25322c; font-size: 13px; font-weight: 600; }
.browse-filter-arrow,
.browse-filter-clear { color: #16865f; font-size: 12px; font-weight: 400; }
.browse-filter-summary { display: block; margin-top: 6px; color: #5d6862; font-size: 11px; line-height: 1.5; }
.browse-filter-panel { margin-top: 10px; padding-top: 8px; border-top: 1px solid #edf0ee; }
.browse-filter-group { margin-bottom: 9px; }
.browse-filter-label { display: block; margin-bottom: 5px; color: #6b756f; font-size: 11px; }
.browse-filter-options { width: 100%; white-space: nowrap; }
.browse-filter-option {
  display: inline-flex;
  align-items: center;
  height: 28px;
  margin-right: 6px;
  padding: 0 9px;
  border: 1px solid #d8dfdb;
  border-radius: 5px;
  background: #fff;
  color: #53605a;
  font-size: 11px;
  box-sizing: border-box;
}
.browse-filter-option.selected { border-color: #16865f; background: #e8f5ef; color: #126947; font-weight: 600; }
.browse-filter-count { margin-left: 4px; color: #87928c; font-size: 10px; }

/* 菜品列表 */
.dish-list {
  flex: 1;
  padding: 10px 12px;
  box-sizing: border-box;
  /* scroll-view 必须设置高度才能滚动 */
  height: calc(100vh - 56px - 56px);
}

.tip-text {
  text-align: center;
  color: #999;
  font-size: 15px;
  margin-top: 40px;
}

/* 每行菜品 */
.dish-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 10px;
  padding: 14px 12px;
  margin-bottom: 8px;
  border: 2px solid transparent;
  transition: border-color 0.2s, background-color 0.2s;
}

.dish-selected {
  border-color: #07c160;
  background: #f0faf3;
}

/* 勾选圆圈 */
.check-wrap {
  flex-shrink: 0;
  padding: 4px;
  margin-right: 10px;
}

.check-circle {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.check-circle.checked {
  background: #1A7A4C;
  border-color: #07c160;
}

.check-tick {
  color: #fff;
  font-size: 14px;
  font-weight: bold;
}

/* 菜名 */
.name-wrap {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 17px;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid #e5e5e5;
}

.selected-wrap {
  display: flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 20px;
  background: #f0faf3;
}

.selected-num {
  font-size: 15px;
  color: #2BA471;
  font-weight: bold;
}

.selected-arrow {
  display: inline-block;
  margin-left: 4px;
  font-size: 18px;
  color: #2BA471;
  transition: transform 0.3s;
  transform: rotate(90deg);
}

.selected-arrow.arrow-up {
  transform: rotate(-90deg);
}

.save-btn {
  background: #1A7A4C;
  color: #fff;
  font-size: 15px;
  border-radius: 8px;
  padding: 0 16px;
  height: 36px;
  line-height: 36px;
  min-width: 0;
  width: auto;
}

/* ===== 遮罩层 ===== */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 99;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.mask-show {
  opacity: 1;
  visibility: visible;
}

/* ===== 已选菜品弹出面板 ===== */
.selected-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60vh;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-show {
  transform: translateY(0);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 12px;
  border-bottom: 1px solid #f0f0f0;
}

.panel-title {
  font-size: 17px;
  font-weight: bold;
  color: #333;
}

.panel-close {
  font-size: 22px;
  color: #999;
  padding: 4px 8px;
}

.panel-list {
  flex: 1;
  padding: 0 16px;
  box-sizing: border-box;
}

.panel-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid #f5f5f5;
}

.panel-item-name {
  font-size: 16px;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-item-remove {
  font-size: 14px;
  color: #f56c6c;
  padding: 4px 8px;
  flex-shrink: 0;
}

.panel-empty {
  text-align: center;
  color: #999;
  font-size: 15px;
  margin-top: 40px;
}

.panel-footer {
  padding: 12px 16px;
  border-top: 1px solid #f0f0f0;
}

.panel-clear {
  background: #fff;
  color: #f56c6c;
  font-size: 15px;
  border: 1px solid #f56c6c;
  border-radius: 8px;
  height: 36px;
  line-height: 36px;
}

/* ===== 定制菜品表单 ===== */
.custom-form {
  flex: 1;
  padding: 16px;
  background: #fff;
  overflow-y: auto;
}

.form-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 16px;
}

.form-input {
  width: 100%;
  height: 44px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 16px;
  box-sizing: border-box;
  margin-bottom: 12px;
}

.type-row {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.type-label {
  font-size: 14px;
  color: #666;
  margin-right: 8px;
}

.type-options {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.type-opt {
  padding: 4px 12px;
  border: 1px solid #ddd;
  border-radius: 14px;
  font-size: 13px;
  color: #666;
}

.opt-active {
  background: #1A7A4C;
  color: #fff;
  border-color: #07c160;
}

.form-textarea {
  width: 100%;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 15px;
  box-sizing: border-box;
  margin-bottom: 12px;
  min-height: 80px;
}

.save-custom-btn {
  background: #1A7A4C;
  color: #fff;
  font-size: 16px;
  border-radius: 8px;
  height: 44px;
  line-height: 44px;
  margin-top: 8px;
}

.selector-input { color: #4c5852; }
.custom-tag-title { margin: 10px 0 8px; color: #5d6862; font-size: 13px; }
.custom-tag-grid { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
.custom-tag { padding: 7px 9px; border: 1px solid #d8dfdb; border-radius: 5px; background: #fff; color: #65716b; font-size: 12px; }
.custom-tag.selected { border-color: #16865f; background: #e8f5ef; color: #126947; font-weight: 600; }
