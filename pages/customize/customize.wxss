/* pages/customize/customize.wxss */

.page {
  display: flex;
  flex-direction: row;
  height: 100vh;
  background: #f5f5f5;
}

/* ===== 左侧竖边栏 ===== */
.sidebar {
  width: 80px;
  background: #fff;
  border-right: 1px solid #e5e5e5;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.sidebar-item {
  padding: 20px 0;
  text-align: center;
  font-size: 16px;
  color: #666;
  border-left: 3px solid transparent;
  transition: all 0.2s;
}

.sidebar-active {
  background: #f0faf3;
  color: #07c160;
  font-weight: bold;
  border-left-color: #07c160;
}

/* ===== 右侧内容区 ===== */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100vh;
}

/* 搜索框 */
.search-wrap {
  padding: 10px 12px;
  background: #fff;
  border-bottom: 1px solid #e5e5e5;
}

.search-input {
  width: 100%;
  height: 36px;
  background: #f5f5f5;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 15px;
  box-sizing: border-box;
}

/* 菜品列表 */
.dish-list {
  flex: 1;
  padding: 10px 12px;
  box-sizing: border-box;
  /* scroll-view 必须设置高度才能滚动 */
  height: calc(100vh - 56px - 56px);
}

.tip-text {
  text-align: center;
  color: #999;
  font-size: 15px;
  margin-top: 40px;
}

/* 每行菜品 */
.dish-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 10px;
  padding: 14px 12px;
  margin-bottom: 8px;
  border: 2px solid transparent;
  transition: border-color 0.2s, background-color 0.2s;
}

.dish-selected {
  border-color: #07c160;
  background: #f0faf3;
}

/* 勾选圆圈 */
.check-wrap {
  flex-shrink: 0;
  padding: 4px;
  margin-right: 10px;
}

.check-circle {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.check-circle.checked {
  background: #07c160;
  border-color: #07c160;
}

.check-tick {
  color: #fff;
  font-size: 14px;
  font-weight: bold;
}

/* 菜名 */
.name-wrap {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 17px;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid #e5e5e5;
}

.selected-wrap {
  display: flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 20px;
  background: #f0faf3;
}

.selected-num {
  font-size: 15px;
  color: #07c160;
  font-weight: bold;
}

.selected-arrow {
  display: inline-block;
  margin-left: 4px;
  font-size: 18px;
  color: #07c160;
  transition: transform 0.3s;
  transform: rotate(90deg);
}

.selected-arrow.arrow-up {
  transform: rotate(-90deg);
}

.save-btn {
  background: #07c160;
  color: #fff;
  font-size: 15px;
  border-radius: 8px;
  padding: 0 16px;
  height: 36px;
  line-height: 36px;
  min-width: 0;
  width: auto;
}

/* ===== 遮罩层 ===== */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 99;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.mask-show {
  opacity: 1;
  visibility: visible;
}

/* ===== 已选菜品弹出面板 ===== */
.selected-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60vh;
  background: #fff;
  border-radius: 16px 16px 0 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-show {
  transform: translateY(0);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 12px;
  border-bottom: 1px solid #f0f0f0;
}

.panel-title {
  font-size: 17px;
  font-weight: bold;
  color: #333;
}

.panel-close {
  font-size: 22px;
  color: #999;
  padding: 4px 8px;
}

.panel-list {
  flex: 1;
  padding: 0 16px;
  box-sizing: border-box;
}

.panel-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid #f5f5f5;
}

.panel-item-name {
  font-size: 16px;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-item-remove {
  font-size: 14px;
  color: #f56c6c;
  padding: 4px 8px;
  flex-shrink: 0;
}

.panel-empty {
  text-align: center;
  color: #999;
  font-size: 15px;
  margin-top: 40px;
}

.panel-footer {
  padding: 12px 16px;
  border-top: 1px solid #f0f0f0;
}

.panel-clear {
  background: #fff;
  color: #f56c6c;
  font-size: 15px;
  border: 1px solid #f56c6c;
  border-radius: 8px;
  height: 36px;
  line-height: 36px;
}
