<!--pages/customize/customize.wxml-->
<view class="ew-page page mobile-screen" style="font-size:{{fontBase * fontScale}}px">

  <view class="recipe-page-header"><view class="ew-heading">菜谱</view><button class="ew-hit-target ew-link" bindtap="onOpenMenus">我的菜单</button><button class="ew-hit-target ew-link" bindtap="onToggleSelectionMode">{{selectionMode ? '完成选菜' : '选菜搭一餐'}}</button></view>
  <view wx:if="{{selectionMode}}" class="recipe-target">正在选菜 · {{selectionTargetLabel}}</view>
  <!-- 分类独立横向滚动，末项始终可以滑到 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="false" scroll-into-view="category-{{activeTab}}" scroll-with-animation>
  <view class="sidebar">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      id="category-{{item}}"
      class="ew-hit-target sidebar-item {{activeTab === item ? 'sidebar-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTabChange"
    >
      <text>{{tabNames[item]}}</text>
    </view>
    <view
      id="category-custom"
      class="ew-hit-target sidebar-item custom-btn {{activeTab === 'custom' ? 'sidebar-active' : ''}}"
      data-tab="custom"
      bindtap="onTabChange"
    >
      <text>添加私房菜</text>
    </view>
  </view>
  </scroll-view>

  <!-- 右侧内容区 -->
  <view class="content">

    <!-- 定制菜品表单 -->
    <scroll-view class="custom-form mobile-scroll" scroll-y enhanced wx:if="{{showCustomForm}}">
      <view class="custom-form-content">
      <view class="form-title">添加我的私房菜</view>
      <input placeholder-class="ew-placeholder" class="form-input" placeholder="菜品名称" value="{{customForm.name}}" data-field="name" disabled="{{savingCustom || customPending}}" bindinput="onCustomInput" />

      <view class="type-row">
        <text class="type-label">分类：</text>
        <view class="ew-hit-target type-options" wx:for="{{['meat','veg','soup','staple','dessert']}}" wx:key="*this" data-type="{{item}}" bindtap="onCustomTypeChange">
          <text class="type-opt {{customForm.type === item ? 'opt-active' : ''}}">{{tabNames[item]}}</text>
        </view>
      </view>

      <picker class="ew-hit-target" mode="selector" range="{{cuisineOptions}}" range-key="label" bindchange="onCustomCuisineChange">
        <view class="form-input selector-input">菜系：{{customForm.cuisineLabel}}</view>
      </picker>

      <view class="custom-tag-title">推荐标签</view>
      <view class="custom-tag-grid">
        <view class="ew-hit-target custom-tag {{item.selected ? 'selected' : ''}}" wx:for="{{customTagOptions}}" wx:key="code" data-code="{{item.code}}" bindtap="onCustomTagTap">{{item.label}}</view>
      </view>

      <input placeholder-class="ew-placeholder" class="form-input" type="number" maxlength="3" placeholder="烹饪时长（分钟，可选）" value="{{customForm.cookMinutes}}" data-field="cookMinutes" disabled="{{savingCustom || customPending}}" bindinput="onCustomInput" />

      <textarea placeholder-class="ew-placeholder" class="form-textarea" placeholder="食材用料（每行一个）" value="{{customForm.ingredients}}" data-field="ingredients" disabled="{{savingCustom || customPending}}" bindinput="onCustomInput" rows="4" />
      <textarea placeholder-class="ew-placeholder" class="form-textarea" placeholder="烹饪步骤（每行一步）" value="{{customForm.steps}}" data-field="steps" disabled="{{savingCustom || customPending}}" bindinput="onCustomInput" rows="6" />
      <view wx:if="{{customPending}}" class="ew-notice">上次保存结果未确认，重试会使用原内容。</view><view wx:if="{{customError}}" class="ew-error">{{customError}}</view><button class="ew-hit-target save-custom-btn" loading="{{savingCustom}}" disabled="{{savingCustom}}" bindtap="onSaveCustomDish">保存菜品</button><button class="ew-hit-target ew-link" disabled="{{savingCustom}}" bindtap="onCancelCustom">取消编辑，保留输入</button>
      </view>
    </scroll-view>

    <!-- 搜索框 -->
    <view class="search-wrap" wx:if="{{!showCustomForm}}">
      <input placeholder-class="ew-placeholder" class="search-input" placeholder="搜索菜品..." value="{{searchKeyword}}" bindinput="onSearchInput" />
      <view class="hot-tags" wx:if="{{!searchKeyword}}">
        <text class="ew-hit-target hot-tag" bindtap="onQuickSearch" data-kw="红烧">红烧</text>
        <text class="ew-hit-target hot-tag" bindtap="onQuickSearch" data-kw="清蒸">清蒸</text>
        <text class="ew-hit-target hot-tag" bindtap="onQuickSearch" data-kw="糖醋">糖醋</text>
        <text class="ew-hit-target hot-tag" bindtap="onQuickSearch" data-kw="麻辣">麻辣</text>
        <text class="ew-hit-target hot-tag" bindtap="onQuickSearch" data-kw="凉拌">凉拌</text>
      </view>
      <view class="browse-filter-header">
        <view class="ew-hit-target browse-filter-command" bindtap="onToggleBrowseFilters">
          <text>筛选{{browseFilterCount > 0 ? ' (' + browseFilterCount + ')' : ''}}</text>
          <text class="browse-filter-arrow">{{showBrowseFilters ? '收起' : '展开'}}</text>
        </view>
        <text class="ew-hit-target browse-filter-clear" wx:if="{{browseFilterCount > 0}}" bindtap="onClearBrowseFilters">清除</text>
      </view>
    </view>

    <!-- 展开的筛选与菜品共用纵向滚动区，避免短屏被筛选挤满 -->
    <scroll-view
      class="dish-list mobile-scroll"
      scroll-y
      enhanced
      bindscrolltolower="onScrollToLower"
      wx:if="{{!showCustomForm}}"
    >
      <view class="dish-list-content">
      <text class="browse-filter-summary" wx:if="{{browseFilterSummary}}">当前：{{browseFilterSummary}}</text>
      <ui-state wx:if="{{loading}}" kind="loading" title="正在读取菜品" /><ui-state wx:elif="{{browseError}}" kind="error" title="读取失败" description="{{browseError}}" action-label="重试" bind:action="onRetryPage" />

      <view wx:for="{{currentDishes}}" wx:key="id" class="recipe-item">
        <dish-card dish="{{item}}" mode="{{selectionMode ? 'select' : 'browse'}}" selected="{{item.isSelected}}" disabled="{{savingPlan}}" data-dish="{{item}}" bind:open="onTapDish" bind:select="onToggleSelect" />
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{loadingMore}}" class="tip-text">加载更多...</view>
      <view wx:if="{{!hasMore && currentDishes.length > 0}}" class="tip-text">
        没有更多了
      </view>

      <view wx:if="{{!loading && !loadingMore && !browseError && currentDishes.length === 0}}" class="tip-text">
        {{searchKeyword || browseFilterCount ? '没有符合搜索或筛选的菜品' : '这个分类暂时没有菜品'}}
      </view>
      </view>
    </scroll-view>

    <view wx:if="{{saveError}}" class="ew-error">{{saveError}}</view>
    <!-- 底部操作栏 -->
    <view class="bottom-bar" wx:if="{{!showCustomForm && (selectionMode || selectedTotal)}}">
      <view class="ew-hit-target selected-wrap" bindtap="onShowSelected">
        <text class="selected-num">已选 {{selectedTotal}} 道</text>
        <ui-icon class="selected-arrow {{showSelectedPanel ? 'arrow-up' : ''}}" name="chevron-right" tone="muted" size="16" />
      </view>
      <button class="ew-hit-target save-btn" loading="{{savingPlan}}" disabled="{{savingPlan || !selectedTotal}}" bindtap="onSaveToCalendar">加入本餐草稿</button>
      <button class="ew-hit-target ew-link shopping-btn" disabled="{{savingPlan || !selectedTotal}}" bindtap="onAddSelectedToShoppingList">准备食材</button>
    </view>

  </view>

  <ui-sheet visible="{{showBrowseFilters}}" title="本次筛选" bind:close="onToggleBrowseFilters">
      <view class="browse-filter-panel">
        <view class="browse-filter-group" wx:for="{{browseFilterGroups}}" wx:key="key" wx:for-item="group">
          <text class="browse-filter-label">{{group.label}}</text>
          <scroll-view class="browse-filter-options" scroll-x enhanced show-scrollbar="false">
            <view class="ew-hit-target browse-filter-option {{item.selected ? 'selected' : ''}}" wx:for="{{group.items}}" wx:key="code" data-group="{{group.key}}" data-code="{{item.code}}" bindtap="onBrowseOptionTap">
              <text>{{item.label}}</text>
              <text class="browse-filter-count" wx:if="{{item.count}}">{{item.count}}</text>
            </view>
          </scroll-view>
        </view>
        <view class="browse-filter-group">
          <text class="browse-filter-label">时长</text>
          <scroll-view class="browse-filter-options" scroll-x enhanced show-scrollbar="false">
            <view class="ew-hit-target browse-filter-option {{browseCriteria.maxCookMinutes === item.value ? 'selected' : ''}}" wx:for="{{browseDurationOptions}}" wx:key="key" data-value="{{item.key}}" bindtap="onBrowseDurationTap">{{item.label}}</view>
          </scroll-view>
        </view>
      </view>
<ui-button label="清除本次筛选" variant="tertiary" bind:action="onClearBrowseFilters" /><ui-button slot="footer" label="查看筛选结果" bind:action="onToggleBrowseFilters" /></ui-sheet>
  <!-- 已选菜品弹出面板（从底部拉出） -->
  <view wx:if="{{showSelectedPanel}}" class="ew-hit-target panel-mask {{showSelectedPanel ? 'mask-show' : ''}}" bindtap="onHideSelected" />
  <view wx:if="{{showSelectedPanel}}" class="selected-panel {{showSelectedPanel ? 'panel-show' : ''}}">
    <view class="panel-header">
      <text class="panel-title">已选菜品（{{selectedTotal}} 道）</text>
      <ui-icon-button name="close" label="关闭已选菜品" bind:press="onHideSelected" />
    </view>
    <scroll-view class="panel-list mobile-scroll" scroll-y enhanced>
      <view class="panel-list-content">
      <view
        wx:for="{{selectedList}}"
        wx:key="id"
        class="panel-item"
      >
        <text class="panel-item-name">{{item.name}}</text>
        <text
          class="ew-hit-target panel-item-remove"
          data-id="{{item.id}}"
          bindtap="onRemoveSelected"
        >删除</text>
      </view>
      <view wx:if="{{selectedList.length === 0}}" class="panel-empty">
        还没有勾选菜品
      </view>
      </view>
    </scroll-view>
    <view class="panel-footer">
      <button class="ew-hit-target panel-clear" bindtap="onClearSelected">清空全部</button><button class="ew-hit-target ew-link" disabled="{{!selectedTotal}}" bindtap="onOpenMenus">存为菜单</button>
    </view>
  </view>

  <ui-sheet visible="{{showMenus}}" title="我的菜单" bind:close="onCloseMenus">
    <view class="ew-subtitle">把几道菜存成常用组合，使用时先进入本餐草稿，再确认安排。</view>
    <view class="ew-label">使用菜单的日期和餐次</view>
    <picker class="ew-hit-target" mode="date" value="{{menuDate}}" disabled="{{menuBusy}}" bindchange="onMenuDate"><view class="ew-input ew-hit-target">{{menuDate}}</view></picker>
    <picker class="ew-hit-target" range="{{menuMealLabels}}" value="{{menuMealIndex}}" disabled="{{menuBusy}}" bindchange="onMenuMeal"><view class="ew-input ew-hit-target">{{menuMealLabels[menuMealIndex]}}</view></picker>
    <view wx:if="{{menuError}}" class="ew-error">{{menuError}}<button class="ew-hit-target ew-link" disabled="{{menuBusy}}" bindtap="loadMenus">重新读取菜单</button></view>
    <ui-state wx:if="{{menuLoading}}" kind="loading" title="正在读取菜单" />
    <view wx:for="{{menus}}" wx:key="id" class="ew-card">
      <view class="ew-title">{{item.name}}</view><view class="ew-subtitle">{{item.people}} 人 · {{item.dishIds.length}} 道菜</view>
      <view wx:for="{{item.dishes}}" wx:for-item="menuDish" wx:key="id" class="ew-subtitle">{{menuDish.name}}</view>
      <view class="ew-actions"><button class="ew-hit-target ew-link" data-id="{{item.id}}" disabled="{{menuBusy}}" bindtap="onApplyMenu">加入目标餐草稿</button><button class="ew-hit-target ew-link" data-id="{{item.id}}" disabled="{{menuBusy || menuPending}}" bindtap="onEditMenu">编辑组合</button><button class="ew-hit-target ew-link" data-id="{{item.id}}" disabled="{{menuBusy}}" bindtap="onDeleteMenu">删除</button></view>
    </view>
    <ui-state wx:if="{{!menuLoading && !menus.length && !menuError}}" kind="empty" title="还没有常用菜单" description="在菜谱里选择几道菜，再保存成一个组合。" />
    <button class="ew-hit-target ew-link" bindtap="onOpenMenuForm">把已选菜品存为新菜单</button>
    <view wx:if="{{menuFormVisible || menuEditingId || menuPending}}" class="ew-card">
      <view class="ew-title">{{menuEditingId ? '编辑菜单' : '把已选菜品存为菜单'}}</view>
      <view class="ew-label">菜单名称</view><input placeholder-class="ew-placeholder" class="ew-input" value="{{menuName}}" maxlength="100" data-field="menuName" disabled="{{menuBusy || menuPending}}" bindinput="onMenuInput" placeholder="例如：工作日晚餐" />
      <view class="ew-label">默认人数</view><input placeholder-class="ew-placeholder" class="ew-input" type="number" value="{{menuPeople}}" data-field="menuPeople" disabled="{{menuBusy || menuPending}}" bindinput="onMenuInput" />
      <view class="ew-subtitle">已选 {{selectedTotal}} 道。关闭此面板可继续选菜、移除菜品，然后回来保存。</view>
      <view wx:if="{{menuReviewNotice}}" class="ew-notice">{{menuReviewNotice}}</view>
      <view wx:for="{{menuReviewDishes}}" wx:key="id" class="ew-card">
        <view class="ew-title">{{item.name}}{{item.unavailable ? ' · 不可用' : item.changed ? ' · 内容已变化' : ''}}</view>
        <view wx:if="{{!item.unavailable}}" class="ew-subtitle">食材：{{item.reviewIngredients}}</view>
        <view wx:if="{{!item.unavailable}}" class="ew-subtitle">步骤：{{item.reviewSteps}}</view>
      </view>
      <view wx:if="{{menuPending}}" class="ew-notice">上次保存结果未确认，重试将使用原菜单内容。</view>
      <view class="ew-actions"><ui-button label="{{menuPending ? '重试原保存' : '保存菜单'}}" loading="{{menuBusy}}" bind:action="onSaveMenu" /><ui-button wx:if="{{menuEditingId}}" label="另存新菜单" variant="secondary" disabled="{{menuBusy || menuPending}}" bind:action="onNewMenu" /></view>
    </view>
  </ui-sheet>
</view>
