<!--pages/customize/customize.wxml-->
<view class="page">

  <!-- 左侧竖边栏 -->
  <view class="sidebar">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="sidebar-item {{activeTab === item ? 'sidebar-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTabChange"
    >
      <text>{{tabNames[item]}}</text>
    </view>
  </view>

  <!-- 右侧内容区 -->
  <view class="content">

    <!-- 搜索框 -->
    <view class="search-wrap">
      <input
        class="search-input"
        placeholder="搜索菜品..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>

    <!-- 菜品列表 -->
    <scroll-view
      class="dish-list"
      scroll-y
      bindscrolltolower="onScrollToLower"
    >
      <view wx:if="{{loading}}" class="tip-text">加载中...</view>

      <view
        wx:for="{{currentDishes}}"
        wx:key="id"
        class="dish-row {{item.isSelected ? 'dish-selected' : ''}}"
      >
        <!-- 勾选圆圈 -->
        <view class="check-wrap" data-dish="{{item}}" bindtap="onToggleSelect">
          <view class="check-circle {{item.isSelected ? 'checked' : ''}}">
            <text wx:if="{{item.isSelected}}" class="check-tick">✓</text>
          </view>
        </view>

        <!-- 菜名（点击进入详情） -->
        <view class="name-wrap" data-dish="{{item}}" bindtap="onTapDish">
          <text class="dish-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{loadingMore}}" class="tip-text">加载更多...</view>
      <view wx:if="{{!hasMore && currentDishes.length > 0}}" class="tip-text">
        没有更多了
      </view>

      <view wx:if="{{!loading && !loadingMore && currentDishes.length === 0}}" class="tip-text">
        暂无菜品
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <view class="selected-wrap" bindtap="onShowSelected">
        <text class="selected-num">已选 {{selectedTotal}} 道</text>
        <text class="selected-arrow {{showSelectedPanel ? 'arrow-up' : ''}}">›</text>
      </view>
      <button class="save-btn" bindtap="onSaveToCalendar">保存到日历</button>
    </view>

  </view>

  <!-- 已选菜品弹出面板（从底部拉出） -->
  <view class="panel-mask {{showSelectedPanel ? 'mask-show' : ''}}" bindtap="onHideSelected" />
  <view class="selected-panel {{showSelectedPanel ? 'panel-show' : ''}}">
    <view class="panel-header">
      <text class="panel-title">已选菜品（{{selectedTotal}} 道）</text>
      <text class="panel-close" bindtap="onHideSelected">✕</text>
    </view>
    <scroll-view class="panel-list" scroll-y>
      <view
        wx:for="{{selectedList}}"
        wx:key="id"
        class="panel-item"
      >
        <text class="panel-item-name">{{item.name}}</text>
        <text
          class="panel-item-remove"
          data-id="{{item.id}}"
          bindtap="onRemoveSelected"
        >删除</text>
      </view>
      <view wx:if="{{selectedList.length === 0}}" class="panel-empty">
        还没有勾选菜品
      </view>
    </scroll-view>
    <view class="panel-footer">
      <button class="panel-clear" bindtap="onClearSelected">清空全部</button>
    </view>
  </view>

</view>
