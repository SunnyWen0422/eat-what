page { min-height: 100%; background: #f4f6f5; color: #1f2924; }
button::after { border: none; }
.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }
.heading { min-height: 78rpx; display: flex; align-items: baseline; gap: 14rpx; }
.title { font-size: 38rpx; font-weight: 700; }
.count { color: #768078; font-size: 24rpx; }
.search { display: grid; grid-template-columns: minmax(0, 1fr) 112rpx; gap: 10rpx; margin-bottom: 10rpx; }
.search input { min-width: 0; height: 82rpx; padding: 0 18rpx; box-sizing: border-box; background: #fff; border: 2rpx solid #dbe3de; border-radius: 10rpx; font-size: 26rpx; }
.search-btn, .primary, .more { background: #237a55; color: #fff; border-radius: 10rpx; min-height: 82rpx; font-size: 25rpx; }
.clear { width: 100%; min-height: 60rpx; margin: 0 0 12rpx; background: transparent; color: #637068; font-size: 23rpx; }
.notice { padding: 14rpx 16rpx; color: #176a47; background: #e3f3eb; border-radius: 8rpx; font-size: 24rpx; margin-bottom: 14rpx; }
.state { min-height: 300rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6d7772; gap: 20rpx; }
.list { display: flex; flex-direction: column; gap: 12rpx; }
.card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12rpx; align-items: center; padding: 20rpx; background: #fff; border: 2rpx solid #e1e7e3; border-radius: 12rpx; }
.main { min-width: 0; } .row { display: flex; align-items: center; gap: 10rpx; }
.name { font-size: 29rpx; font-weight: 650; word-break: break-word; }
.badge { padding: 5rpx 10rpx; border-radius: 7rpx; font-size: 20rpx; }
.badge.on { color: #176a47; background: #e3f3eb; } .badge.off { color: #8b5517; background: #fff0d8; }
.meta { display: block; margin-top: 7rpx; color: #6d7772; font-size: 22rpx; word-break: break-word; }
.status-btn { min-width: 92rpx; padding: 0 12rpx; min-height: 62rpx; border: 2rpx solid #d6e1db; color: #237a55; background: #f4faf6; border-radius: 8rpx; font-size: 22rpx; }
.more { margin-top: 6rpx; } .end { padding: 24rpx; text-align: center; color: #8a948e; font-size: 22rpx; }
