/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
.filter-page { height: 100%; min-height: 100vh; box-sizing: border-box; background: linear-gradient(180deg,#EDF3ED 0,#FFFFFF 300px); color:#25332B; }
.filter-page .mobile-scroll-content { padding-bottom:calc(108px + env(safe-area-inset-bottom)); }
.offline-tip { margin-bottom:12px; padding:9px 12px; background: #fff5d9; color:#28634E; font-size:0.857143em; border-left: 3px solid #e6b73d; }
.mode-row { display: grid; grid-template-columns: 1fr 1fr; padding:3px; margin-bottom:16px; background: #e9eeeb; border-radius:6px; }
.mode-btn { padding:10px; text-align: center; color:#617066; font-size:1em; }
.mode-btn.active { background: #FFFFFF; color:#28634E; font-weight: 600; border-radius:4px; }
.filter-section { padding:16px 0; border-bottom: 1px solid #e4e8e6; }
.section-title { margin-bottom:12px; font-size:1.142857em; font-weight: 700; }
.option-grid { display: flex; flex-wrap: wrap; gap:9px; }
.option-chip { min-width: 64px; max-width: 100%; box-sizing: border-box; padding:9px 12px; border: 1px solid #d9dfdc; border-radius:6px; background: #FFFFFF; color: #617066; text-align: center; font-size:0.928571em; white-space: normal; word-break: break-word; }
.option-chip.selected { border-color: #28634E; background: #EDF3ED; color:#28634E; font-weight: 600; }
.option-count { margin-left:5px; color:#617066; font-size:0.857143em; }
.ingredient-row { display: flex; gap:8px; }
.ingredient-input { min-width: 0; flex: 1; height: 42px; box-sizing: border-box; padding:0 12px; border: 1px solid #d9dfdc; background: #FFFFFF; border-radius:6px; font-size:1em; }
.add-btn { width: 76px; height: 42px; line-height: 42px; padding:0; background: #EDF3ED; color:#28634E; border-radius:6px; font-size:1em; }
.ingredient-list { display: flex; flex-wrap: wrap; gap:8px; margin-top:10px; }
.ingredient-chip { padding:7px 10px; background: #FFF0ED; color:#28634E; border-radius:5px; font-size:0.857143em; }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: grid; grid-template-columns: 1fr 2fr; gap:10px; padding:10px 16px calc(10px + env(safe-area-inset-bottom)); box-sizing:border-box; background: #FFFFFF; border-top: 1px solid #e1e6e3; }
.clear-btn, .apply-btn { height: 44px; line-height: 44px; border-radius:6px; font-size:1em; }
.clear-btn { background: #eef1ef; color:#25332B; }
.apply-btn { background: #28634E; color: #FFFFFF; font-weight: 600; }

/* 页面共享主题，适用于本页详情、表单和弹层。 */

/* Shared finish for legacy pages; layout and permission-specific states remain local. */
.ew-page { background:#F8F7F2; color:#25332B; }
.ew-page .btn-primary, .ew-page .primary-btn, .ew-page .save-btn, .ew-page .primary-action, .ew-page .generate-btn { background:#28634E; border-radius:24rpx; }
.ew-page .choice-chip, .ew-page .ingredient-chip, .ew-page .count-btn, .ew-page .clear-btn, .ew-page .period-nav, .ew-page .filter-chip { min-height:44px; min-width:44px; box-sizing:border-box; }

/* Input and touch minima remain fixed under small screens/font changes. */
.ew-page button,.ew-page input,.ew-page .count-btn,.ew-page .choice-chip,.ew-page .filter-chip,.ew-page .date-picker{min-height:44px;box-sizing:border-box}
.ew-page .primary-btn,.ew-page .save-btn,.ew-page .primary-action,.ew-page .wx-login-btn{min-height:48px}

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }

.apply-btn { height:48px; min-height:48px; line-height:48px; }

.mode-btn { background:#EDF3ED; }

.offline-tip { color:#75501A; }

button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }
