<view class="statistics-page">
  <!-- 月份选择器 -->
  <view class="month-selector">
    <button class="nav-btn" bindtap="onPrevMonth">‹</button>
    <view class="month-title">{{currentYear}}年 {{currentMonth}}月</view>
    <button class="nav-btn" bindtap="onNextMonth">›</button>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">正在分析您的饮食数据...</text>
  </view>

  <!-- 空数据提示 -->
  <view class="empty-state" wx:elif="{{isEmpty}}">
    <text class="empty-icon">🍽️</text>
    <text class="empty-text">本月暂无饮食记录</text>
    <text class="empty-hint">快去记录你的第一餐吧！</text>
  </view>

  <!-- 月度报告 -->
  <view class="report-container" wx:else>
    <!-- 概览卡片 -->
    <view class="overview-card">
      <view class="overview-title">{{currentMonth}}月饮食报告</view>
      <view class="overview-subtitle">共记录 {{statistics.daysWithRecords}} 天</view>
      <view class="overview-dishes">
        <view class="dish-stat">
          <text class="dish-emoji">🍖</text>
          <text class="dish-count">{{statistics.meatCount}}</text>
          <text class="dish-label">荤菜</text>
        </view>
        <view class="dish-stat">
          <text class="dish-emoji">🥬</text>
          <text class="dish-count">{{statistics.vegCount}}</text>
          <text class="dish-label">素菜</text>
        </view>
        <view class="dish-stat">
          <text class="dish-emoji">🍲</text>
          <text class="dish-count">{{statistics.soupCount}}</text>
          <text class="dish-label">汤品</text>
        </view>
        <view class="dish-stat">
          <text class="dish-emoji">🔥</text>
          <text class="dish-count">{{statistics.dailyCalories}}</text>
          <text class="dish-label">日均热量</text>
        </view>
      </view>
    </view>

    <!-- 热量趋势卡片 -->
    <view class="calories-card">
      <view class="card-title">💡 热量摄入分析</view>
      <view class="calories-bar-section">
        <view class="calories-bar-row">
          <text class="bar-label">日均热量</text>
          <view class="bar-wrapper">
            <view class="bar-fill {{caloriesLevel}}" style="width: {{caloriesPercent}}%;"></view>
          </view>
          <text class="bar-value">{{statistics.dailyCalories}} kcal</text>
        </view>
        <view class="calories-range">
          <text>推荐范围：{{caloriesMin}}-{{caloriesMax}} kcal/天</text>
        </view>
      </view>
      <view class="calories-verdict {{caloriesLevel}}">
        <text>{{caloriesVerdict}}</text>
      </view>
    </view>

    <!-- 荤素比例卡片 -->
    <view class="ratio-card">
      <view class="card-title">🥗 荤素搭配</view>
      <view class="ratio-chart">
        <view class="ratio-item meat">
          <view class="ratio-bar" style="width: {{meatPercent}}%;"></view>
          <text class="ratio-text">荤 {{meatPercent}}%</text>
        </view>
        <view class="ratio-item veg">
          <view class="ratio-bar" style="width: {{vegPercent}}%;"></view>
          <text class="ratio-text">素 {{vegPercent}}%</text>
        </view>
        <view class="ratio-item soup">
          <view class="ratio-bar" style="width: {{soupPercent}}%;"></view>
          <text class="ratio-text">汤 {{soupPercent}}%</text>
        </view>
      </view>
      <view class="ratio-verdict">
        <text>{{ratioVerdict}}</text>
      </view>
    </view>

    <!-- 饮食建议卡片 -->
    <view class="suggestion-card">
      <view class="card-title">💡 健康建议</view>
      <view class="suggestion-list">
        <text class="suggestion-item" wx:for="{{suggestionList}}" wx:key="index">{{index + 1}}. {{item}}</text>
      </view>
    </view>
  </view>
</view>
