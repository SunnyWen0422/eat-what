<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px">
  <text class="ew-heading">饮食回顾</text>

  <view class="ew-tabs">
    <view aria-role="button" class="ew-hit-target ew-pill {{periodMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="onMode">按周</view>
    <view aria-role="button" class="ew-hit-target ew-pill {{periodMode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="onMode">按月</view>
  </view>
  <view class="ew-row ew-between period">
    <button class="ew-hit-target period-nav" bindtap="onPrevMonth" aria-label="上一周期"><ui-icon name="arrow-left" tone="muted" size="20" /></button>
    <text>{{rangeLabel}}</text>
    <button class="ew-hit-target period-nav" bindtap="onNextMonth" aria-label="下一周期"><ui-icon class="rotate-right" name="arrow-left" tone="muted" size="20" /></button>
  </view>
  <ui-state wx:if="{{loading}}" kind="loading" title="正在整理餐次记录" />
  <ui-state wx:elif="{{errorMessage}}" kind="error" title="暂时无法读取回顾" description="{{errorMessage}}" action-label="重新加载" bind:action="loadStatistics" />
  <block wx:elif="{{reportView}}">
    <view wx:if="{{hasActualRecords}}" class="ew-notice">{{coverageNotice}}</view>
    <ui-state wx:if="{{!hasActualRecords}}" kind="empty" title="这一周期还没有用餐记录" description="将菜单保存到日历，即可在这里回顾。" action-label="记录这一餐" bind:action="onRecord" />
    <view wx:if="{{hasActualRecords}}" data-report-block="overview">
      <text class="ew-section-title">用餐概览</text>
      <view class="ew-grid metrics">
        <view class="ew-card"><text class="ew-number">{{reportView.overview.mealCount}}</text><text class="metric-label">已保存的餐次</text></view>
        <view class="ew-card"><text class="ew-number">{{reportView.overview.recordedDays}}</text><text class="metric-label">有餐次记录的天数</text></view>
        <view class="ew-card"><text class="ew-number">{{reportView.overview.uniqueDishCount}}</text><text class="metric-label">已识别菜品种类</text></view>
        <view class="ew-card"><text class="ew-number">{{reportView.overview.entryCount}}</text><text class="metric-label">实际菜品条目</text></view>
      </view>
    </view>
    <view wx:if="{{reportView.overview.mealCount > 0}}" class="ew-card" data-report-block="categoryCounts">
      <text class="ew-section-title">菜品类别次数</text>
      <view class="bar-row" wx:for="{{categoryRows}}" wx:key="key"><text>{{item.label}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item.percent}}%"></view></view><text>{{item.count}} 次</text></view>
      <text class="ew-muted">{{reportView.categoryCounts.classifiedCount}} / {{reportView.categoryCounts.entryCount}} 条实际菜品可识别类别。次数包含未分类条目，不代表营养摄入比例。</text>
    </view>
    <view wx:if="{{hasActualRecords && nutritionReference}}" class="ew-card nutrition-reference">
      <view class="ew-row ew-between"><text class="ew-section-title">菜谱营养参考</text><text class="ew-muted">{{nutritionReference.coverage}}</text></view>
      <text wx:if="{{nutritionReference.available}}" class="ew-muted">{{nutritionReference.label}}</text>
      <view wx:if="{{nutritionReference.available}}" class="nutrition-grid"><view wx:for="{{nutritionReference.rows}}" wx:key="key" class="nutrition-row"><text>{{item.label}}</text><text>{{item.value}} {{item.unit}}</text></view></view>
      <text wx:else class="ew-muted">暂无完整菜谱营养资料</text>
      <text class="ew-muted nutrition-note">{{nutritionReference.note}}</text>
    </view>
    <button class="ew-hit-target ew-link" bindtap="onToggleReviewDetails" aria-expanded="{{showReviewDetails}}">{{showReviewDetails ? '收起记录与依据' : '查看记录、缺失与计算依据'}}</button>
    <block wx:if="{{showReviewDetails}}">
      <view class="ew-card">
        <text class="ew-section-title">餐次记录分布</text>
        <view aria-role="button" class="ew-hit-target bar-row" wx:for="{{dailyRows}}" wx:key="date" data-date="{{item.date}}" bindtap="onRecord">
          <text>{{item.label}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item.width}}%"></view></view><text>{{item.count}} 餐</text>
        </view>
        <text class="ew-muted">条长相对本周期最多记录的一天，仅用于比较次数，不是记录完成率。</text>
      </view>
    <view class="ew-card" data-report-block="actualDetails">
      <text class="ew-section-title">餐次记录明细</text>
      <text wx:if="{{!recordRows.length}}" class="ew-muted">暂无已保存的菜品明细。</text>
      <view aria-role="button" class="ew-hit-target record" wx:for="{{recordRows}}" wx:key="key" data-date="{{item.mealDate}}" data-meal="{{item.mealType}}" bindtap="onRecord">
        <text>{{item.mealDate}} · {{item.label}}</text><text class="ew-muted">{{item.names}}</text><text class="ew-link">查看 / 纠正这一餐 ›</text>
      </view>
    </view>
    <view class="ew-card" data-report-block="frequentDishes">
      <text class="ew-section-title">常用与重复菜品</text>
      <view class="ew-row ew-between ranking" wx:for="{{reportView.frequentDishes.dishes}}" wx:key="dishId"><text>{{item.name}}</text><text class="ew-muted">{{item.count}} 餐出现</text></view>
      <text wx:if="{{!reportView.frequentDishes.dishes.length}}" class="ew-muted">暂无已识别的菜品。自由填写内容仍保留在餐次记录明细中。</text>
      <text class="ew-muted">同一道菜在同一餐只计一次。自由填写的菜名可在用餐明细中查看。</text>
    </view>
    <view class="ew-card" data-report-block="completeness">
      <text class="ew-section-title">记录完整性与缺失</text>
      <view class="record"><text>所选周期截至今天共 {{reportView.completeness.observedDays}} 天，其中 {{reportView.completeness.daysWithoutActualRecord}} 天没有用餐记录。</text><text class="ew-muted">保存即记录；未来菜单到对应日期再计入。</text></view>
      <view class="record"><text>自由填写菜品 {{reportView.completeness.freeTextEntryCount}} 条；未分类 {{reportView.completeness.unclassifiedCount}} 条；已保存但菜品明细缺失 {{reportView.completeness.actualMealsWithoutDishes}} 餐。</text></view>
      <text class="ew-muted">没有可靠的实际食用份量，暂不计算个人热量摄入、营养分数或每日用餐完成率。</text>
      <button class="ew-hit-target ew-link" bindtap="onToggleProvenance">{{showProvenance ? '收起计算说明' : '查看计算说明'}}</button><view wx:if="{{showProvenance}}" class="record report-provenance"><text>按北京时间对应的用餐日期整理。</text><text class="ew-muted">这份回顾根据当前记录即时整理；更正用餐记录后会重新计算。</text></view>
    </view>
    </block>
  </block>
</view>
