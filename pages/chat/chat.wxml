<block wx:if="{{assistantConnected}}">
<view class="connected-assistant ew-dish-surface" style="font-size:{{fontBase * fontScale}}px;padding-bottom:{{keyboardHeight}}px">
 <view class="connected-header"><view><text class="ew-heading">餐桌助手</text></view><button class="ew-hit-target ew-link" bindtap="onConversationHome">{{assistantReturnLabel || '回到今天'}}</button></view>
 <scroll-view class="connected-messages" scroll-y enhanced bindscroll="onConversationScroll" bindscrolltolower="onConversationBottom" scroll-into-view="{{conversationScrollTarget}}">
  <button wx:if="{{conversationHasOlder}}" class="ew-hit-target ew-link" bindtap="onConversationOlder">查看更早的对话</button>
  <button class="ew-hit-target connected-context" bindtap="onToggleConversationMenu" aria-expanded="{{conversationMenuExpanded}}">{{context.date}} · {{mealName}} · {{context.people}}人<text wx:if="{{conversationMenuCount}}"> · {{conversationMenuCount}}道菜 {{conversationMenuExpanded ? '收起' : '查看'}}</text></button>
  <assistant-card wx:if="{{conversationCurrentMenu && conversationMenuExpanded}}" card="{{conversationCurrentMenu}}" active="{{false}}" />
  <view wx:if="{{!conversationMessages.length}}" class="connected-welcome"><text class="ew-title">说说你这一餐的想法</text><view class="connected-shortcuts"><button wx:for="{{conversationSuggestions}}" wx:key="id" class="ew-hit-target connected-shortcut" data-id="{{item.id}}" disabled="{{conversationBusy || conversationRecoverable}}" bindtap="onConversationSuggestion">{{item.label}}</button></view></view>
  <view wx:for="{{conversationMessages}}" wx:key="id" class="connected-message {{item.role === 'user' ? 'connected-user' : ''}}">
   <text wx:if="{{item.text}}" class="connected-bubble" user-select>{{item.text}}</text>
   <assistant-card wx:for="{{item.cards}}" wx:for-item="card" wx:key="id" card="{{card}}" active="{{card.active}}" busy="{{conversationBusy}}" bind:choice="onConversationChoice" bind:handoff="onConversationHandoff" bind:confirm="onConversationConfirm" bind:undo="onConversationUndo" bind:selection="onConversationSelection" bind:repreview="onConversationRepreview" />
  </view>
  <view wx:if="{{conversationBusy}}" class="connected-progress" aria-role="status"><text>{{conversationProgressLabel}}</text><button class="ew-hit-target ew-link" bindtap="onConversationStop">停止</button></view>
  <view id="conversation-end"></view>
 </scroll-view>
 <view class="connected-composer">
  <button wx:if="{{conversationHasNew}}" class="ew-hit-target ew-link" bindtap="onConversationLatest">查看新消息</button>
  <text wx:if="{{conversationActionsEnabled === false && !conversationCapabilityChecking}}" class="ew-muted">助手暂不可用，仍可查看对话记录。</text>
  <view wx:if="{{conversationError}}" class="ew-error" aria-role="alert">{{conversationError}}</view>
  <button wx:if="{{conversationRecoverable}}" class="ew-hit-target ew-link" disabled="{{conversationBusy}}" bindtap="onConversationRecover">恢复刚才的请求</button>
  <button wx:if="{{conversationCanStop && !conversationBusy}}" class="ew-hit-target ew-link" bindtap="onConversationStop">{{conversationStopLabel}}</button>
  <view class="connected-input-row"><textarea placeholder-class="ew-placeholder" class="connected-input" value="{{conversationInput}}" bindinput="onConversationInput" bindkeyboardheightchange="onConversationKeyboard" adjust-position="{{false}}" auto-height maxlength="2000" placeholder="说说想法" cursor-spacing="16" aria-label="给助手的消息" /><button class="ew-hit-target connected-send" disabled="{{conversationBusy || !conversationInput || conversationRecoverable || conversationActionsEnabled === false}}" bindtap="onConversationSend">发送</button></view>
 </view>
</view>
</block>
<block wx:else>
<block wx:if="{{workspaceEnabled}}"><include src="../../templates/meal-workspace.wxml" /></block>
<block wx:else>
<view class="ew-page ew-dish-surface page" style="font-size:{{fontBase * fontScale}}px">
  <view class="assistant-head">
    <view>
      <view class="head-title">吃什么助手</view>

    </view>
    <button class="ew-hit-target ew-button secondary" disabled="{{loading || pendingAction}}" bindtap="onOpenSettings">人数 / 餐次</button><view aria-role="button" class="ew-hit-target clear-btn" bindtap="onClearSession"><ui-icon class="line-icon line-icon-refresh" name="refresh" /><text>清空</text></view>
  </view>

  <view wx:if="{{taskStage || (task && task.status === 'ready')}}" class="task-summary">
    <view class="task-dot {{loading ? 'task-dot-loading' : ''}}"></view><text wx:if="{{loading}}">{{taskStage === 'querying' ? '正在查询菜库' : taskStage === 'planning' ? '正在组合方案' : taskStage === 'validating' ? '正在检查规则' : '正在理解你的需求'}}</text><text wx:else>{{task && task.type === 'period_plan' ? '多日安排已整理' : '本餐安排已整理'}}</text>
    <text aria-role="button" wx:if="{{loading}}" class="ew-hit-target stop-task" bindtap="onStopTask">停止</text><text wx:elif="{{plan && plan.period && plan.period.people}}">{{plan.period.people}}人</text>
  </view>

  <scroll-view class="msg-list" scroll-y enhanced scroll-top="{{scrollTop}}" scroll-with-animation>
    <view wx:if="{{!messages.length}}" class="welcome-block">

      <view class="welcome-title">今天这一餐，交给我一起想</view>
      <view class="welcome-text">说说人数、口味和手边食材，我会从菜谱里帮你搭配，也可以逐道调整。</view>
    </view>
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-row {{item.role === 'user' ? 'row-right' : 'row-left'}}">
        <view wx:if="{{item.role === 'assistant'}}" class="avatar-bot-fb"><text>助</text></view>
        <image wx:if="{{item.role === 'user' && userAvatar}}" class="avatar-user" src="{{userAvatar}}" mode="aspectFill" />
        <view wx:if="{{item.role === 'user' && !userAvatar}}" class="avatar-user-fb"><ui-icon class="line-icon line-icon-user" name="user" /></view>
        <view class="msg-bubble {{item.role === 'user' ? 'bubble-right' : 'bubble-left'}}"><text>{{item.content}}</text></view>
      </view>
      <view wx:if="{{item.role === 'assistant' && item.dishes && item.dishes.length}}" class="dish-cards">
        <view aria-role="button" class="ew-hit-target dish-card" wx:for="{{item.dishes}}" wx:key="id" wx:for-item="dish" bindtap="onTapDish" data-id="{{dish.id}}">
          <image wx:if="{{dish.image}}" class="dc-img" src="{{dish.image}}" mode="aspectFill" lazy-load />

          <view class="dc-info"><text class="dc-name">{{dish.name}}</text><text wx:if="{{dish.match_reasons && dish.match_reasons[0]}}" class="dc-reason">{{dish.match_reasons[0]}}</text></view>
          <text class="dc-arrow">›</text>
        </view>
      </view>
    </block>
    <view wx:if="{{plan && plan.meals && plan.meals.length}}" class="plan-block">
      <view class="plan-heading"><text>这次安排</text></view>
      <view wx:for="{{plan.meals}}" wx:for-item="meal" wx:key="index" class="meal-group">
        <view class="meal-heading"><text>{{meal.date}}</text><text>{{meal.label}}</text></view>
        <view aria-role="button" wx:for="{{meal.dishes}}" wx:key="index" wx:for-item="dish" class="ew-hit-target plan-dish" bindtap="onTapDish" data-id="{{dish.id}}">
          <view class="plan-dish-main"><text class="plan-dish-name">{{dish.name}}</text><text wx:if="{{dish.match_reasons && dish.match_reasons[0]}}" class="plan-reason">{{dish.match_reasons[0]}}</text></view>
          <ui-status wx:if="{{dish.locked}}" label="已保留" />
          <view class="dish-commands"><button class="ew-hit-target ew-link" disabled="{{loading || pendingAction}}" data-id="{{dish.id}}" data-date="{{meal.date}}" data-meal="{{meal.meal_type}}" data-locked="{{dish.locked}}" catchtap="onToggleKeepDish">{{dish.locked ? '解除保留' : '保留'}}</button><button class="ew-hit-target ew-link" disabled="{{loading || pendingAction || dish.locked}}" data-id="{{dish.id}}" data-date="{{meal.date}}" data-meal="{{meal.meal_type}}" catchtap="onReplaceDish">换菜</button></view>
        </view>
      </view>
      <view wx:if="{{plan.warnings && plan.warnings.length}}" class="plan-warning"><ui-icon class="line-icon line-icon-info" name="info" /><text>{{plan.warnings[0]}}</text></view>
      <view class="plan-actions">
        <button class="ew-hit-target secondary-action" disabled="{{loading || pendingAction}}" bindtap="onKeepDish">保留全部</button>
        <button class="ew-hit-target secondary-action" disabled="{{loading || pendingAction}}" bindtap="onReplaceDish">换一道</button>
        <button wx:if="{{canUndo}}" class="ew-hit-target secondary-action" disabled="{{loading || pendingAction}}" bindtap="onUndoPlan">撤销修改</button>
      </view>
    </view>
    <view wx:if="{{howto}}" class="howto-block">
      <view class="howto-heading"><text>{{howto.dish_name}} · 做法</text></view>
      <view wx:if="{{howto.steps && howto.steps.length}}" class="howto-steps">
        <view wx:for="{{howto.steps}}" wx:key="index" class="howto-step"><text class="step-index">{{index + 1}}</text><text class="step-text">{{item}}</text></view>
      </view>
      <view wx:else class="howto-empty">暂无完整步骤，打开菜品详情查看可用信息。</view>
    </view>
    <view wx:if="{{alternatives && alternatives.length}}" class="alternatives-block">
      <view class="alternatives-heading"><text>还可以考虑</text></view>
      <view aria-role="button" wx:for="{{alternatives}}" wx:key="id" class="ew-hit-target alternative-row" bindtap="onTapDish" data-id="{{item.id}}">
        <view class="alternative-main"><text class="alternative-name">{{item.name}}</text><text wx:if="{{item.match_reasons && item.match_reasons[0]}}" class="alternative-reason">{{item.match_reasons[0]}}</text></view><text class="plan-arrow">›</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="msg-row row-left"><view class="avatar-bot-fb"><text>助</text></view><view class="msg-bubble bubble-left typing-dots"><text class="dot">●</text><text class="dot">●</text><text class="dot">●</text></view></view>
    <view wx:if="{{errorMessage}}" class="error-state"><text>{{errorMessage}}</text><button class="ew-hit-target" bindtap="onRetry">重试</button></view>
  </scroll-view>

  <view wx:if="{{actions && actions.length}}" class="action-bar">
    <button wx:for="{{actions}}" wx:key="type" class="ew-hit-target primary-action" loading="{{pendingAction === item.type}}" disabled="{{!!pendingAction}}" bindtap="onAction" data-type="{{item.type}}">{{item.label}}</button>
  </view>
  <scroll-view class="quick-bar" scroll-x enhanced show-scrollbar="false">
    <text aria-role="button" class="ew-hit-target quick-btn" bindtap="onQuick" data-kw="推荐今天的晚餐">今晚吃什么</text>
    <text aria-role="button" class="ew-hit-target quick-btn" bindtap="onQuick" data-kw="家里有鸡蛋和番茄，安排一顿晚饭">看看冰箱</text>
    <text aria-role="button" class="ew-hit-target quick-btn" bindtap="onQuick" data-kw="推荐几道清淡的菜">清淡推荐</text>
    <text aria-role="button" class="ew-hit-target quick-btn" bindtap="onQuick" data-kw="帮我搭配三菜一汤">搭配一桌</text>
    <text aria-role="button" class="ew-hit-target quick-btn" bindtap="onQuick" data-kw="红烧排骨怎么做">查做法</text>
  </scroll-view>
  <view class="input-bar"><input placeholder-class="ew-placeholder" class="chat-input" value="{{inputText}}" placeholder="告诉我你想怎么吃" bindinput="onInput" confirm-type="send" bindconfirm="onSend" /><button class="ew-hit-target send-btn" bindtap="onSend" disabled="{{loading || !inputText}}" loading="{{loading}}" aria-label="发送消息">发送</button></view>
<ui-confirm visible="{{settingsVisible}}" title="本次用餐" busy="{{loading}}" confirm-label="应用到输入" bind:cancel="onCloseSettings" bind:confirm="onApplySettings"><view class="ew-field"><text class="ew-label">日期</text><picker class="ew-hit-target" mode="date" value="{{settingDate}}" bindchange="onSettingDate"><view class="ew-input">{{settingDate}}</view></picker></view><view class="ew-field"><text class="ew-label">餐次</text><picker class="ew-hit-target" range="{{mealLabels}}" value="{{settingMealIndex}}" bindchange="onSettingMeal"><view class="ew-input">{{mealLabels[settingMealIndex]}}</view></picker></view><ui-field disabled="{{loading}}" label="人数" type="number" value="{{settingPeople}}" maxlength="2" bind:change="onSettingPeople" /><view wx:if="{{settingsError}}" class="ew-error">{{settingsError}}</view></ui-confirm>
</view>

</block>

</block>
