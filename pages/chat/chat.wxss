/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/theme.wxss";
.page{height:100vh;display:flex;flex-direction:column;background:#f7fbf9;box-sizing:border-box;padding-bottom:env(safe-area-inset-bottom)}
.assistant-head{display:flex;align-items:center;justify-content:space-between;padding:24rpx 32rpx 18rpx;background:linear-gradient(180deg,#e7f8f1 0%,#FFFFFF 100%);flex-shrink:0}
.head-title{font-size:1.125em;font-weight:700;color:#28634E;line-height:1.25}.head-subtitle{margin-top:8rpx;font-size:0.75em;color:#56645B}
.clear-btn{display:flex;align-items:center;gap:8rpx;color:#56645B;font-size:0.75em;padding:10rpx}.clear-btn .line-icon{width:28rpx;height:28rpx}
.task-summary{display:flex;align-items:center;gap:10rpx;margin:0 24rpx 8rpx;padding:12rpx 16rpx;background:#FFFFFF;border:1rpx solid #dcece5;border-radius:12rpx;color:#28634E;font-size:0.75em;flex-shrink:0}.task-summary text:last-child{margin-left:auto;color:#56645B}.task-dot{width:12rpx;height:12rpx;border-radius:50%;background:#28634E}.task-dot-loading{animation:blink 1.2s infinite}.stop-task{color:#28634E!important;padding-left:18rpx}.mode-badge{margin-left:10rpx!important;padding:2rpx 10rpx;border-radius:14rpx;background:#e8f8f1;color:#28634E!important;font-size:0.75em}
.msg-list{flex:1;min-height:0;padding:18rpx 24rpx 24rpx;box-sizing:border-box;overflow-y:auto}.welcome-block{text-align:center;padding:72rpx 40rpx 42rpx}.welcome-icon{width:92rpx;height:92rpx;border-radius:50%;margin:0 auto 24rpx;display:flex;align-items:center;justify-content:center;background:#dff4ec;color:#28634E}.welcome-icon .line-icon{width:48rpx;height:48rpx}.welcome-title{font-size:1em;font-weight:600;color:#28634E}.welcome-text{font-size:0.8125em;line-height:1.7;color:#56645B;margin-top:14rpx}
.msg-row{display:flex;align-items:flex-start;margin-bottom:20rpx}.row-right{flex-direction:row-reverse}.avatar-bot-fb,.avatar-user,.avatar-user-fb{width:64rpx;height:64rpx;border-radius:50%;flex-shrink:0;margin:0 10rpx}.avatar-bot-fb,.avatar-user-fb{display:flex;align-items:center;justify-content:center}.avatar-bot-fb{background:#e1f4ed;color:#28634E}.avatar-user-fb{background:#e7ecea;color:#56645B}.avatar-bot-fb .line-icon,.avatar-user-fb .line-icon{width:36rpx;height:36rpx}.msg-bubble{max-width:78%;padding:16rpx 20rpx;border-radius:18rpx;font-size:1em;line-height:1.65;white-space:pre-wrap;word-break:break-word}.bubble-left{background:#FFFFFF;color:#25332B;border:1rpx solid #deebe5;border-top-left-radius:6rpx}.bubble-right{background:#28634E;color:#FFFFFF;border-top-right-radius:6rpx}
.dish-cards{display:flex;flex-direction:column;gap:10rpx;padding:0 8rpx 12rpx 84rpx}.dish-card{display:flex;align-items:center;min-height:92rpx;padding:12rpx 14rpx;background:#FFFFFF;border:1rpx solid #EDF3ED;border-radius:12rpx;box-sizing:border-box}.dc-img,.dc-img-fb{width:100rpx;height:76rpx;border-radius:8rpx;flex-shrink:0;margin-right:14rpx;background:#eff6f3}.dc-img-fb{display:flex;align-items:center;justify-content:center;color:#28634E}.dc-img-fb .line-icon{width:36rpx;height:36rpx}.dc-info,.plan-dish-main{flex:1;min-width:0}.dc-name,.plan-dish-name{display:block;font-size:1em;font-weight:600;color:#25332B;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dc-reason,.plan-reason{display:block;margin-top:6rpx;font-size:0.75em;color:#56645B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dc-arrow,.plan-arrow{font-size:1.125em;color:#56645B;margin-left:10rpx}
.plan-block{margin:6rpx 8rpx 20rpx;padding:20rpx;background:#FFFFFF;border:1rpx solid #EDF3ED;border-radius:14rpx}.plan-heading{display:flex;justify-content:space-between;align-items:center;font-size:1em;color:#28634E;font-weight:600}.plan-version{font-size:0.75em;color:#56645B;font-weight:400}.meal-group{margin-top:18rpx}.meal-heading{display:flex;justify-content:space-between;color:#56645B;font-size:0.75em;padding-bottom:8rpx;border-bottom:1rpx solid #edf3f0}.plan-dish{display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f0f4f2}.plan-dish:last-child{border-bottom:0}.plan-actions{display:flex;gap:12rpx;margin-top:16rpx}.secondary-action,.primary-action{border-radius:10rpx;font-size:0.8125em;line-height:70rpx;height:70rpx;padding:0 20rpx;box-sizing:border-box}.secondary-action{flex:1;color:#28634E;background:#f0faf6;border:1rpx solid #cce9dc}.plan-warning{display:flex;align-items:flex-start;gap:8rpx;margin-top:12rpx;padding:12rpx;background:#fff9e9;color:#75501A;font-size:0.75em;line-height:1.5;border-radius:8rpx}.plan-warning .line-icon{width:28rpx;height:28rpx;flex-shrink:0}
.howto-block{margin:6rpx 8rpx 20rpx;padding:20rpx;background:#FFFFFF;border:1rpx solid #EDF3ED;border-radius:14rpx}.howto-heading{display:flex;align-items:center;justify-content:space-between;color:#28634E;font-size:1em;font-weight:600}.howto-source{font-size:0.75em;font-weight:400;color:#56645B}.howto-step{display:flex;align-items:flex-start;gap:12rpx;margin-top:16rpx;color:#56645B;font-size:0.8125em;line-height:1.55}.step-index{width:34rpx;height:34rpx;line-height:34rpx;border-radius:50%;background:#e1f4ed;color:#28634E;text-align:center;font-size:0.75em;flex-shrink:0}.step-text{flex:1;word-break:break-word}.howto-empty{margin-top:16rpx;color:#56645B;font-size:0.75em;line-height:1.5}
.alternatives-block{margin:0 8rpx 20rpx;padding:18rpx 20rpx;background:#fbfefd;border:1rpx solid #e3eee9;border-radius:14rpx}.alternatives-heading{display:flex;justify-content:space-between;align-items:center;color:#28634E;font-size:0.8125em}.alternatives-heading text:last-child{font-size:0.75em;color:#56645B}.alternative-row{display:flex;align-items:center;padding:14rpx 0;border-bottom:1rpx solid #edf3f0}.alternative-row:last-child{border-bottom:0}.alternative-main{flex:1;min-width:0}.alternative-name{display:block;color:#28634E;font-size:0.8125em}.alternative-reason{display:block;margin-top:4rpx;color:#56645B;font-size:0.75em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.action-bar{display:flex;gap:12rpx;flex-wrap:wrap;padding:14rpx 24rpx 6rpx;background:#FFFFFF;border-top:1rpx solid #e8efec;flex-shrink:0}.primary-action{flex:1;min-width:260rpx;color:#FFFFFF;background:#28634E}.ew-page .primary-action[disabled]{opacity:1;background:#E8EBE5;color:#25332B}
.quick-bar{display:flex;white-space:nowrap;background:#FFFFFF;border-top:1rpx solid #eef3f1;padding:12rpx 24rpx;box-sizing:border-box;flex-shrink:0}.quick-btn{display:inline-block;margin-right:12rpx;padding:10rpx 18rpx;border-radius:22rpx;background:#eef9f5;color:#28634E;font-size:0.75em;white-space:nowrap}.input-bar{display:flex;align-items:center;gap:12rpx;padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));background:#FFFFFF;border-top:1rpx solid #e8efec;flex-shrink:0}.chat-input{flex:1;min-width:0;height:76rpx;padding:0 22rpx;border-radius:38rpx;background:#f3f6f5;color:#25332B;font-size:1em;box-sizing:border-box}.send-btn{width:76rpx;height:76rpx;line-height:76rpx;padding:0;border-radius:50%;background:#28634E;display:flex;align-items:center;justify-content:center;flex-shrink:0}.send-btn .line-icon{width:34rpx;height:34rpx;color:#FFFFFF}.send-btn[disabled]{opacity:1;background:#E8EBE5;color:#25332B}.typing-dots{display:flex;gap:8rpx;padding:14rpx 22rpx}.dot{font-size:0.75em;color:#28634E;animation:blink 1.2s infinite}.dot:nth-child(2){animation-delay:.2s}.dot:nth-child(3){animation-delay:.4s}@keyframes blink{0%,100%{opacity:.85}50%{opacity:1}}.error-state{display:flex;align-items:center;gap:12rpx;padding:12rpx 16rpx;margin:0 8rpx 16rpx;background:#fff2f0;border-radius:10rpx;color:#A93B30;font-size:0.75em}.error-state text{flex:1}.error-state button{margin:0;padding:0 18rpx;height:54rpx;line-height:54rpx;border-radius:8rpx;color:#A93B30;background:#FFFFFF;border:1rpx solid #edc6c0;font-size:0.75em}

/* 页面共享主题，适用于本页详情、表单和弹层。 */

.plan-dish { flex-wrap:wrap; }
.dish-commands { display:flex;gap:12rpx;width:100%; }
.clear-btn,.quick-btn,.stop-task { min-height:44px;min-width:44px;display:inline-flex;align-items:center;justify-content:center; }

/* Shared finish for legacy pages; layout and permission-specific states remain local. */
.ew-page { background:#F8F7F2; color:#25332B; }
.ew-page .btn-primary, .ew-page .primary-btn, .ew-page .save-btn, .ew-page .primary-action, .ew-page .generate-btn { background:#28634E; border-radius:24rpx; }
.ew-page .choice-chip, .ew-page .ingredient-chip, .ew-page .count-btn, .ew-page .clear-btn, .ew-page .period-nav, .ew-page .filter-chip { min-height:44px; min-width:44px; box-sizing:border-box; }

@import "../../styles/workspace.wxss";

/* Input and touch minima remain fixed under small screens/font changes. */
.ew-page button,.ew-page input,.ew-page .count-btn,.ew-page .choice-chip,.ew-page .filter-chip,.ew-page .date-picker{min-height:44px;box-sizing:border-box}
.ew-page .primary-btn,.ew-page .save-btn,.ew-page .primary-action,.ew-page .wx-login-btn{min-height:48px}

.send-btn { width:auto; min-width:64px; border-radius:14px; padding:0 12px; color:#FFFFFF; }

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }


button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }
