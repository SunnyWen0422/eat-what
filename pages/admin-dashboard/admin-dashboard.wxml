<view class="ew-page admin-workspace page" style="font-size:{{fontBase * fontScale}}px">
  <ui-state wx:if="{{authStatus}}" kind="{{authStatus}}" title="{{authMessage}}" />
  <view class="heading">
    <view>
      <text class="title">管理工作台</text>
      <text class="subtitle">数据、用户与菜品状态一目了然</text>
    </view>
    <button class="ew-hit-target refresh" bindtap="load" loading="{{loading}}" aria-label="刷新">刷新</button>
  </view>

  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{loading && !ready}}" class="state"><text>正在加载概览...</text></view>
  <view wx:elif="{{error && !ready}}" class="state">
    <text>{{error}}</text><button class="ew-hit-target retry" bindtap="retry">重新加载</button>
  </view>
  <block wx:elif="{{ready}}">
    <view class="metric-grid">
      <view class="metric"><text class="metric-value">{{overview.totalUsers}}</text><text>用户总数</text></view>
      <view class="metric"><text class="metric-value green">{{overview.activeUsers}}</text><text>正常用户</text></view>
      <view class="metric"><text class="metric-value amber">{{overview.disabledUsers}}</text><text>停用用户</text></view>
      <view class="metric"><text class="metric-value">{{overview.systemDishes}}</text><text>系统菜品</text></view>
      <view class="metric"><text class="metric-value">{{overview.customDishes}}</text><text>自定义菜品</text></view>
      <view class="metric"><text class="metric-value green">{{overview.todayNewUsers}}</text><text>今日新增用户</text></view>
    </view>

    <view class="section-title">快捷管理</view>
    <view class="action-list">
      <view class="ew-hit-target action" bindtap="openUsers"><view><text class="action-title">用户管理</text><text>搜索用户、调整状态、查看自定义菜品</text></view><ui-icon class="arrow" name="chevron-right" tone="muted" size="16" /></view>
      <view class="ew-hit-target action" bindtap="openDishes"><view><text class="action-title">菜品管理</text><text>编辑系统菜品、控制发布状态</text></view><ui-icon class="arrow" name="chevron-right" tone="muted" size="16" /></view>
      <view class="ew-hit-target action" bindtap="openAudit"><view><text class="action-title">审计日志</text><text>追踪所有管理员变更与结果</text></view><ui-icon class="arrow" name="chevron-right" tone="muted" size="16" /></view>
    </view>

    <view class="section-title">最近操作</view>
    <view wx:if="{{!overview.recentAudits.length}}" class="empty">暂无审计记录</view>
    <view wx:else class="audit-list">
      <view class="audit-row" wx:for="{{overview.recentAudits}}" wx:key="id">
        <view><text class="audit-action">{{item.action}}</text><text class="audit-meta">{{item.createdAt}} · {{item.result}}</text></view>
        <text class="audit-target">{{item.targetDishId || item.targetUserId || '-'}}</text>
      </view>
    </view>
  </block>
</view>
