page { min-height: 100%; background: #f4f6f5; color: #1f2924; }
button::after { border: none; }
.page { min-height: 100vh; padding: 28rpx 24rpx 48rpx; box-sizing: border-box; }
.heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; }
.subtitle { display: block; color: #6d7772; font-size: 24rpx; margin-top: 8rpx; }
.refresh, .retry { background: #237a55; color: #fff; border-radius: 10rpx; min-height: 72rpx; padding: 0 24rpx; font-size: 25rpx; }
.notice { background: #e5f3eb; color: #176a47; padding: 16rpx 18rpx; border-radius: 8rpx; margin-bottom: 16rpx; font-size: 24rpx; }
.state, .empty { min-height: 240rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #6d7772; gap: 20rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.metric { min-height: 140rpx; padding: 18rpx 12rpx; box-sizing: border-box; background: #fff; border: 2rpx solid #e1e7e3; border-radius: 12rpx; display: flex; flex-direction: column; justify-content: center; gap: 6rpx; color: #6d7772; font-size: 22rpx; }
.metric-value { font-size: 38rpx; font-weight: 700; color: #26342d; }
.metric-value.green { color: #237a55; } .metric-value.amber { color: #a96d1d; }
.section-title { margin: 30rpx 0 14rpx; font-size: 28rpx; font-weight: 650; }
.action-list, .audit-list { display: flex; flex-direction: column; gap: 10rpx; }
.action, .audit-row { background: #fff; border: 2rpx solid #e1e7e3; border-radius: 12rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; }
.action-title, .audit-action { display: block; font-size: 29rpx; font-weight: 650; }
.action text:not(.action-title), .audit-meta { display: block; margin-top: 8rpx; font-size: 23rpx; color: #6d7772; }
.arrow { font-size: 42rpx; color: #89928d; } .audit-target { color: #6d7772; font-size: 23rpx; }
