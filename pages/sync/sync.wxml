<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px">
  <view class="ew-heading">待核对与同步</view>
  <view wx:if="{{errorMessage}}" class="ew-error">{{errorMessage}}</view>
  <view wx:if="{{recoveryPointers.length}}" class="ew-section-title">保留的操作</view>
  <view wx:for="{{recoveryPointers}}" wx:key="id" class="sync-draft">
    <view class="ew-title">{{item.label}}</view>
    <view wx:if="{{item.target}}" class="ew-muted">{{item.target.date}} {{item.target.mealType === 'breakfast' ? '早餐' : item.target.mealType === 'lunch' ? '午餐' : '晚餐'}}</view>
    <ui-button label="查看原操作" variant="secondary" data-index="{{index}}" bind:action="onRecoverPointer" />
  </view>
  <view wx:if="{{shoppingDraftCount}}" class="ew-card"><view class="ew-title">采购操作 · {{shoppingDraftCount}} 项</view><ui-button label="查看采购内容" variant="secondary" bind:action="onShoppingDrafts" /></view>
  <view wx:if="{{pendingSync.length}}" class="ew-section-title">历史本机安排</view>
  <ui-state wx:if="{{!pendingSync.length && !recoveryPointers.length && !shoppingDraftCount}}" kind="empty" density="inline" title="没有待核对的内容" />
  <view wx:for="{{pendingSync}}" wx:key="index" class="sync-draft"><view class="ew-title">{{item.date}} {{item.mealName}}</view><view>{{item.record.name}}</view><ui-status label="本机草稿" tone="warning" /></view>
  <ui-button wx:if="{{pendingSync.length}}" label="逐条确认并同步" loading="{{syncing}}" bind:action="syncData" />
  <view wx:if="{{syncResult.success || syncResult.failed}}" class="ew-notice">已保存 {{syncResult.success}} 条 · 未完成 {{syncResult.failed}} 条</view>
  <button wx:if="{{syncedLocalCount > 0}}" class="ew-hit-target ew-link" disabled="{{syncing}}" bindtap="clearSyncedData">清理已确认的本机副本</button>
</view>
