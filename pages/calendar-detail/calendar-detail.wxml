<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px"><text class="ew-heading">{{selectedDate}}</text><text class="ew-subtitle">安排与实际用餐分别保存，临时换菜也可以记录。</text>
<ui-state wx:if="{{loading && !meals.length}}" kind="loading" title="正在读取三餐" />
<ui-state wx:elif="{{errorMessage && !meals.length}}" kind="error" title="暂时无法读取" description="{{errorMessage}}" action-label="重试" bind:action="loadMealRecords" />
<view wx:if="{{errorMessage && meals.length}}" class="ew-error">{{errorMessage}}<text class="ew-hit-target ew-link" bindtap="loadMealRecords">重新加载</text></view>
<meal-card id="meal-{{item.mealType}}" wx:for="{{meals}}" wx:key="mealType" clickable="{{false}}" title="{{item.label}}" name="{{item.plan ? item.plan.recipeName : '还没有安排'}}" status="{{item.statusLabel}}" description="{{item.actualNames ? '实际吃了：' + item.actualNames : ''}}">
<view wx:if="{{item.plan}}" class="dish-links"><text wx:for="{{item.plan.dishDetails}}" wx:for-item="dish" wx:key="id" class="ew-hit-target ew-chip" data-id="{{dish.id}}" data-meal="{{item.mealType}}" data-source="plan" data-people="{{item.plan.targetPeople || 2}}" bindtap="onViewDish">{{dish.name}} · 做法</text><text class="ew-muted">{{item.plan.targetPeople || 2}} 人用餐</text></view>
<view wx:if="{{item.actual && item.status === 'eaten'}}" class="dish-links"><text wx:for="{{item.actual.actualDishes}}" wx:for-item="dish" wx:key="index" wx:if="{{dish.dishId}}" class="ew-hit-target ew-chip" data-id="{{dish.dishId}}" data-meal="{{item.mealType}}" data-source="actual" bindtap="onViewDish">{{dish.name}} · 实际做法</text></view>
<view wx:if="{{!item.plan}}" class="ew-actions"><button class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onChooseRecipe" disabled="{{mutating}}">选菜安排这一餐</button></view>
<button wx:if="{{item.plan}}" class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onAddMealToShoppingList" disabled="{{mutating || item.status === 'skipped'}}">准备这餐食材</button>
<view wx:if="{{canRecord}}" class="ew-actions"><button wx:if="{{item.plan && item.status !== 'eaten'}}" class="ew-hit-target ew-button" data-meal="{{item.mealType}}" bindtap="onEaten" disabled="{{mutating}}">按计划吃了</button><button class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onActualDifferent" disabled="{{mutating}}">{{item.status === 'eaten' ? '修改实际记录' : '记录实际吃的'}}</button></view>
<button class="ew-hit-target ew-link meal-more" data-meal="{{item.mealType}}" bindtap="onMoreMeal" disabled="{{mutating}}">{{expandedMeal === item.mealType ? '收起操作' : '调整与更多操作'}}</button>
<view wx:if="{{expandedMeal === item.mealType}}" class="meal-more-panel">
  <view class="ew-actions"><button class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onEditPlan" disabled="{{mutating}}">{{item.plan ? '编辑安排' : '手动安排'}}</button><button wx:if="{{item.plan}}" class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onChooseRecipe" disabled="{{mutating}}">重新选菜</button><button wx:if="{{item.plan}}" class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onCopy" disabled="{{mutating}}">复制到另一天</button></view>
  <view class="ew-actions"><button wx:if="{{item.plan && item.status !== 'skipped'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onSkip" disabled="{{mutating}}">取消这餐安排</button><button wx:if="{{item.actual && item.status !== 'unrecorded'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onUndoActual" disabled="{{mutating}}">撤销实际记录</button><button wx:if="{{item.plan}}" class="ew-hit-target ew-link danger-link" data-meal="{{item.mealType}}" bindtap="onDeleteMeal" disabled="{{mutating}}">删除计划</button></view>
</view>
</meal-card>
<ui-confirm visible="{{formVisible}}" title="{{formTitle}}" busy="{{mutating}}" confirm-label="保存" bind:cancel="closeForm" bind:confirm="saveForm">
<block wx:if="{{formMode === 'plan'}}"><ui-field disabled="{{mutating}}" label="安排名称" value="{{formName}}" required bind:change="onName" /><ui-field disabled="{{mutating}}" label="用餐人数" type="number" maxlength="2" value="{{formPeople}}" bind:change="onPeople" /><text class="ew-muted">从菜谱选菜可以生成食材清单；手动文字用于记录安排名称。</text></block>
<block wx:if="{{formMode === 'actual'}}"><text class="ew-label">实际吃过的菜品</text><textarea placeholder-class="ew-placeholder" disabled="{{mutating}}" adjust-position="{{false}}" class="ew-input" value="{{formActual}}" placeholder="每行一道菜，例如：番茄面" maxlength="3000" bindinput="onActualInput" /><text class="ew-muted">自由填写计入餐次和记录天数，不会推测营养或菜品分类。</text></block>
<block wx:if="{{formMode === 'copy'}}"><text class="ew-label">复制到哪一天</text><picker class="ew-hit-target" disabled="{{mutating}}" mode="date" value="{{copyDate}}" bindchange="onCopyDate"><view class="ew-input">{{copyDate}}</view></picker></block><text wx:if="{{formError}}" class="ew-error">{{formError}}</text>
</ui-confirm></view>
