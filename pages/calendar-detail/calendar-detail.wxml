<view class="ew-page ew-screen" style="font-size:{{fontBase * fontScale}}px"><text class="ew-heading">{{dateHeading}}</text><text class="ew-subtitle">这里保存用餐安排；吃过后用“记录饮食”记下实际吃了什么。</text>
<ui-state wx:if="{{loading && !meals.length}}" kind="loading" title="正在读取三餐" />
<ui-state wx:elif="{{errorMessage && !meals.length}}" kind="error" title="暂时无法读取" description="{{errorMessage}}" action-label="重试" bind:action="loadMealRecords" />
<view wx:if="{{errorMessage && meals.length}}" class="ew-error">{{errorMessage}}<text aria-role="button" class="ew-hit-target ew-link" bindtap="loadMealRecords">重新加载</text></view>
<button wx:if="{{copyPendingMeal}}" class="ew-hit-target ew-link" bindtap="onRecoverCopy" disabled="{{mutating}}">复制结果待确认 · 确认刚才的复制</button>
<text wx:if="{{actualSavedMessage}}" class="ew-notice" role="status">{{actualSavedMessage}} · 可以继续查看菜品与做法</text>
<meal-card id="meal-{{item.mealType}}" wx:for="{{meals}}" wx:key="mealType" clickable="{{false}}" title="{{item.label}}" name="{{item.status === 'eaten' ? '实际吃过的菜品' : item.plan ? item.plan.recipeName : item.status === 'skipped' ? '这餐没吃' : '还没有安排'}}" status="{{item.statusLabel}}">
<view class="ew-row ew-between"><text class="ew-muted">{{item.status === 'unrecorded' ? '未记录不代表没吃' : ''}}</text><button wx:if="{{item.plan || (item.actual && item.status !== 'unrecorded')}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onManageMeal" aria-label="{{item.label}}管理">更多</button></view>
<view class="dish-reading"><view wx:for="{{item.presentation.dishes}}" wx:for-item="dish" wx:key="index" class="calendar-dish-row"><compact-dish-row wx:if="{{dish.id || dish.dishId}}" dish="{{dish}}" mode="read" data-id="{{dish.dishId || dish.id}}" data-meal="{{item.mealType}}" data-source="{{item.status === 'eaten' ? 'actual' : 'plan'}}" bind:view="onViewDish" /><text wx:else class="ew-reading">{{dish.name}} · 自由记录，暂无菜谱</text></view></view>
<block wx:if="{{item.status === 'eaten' && item.presentation.originalPlan}}"><button class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onOriginalPlan">原安排 · {{originalMeal === item.mealType ? '收起' : '展开'}}</button><view wx:if="{{originalMeal === item.mealType}}" class="original-plan"><text class="ew-label">{{item.presentation.originalPlan.name || item.presentation.originalPlan.recipeName || '原计划快照'}}</text><text wx:for="{{item.presentation.originalPlan.dishDetails}}" wx:for-item="dish" wx:key="index" class="ew-reading">{{dish.name}}</text></view></block>
<button wx:if="{{item.plan && item.status !== 'eaten' && item.status !== 'skipped'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onAddMealToShoppingList" disabled="{{mutating}}">准备这餐食材</button>
<view class="ew-actions"><button wx:if="{{item.plan}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onAdjustMeal" disabled="{{mutating}}">调整菜单</button><button wx:elif="{{!item.actual || item.status === 'unrecorded'}}" class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onChooseRecipe" disabled="{{mutating}}">安排这一餐</button><button wx:if="{{canRecord && item.status !== 'eaten'}}" class="ew-hit-target {{item.plan ? 'ew-button' : 'ew-link'}}" data-meal="{{item.mealType}}" bindtap="onRecordMeal" disabled="{{mutating}}">{{item.plan ? '这餐吃了' : '补记吃过的'}}</button><button wx:if="{{canRecord && item.status === 'eaten'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onActualDifferent" disabled="{{mutating}}">{{item.status === 'eaten' ? '修改饮食记录' : '记录饮食'}}</button></view>
<view wx:if="{{adjustMeal === item.mealType && item.plan}}" class="meal-more-panel"><text class="ew-label">调整菜单</text><button class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onChooseRecipe">改菜</button><button class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onEditPlan">改人数 / 名称</button><button class="ew-hit-target ew-button secondary" data-meal="{{item.mealType}}" bindtap="onCopy">复制到其他日期</button><text class="ew-muted">复制保留原安排，不移动实际记录。</text></view>
<button wx:if="{{canRecord}}" class="ew-hit-target ew-link meal-more" data-meal="{{item.mealType}}" bindtap="onMoreMeal">用餐状态</button>
<view wx:if="{{expandedMeal === item.mealType && canRecord}}" class="meal-more-panel"><text class="ew-muted">未记录不代表没吃，不想记录可以直接离开。</text><button wx:if="{{item.plan && item.status !== 'skipped'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onSkip">这餐没吃</button><button class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onActualDifferent">更正实际记录</button><button wx:if="{{item.actual && item.status !== 'unrecorded'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onUndoActual">更正为未记录</button></view>
<view wx:if="{{manageMeal === item.mealType}}" class="meal-more-panel"><button wx:if="{{item.plan}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onCopy">复制安排 · 原安排保留</button><button wx:if="{{item.plan}}" class="ew-hit-target ew-link danger-link" data-meal="{{item.mealType}}" bindtap="onDeleteMeal">移除这餐安排</button><button wx:if="{{canRecord && item.actual && item.status !== 'unrecorded'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onActualDifferent">查看或更正记录</button></view>
</meal-card>
<ui-confirm visible="{{formVisible}}" title="{{formTitle}}" busy="{{mutating}}" confirm-label="{{formMode === 'actual' ? '记录饮食' : '保存到日历'}}" bind:cancel="closeForm" bind:confirm="saveForm">
<block wx:if="{{formMode === 'plan'}}"><ui-field disabled="{{mutating}}" label="安排名称" value="{{formName}}" required bind:change="onName" /><ui-field disabled="{{mutating}}" label="用餐人数" type="number" maxlength="2" value="{{formPeople}}" bind:change="onPeople" /><text class="ew-muted">从菜谱选菜可以生成食材清单；手动文字用于记录安排名称。</text></block>
<block wx:if="{{formMode === 'actual'}}"><text class="ew-label">实际吃过的菜品</text><textarea placeholder-class="ew-placeholder" disabled="{{mutating}}" adjust-position="{{false}}" class="ew-input" value="{{formActual}}" placeholder="每行一道菜，例如：番茄面" maxlength="3000" bindinput="onActualInput" /><text class="ew-muted">自由填写计入餐次和记录天数，不会推测营养或菜品分类。</text></block>
<block wx:if="{{formMode === 'copy'}}"><text class="ew-label">复制到哪一天</text><picker class="ew-hit-target" disabled="{{mutating || copyUnknown}}" mode="date" value="{{copyDate}}" bindchange="onCopyDate"><view class="ew-input">{{copyDate}}</view></picker></block><text wx:if="{{formError}}" class="ew-error">{{formError}}</text>
</ui-confirm><ui-confirm visible="{{actualVisible && actualQuick}}" title="这餐吃了" busy="{{actualBusy || actualLoading}}" confirm-label="确认记录" bind:cancel="closeMealActual" bind:confirm="onConfirmActual"><text class="ew-label">{{actualTitle}}</text><text class="ew-reading">{{actualText}}</text><text class="ew-muted">只记录这次实际吃过的内容。</text><text wx:if="{{actualError}}" class="ew-error">{{actualError}}</text><button class="ew-hit-target ew-link" disabled="{{actualBusy || actualLoading}}" bindtap="onActualAdjustment">有调整</button></ui-confirm><block wx:if="{{!actualQuick}}"><include src="../../templates/meal-actual-sheet.wxml" /></block></view>
