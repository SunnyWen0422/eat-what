<view class="ew-page ew-screen calendar-detail-page" style="font-size:{{fontBase * fontScale}}px">
  <text class="ew-heading">{{dateHeading}}</text>
  <ui-state wx:if="{{loading && !meals.length}}" kind="loading" title="正在读取这餐" />
  <ui-state wx:elif="{{errorMessage && !meals.length}}" kind="error" title="暂时无法读取" description="{{errorMessage}}" action-label="重试" bind:action="loadMealRecords" />
  <view wx:if="{{errorMessage && meals.length}}" class="ew-error">{{errorMessage}}<button class="ew-hit-target ew-link" bindtap="loadMealRecords">重新加载</button></view>
  <button wx:if="{{copyPendingMeal}}" class="ew-hit-target ew-link" bindtap="onRecoverCopy" disabled="{{mutating}}">复制结果待确认 · 确认刚才的复制</button>
  <text wx:if="{{actualSavedMessage}}" class="ew-notice" aria-role="status">{{actualSavedMessage}} · 可以继续查看菜品与做法</text>
  <view id="meal-{{item.mealType}}" wx:for="{{meals}}" wx:key="mealType" class="calendar-meal">
    <view class="meal-heading"><view class="ew-grow"><text wx:if="{{!focusedMeal}}" class="ew-title">{{item.label}}</text><text class="meal-status ew-muted">{{item.statusLabel}}{{item.displayPeople ? ' · ' + item.displayPeople + '人' : ''}}</text></view><button wx:if="{{item.plan || (item.actual && item.status !== 'unrecorded')}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onManageMeal" aria-label="{{item.label}}管理">更多</button></view>
    <view class="dish-reading"><view wx:for="{{item.presentation.dishes}}" wx:for-item="dish" wx:key="index" class="calendar-dish-row"><compact-dish-row wx:if="{{dish.id || dish.dishId}}" dish="{{dish}}" mode="read" data-id="{{dish.dishId || dish.id}}" data-meal="{{item.mealType}}" data-source="{{item.status === 'eaten' ? 'actual' : 'plan'}}" bind:view="onViewDish" /><text wx:else class="ew-reading">{{dish.name}} · 自由记录，暂无菜谱</text></view></view>
    <text wx:if="{{!item.presentation.dishes.length && item.status === 'eaten'}}" class="ew-muted">这餐已记录，暂无可查看的菜品</text>
    <text wx:elif="{{!item.presentation.dishes.length && item.plan}}" class="ew-reading">{{item.plan.recipeName}}</text>
    <text wx:elif="{{!item.presentation.dishes.length}}" class="ew-muted">{{item.status === 'skipped' ? '已记录这餐没吃' : '还没有安排'}}</text>
    <block wx:if="{{item.status === 'eaten' && item.presentation.originalPlan}}"><button class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onOriginalPlan">原安排 · {{originalMeal === item.mealType ? '收起' : '展开'}}</button><view wx:if="{{originalMeal === item.mealType}}" class="original-plan"><text class="ew-label">{{item.presentation.originalPlan.name || item.presentation.originalPlan.recipeName || '原安排'}}</text><text wx:for="{{item.presentation.originalPlan.dishDetails}}" wx:for-item="dish" wx:key="index" class="ew-reading">{{dish.name}}</text></view></block>
    <view class="meal-action-list">
      <button wx:if="{{item.plan}}" class="ew-hit-target meal-action-row" data-meal="{{item.mealType}}" bindtap="onAdjustMeal" disabled="{{mutating}}">调整菜单<ui-icon name="chevron-right" tone="muted" size="16" /></button>
      <button wx:if="{{item.plan && item.status !== 'eaten' && item.status !== 'skipped'}}" class="ew-hit-target meal-action-row" data-meal="{{item.mealType}}" bindtap="onAddMealToShoppingList" disabled="{{mutating}}">准备食材<ui-icon name="chevron-right" tone="muted" size="16" /></button>
      <button wx:if="{{!item.plan && (!item.actual || item.status === 'unrecorded')}}" class="ew-hit-target meal-action-row" data-meal="{{item.mealType}}" bindtap="onChooseRecipe" disabled="{{mutating}}">安排这一餐<ui-icon name="chevron-right" tone="muted" size="16" /></button>
    </view>
    <view wx:if="{{canRecord}}" class="meal-status-actions"><button wx:if="{{item.status !== 'eaten'}}" class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onRecordMeal" disabled="{{mutating}}">{{item.plan ? '这餐吃了' : '补记吃过的'}}</button><button wx:else class="ew-hit-target ew-link" data-meal="{{item.mealType}}" bindtap="onActualDifferent" disabled="{{mutating}}">更正记录</button><button wx:if="{{item.plan || (item.actual && item.status !== 'unrecorded')}}" class="ew-hit-target ew-link ew-muted" data-meal="{{item.mealType}}" bindtap="onMoreMeal" disabled="{{mutating}}">用餐状态</button></view>
  </view>
  <ui-sheet visible="{{!!sheetMode}}" title="{{sheetMeal.label + (sheetMode === 'adjust' ? ' · 调整菜单' : sheetMode === 'status' ? ' · 用餐状态' : ' · 更多')}}" busy="{{mutating}}" bind:close="closeMealSheet">
    <view class="meal-sheet-list">
      <block wx:if="{{sheetMode === 'adjust'}}"><button class="ew-hit-target meal-action-row" data-meal="{{sheetMeal.mealType}}" bindtap="onChooseRecipe">重新选菜<ui-icon name="chevron-right" tone="muted" size="16" /></button><button class="ew-hit-target meal-action-row" data-meal="{{sheetMeal.mealType}}" bindtap="onEditPlan">改人数 / 名称<ui-icon name="chevron-right" tone="muted" size="16" /></button></block>
      <block wx:elif="{{sheetMode === 'manage'}}"><button wx:if="{{sheetMeal.plan}}" class="ew-hit-target meal-action-row" data-meal="{{sheetMeal.mealType}}" bindtap="onCopy">复制到其他日期 / 餐次<ui-icon name="chevron-right" tone="muted" size="16" /></button><text wx:if="{{sheetMeal.plan}}" class="ew-muted sheet-explanation">原安排保留，实际记录不会随复制移动。</text><button wx:if="{{canRecord && sheetMeal.actual && sheetMeal.status !== 'unrecorded'}}" class="ew-hit-target meal-action-row" data-meal="{{sheetMeal.mealType}}" bindtap="onActualDifferent">查看或更正记录<ui-icon name="chevron-right" tone="muted" size="16" /></button><button wx:if="{{sheetMeal.plan}}" class="ew-hit-target meal-action-row danger-link" data-meal="{{sheetMeal.mealType}}" bindtap="onDeleteMeal">移除这餐安排</button></block>
      <block wx:elif="{{sheetMode === 'status' && canRecord}}"><text class="ew-muted sheet-explanation">未记录不代表没吃，可以不记录。</text><button wx:if="{{sheetMeal.plan && sheetMeal.status !== 'skipped'}}" class="ew-hit-target meal-action-row" data-meal="{{sheetMeal.mealType}}" bindtap="onSkip">这餐没吃</button><button class="ew-hit-target meal-action-row" data-meal="{{sheetMeal.mealType}}" bindtap="onActualDifferent">更正实际记录</button><button wx:if="{{sheetMeal.actual && sheetMeal.status !== 'unrecorded'}}" class="ew-hit-target meal-action-row" data-meal="{{sheetMeal.mealType}}" bindtap="onUndoActual">更正为未记录</button></block>
      <text wx:if="{{errorMessage}}" class="ew-error">{{errorMessage}}</text>
    </view>
  </ui-sheet>
  <ui-confirm visible="{{formVisible}}" title="{{formTitle}}" busy="{{mutating}}" confirm-label="{{formMode === 'copy' ? '复制安排' : formMode === 'actual' ? '记录饮食' : '保存到日历'}}" bind:cancel="closeForm" bind:confirm="saveForm">
    <block wx:if="{{formMode === 'plan'}}"><ui-field disabled="{{mutating}}" label="安排名称" value="{{formName}}" required bind:change="onName" /><ui-field disabled="{{mutating}}" label="用餐人数" type="number" maxlength="2" value="{{formPeople}}" bind:change="onPeople" /></block>
    <block wx:if="{{formMode === 'actual'}}"><text class="ew-label">实际吃过的菜品</text><textarea placeholder-class="ew-placeholder" disabled="{{mutating}}" adjust-position="{{false}}" class="ew-input" value="{{formActual}}" placeholder="每行一道菜，例如：番茄面" maxlength="3000" bindinput="onActualInput" /><text class="ew-muted">自由填写不会推测营养或菜品分类。</text></block>
    <block wx:if="{{formMode === 'copy'}}"><text class="ew-label">复制到</text><picker class="ew-hit-target" disabled="{{mutating || copyUnknown}}" mode="date" value="{{copyDate}}" bindchange="onCopyDate"><view class="ew-input">{{copyDate}}</view></picker><picker class="ew-hit-target" disabled="{{mutating || copyUnknown}}" range="{{copyMealOptions}}" value="{{copyMealIndex}}" bindchange="onCopyMeal"><view class="ew-input">{{copyMealOptions[copyMealIndex]}}</view></picker><text class="ew-muted">原安排保留，只复制菜单，不复制实际记录。</text></block><text wx:if="{{formError}}" class="ew-error">{{formError}}</text>
  </ui-confirm>
  <ui-confirm visible="{{actualVisible && actualQuick}}" title="这餐吃了" busy="{{actualBusy || actualLoading}}" confirm-label="确认记录" bind:cancel="closeMealActual" bind:confirm="onConfirmActual"><text class="ew-label">{{actualTitle}}</text><text class="ew-reading">{{actualText}}</text><text class="ew-muted">只记录这次实际吃过的内容。</text><text wx:if="{{actualError}}" class="ew-error">{{actualError}}</text><button class="ew-hit-target ew-link" disabled="{{actualBusy || actualLoading}}" bindtap="onActualAdjustment">有调整</button></ui-confirm><block wx:if="{{!actualQuick}}"><include src="../../templates/meal-actual-sheet.wxml" /></block>
</view>
