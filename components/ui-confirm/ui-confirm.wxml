<ui-sheet visible="{{visible}}" title="{{title}}" busy="{{busy}}" reduced-motion="{{reducedMotion}}" return-focus-id="{{returnFocusId}}" bind:close="cancel" bind:restorefocus="restoreFocus">
  <text wx:if="{{description}}" class="description">{{description}}</text>
  <view class="content"><slot /></view>
  <view slot="footer" class="actions"><button class="confirm-action {{busy ? 'is-disabled' : ''}} ew-hit-target cancel" disabled="{{busy}}" bindtap="cancel">取消</button><button class="confirm-action {{busy ? 'is-disabled' : ''}} ew-hit-target confirm" loading="{{busy}}" disabled="{{busy}}" bindtap="confirm">{{confirmLabel}}</button></view>
</ui-sheet>
