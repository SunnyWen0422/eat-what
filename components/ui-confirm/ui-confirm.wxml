<view wx:if="{{visible}}" class="ew-hit-target mask" style="bottom:{{keyboardHeight}}px" catchtap="cancel"><view class="ew-hit-target sheet" catchtap="noop"><text class="title">{{title}}</text><text class="description">{{description}}</text><scroll-view class="content" scroll-y><slot /></scroll-view><view class="actions"><button class="ew-hit-target cancel" disabled="{{busy}}" bindtap="cancel">取消</button><button class="ew-hit-target confirm" loading="{{busy}}" disabled="{{busy}}" bindtap="confirm">{{confirmLabel}}</button></view></view></view>
