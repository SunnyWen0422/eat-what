/* Generated token bindings; edit corresponding design/wxss template. */
@import "../../styles/component-theme.wxss";
.description { display:block; font-size:0.8125em; line-height:1.6; color:#56645B; margin:0 0 12px; overflow-wrap:anywhere; }
.content { min-width:0; }
.actions { display:flex; flex-wrap:wrap; gap:8px; min-width:0; }
.confirm-action { flex:1 1 120px; min-width:44px; min-height:48px; height:auto; margin:0; padding:12px; border:1px solid #7C8E80; border-radius:14px; font-size:1em; line-height:1.5; font-family:inherit; font-weight:500; white-space:normal; overflow-wrap:anywhere; box-sizing:border-box; }
.confirm-action::after { border:0; }
.cancel { background:#FFFFFF; color:#28634E; }
.confirm { background:#28634E; color:#FFFFFF; border-color:#28634E; }
.is-disabled { background:#E8EBE5; color:#56645B; border-color:#D9E1D5; }
