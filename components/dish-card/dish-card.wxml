<view class="card" bindtap="open"><image wx:if="{{dish.image && !imageFailed}}" class="image" src="{{dish.image}}" mode="aspectFill" binderror="fail" /><view wx:else class="placeholder">一份家常好味道</view><text class="name">{{dish.name}}</text><text class="description">{{dish.cookMinutes ? dish.cookMinutes + ' 分钟' : '查看食材与做法'}}</text><slot /></view>
