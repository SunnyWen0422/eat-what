@import "../../styles/theme.wxss";
.chip{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:44px;min-height:44px;padding:8px 12px;border:1px solid #D9E1D5;border-radius:10px;background:transparent;color:#28634E;font-size:0.928571em;line-height:1.5}.chip::after{border:0}.active{background:#EDF3ED;border-color:#28634E;font-weight:600}.chip[disabled]{color:#25332B;background:#E8EBE5}

:host { display:inline-block; }
button.chip { width:auto; max-width:100%; margin:0; background:#FFFFFF; border-color:#7C8E80; font-size:1em; }
button.chip.active { background:#EDF3ED; border-color:#28634E; }
