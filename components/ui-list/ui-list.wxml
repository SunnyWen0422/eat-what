<view class="list"><button class="{{(item.disabled) ? 'is-disabled' : ''}} ew-hit-target list-row" wx:for="{{items}}" wx:key="id" data-index="{{index}}" disabled="{{item.disabled}}" bindtap="open"><ui-icon wx:if="{{item.icon}}" name="{{item.icon}}" tone="muted" /><view class="copy"><text class="title">{{item.title}}</text><text wx:if="{{item.description}}" class="description">{{item.description}}</text></view><ui-icon wx:if="{{!item.disabled}}" name="chevron-right" tone="muted" size="18" /></button></view>
