:host { display:inline-flex; align-items:stretch; width:44px; min-height:44px; flex:0 0 44px; vertical-align:middle; }
.favorite-star { display:flex; align-items:center; justify-content:center; flex:1; width:44px; min-width:44px; max-width:44px; min-height:44px; margin:0; padding:0; border:1px solid transparent; border-radius:10px; background:#EDF3ED; line-height:1; box-sizing:border-box; }
.favorite-star::after { border:0; }
.favorite-star.is-favorite { background:#EDF3ED; }
.favorite-star.favorite-pressed { background:#E6EAE1; }
.favorite-star.is-busy { opacity:.6; }
