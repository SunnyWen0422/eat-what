/* Generated token bindings; edit corresponding design/wxss template. */
.card { background:#FFFFFF; border:1rpx solid #D9E1D5; border-radius:32rpx; padding:28rpx; margin-bottom:24rpx; } .heading { display:flex; align-items:center; justify-content:space-between; font-size:1em; font-weight:600; color:#25332B; } .status { font-size:0.75em; color:#56645B; font-weight:400; } .name { display:block; font-size:1.125em; font-weight:600; margin:24rpx 0 12rpx; color:#28634E; min-height:48rpx; } .description { display:block; font-size:0.8125em; color:#56645B; line-height:1.6; }

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }



.ew-placeholder { color:#56645B; }

.ew-hit-target { min-height:48px; }

/* Warm table v2: status plus content, one explicit navigation. */
.card { border:0; border-radius:18px; padding:16px; margin-bottom:12px; }
.heading { gap:12px; align-items:flex-start; }.meal-title { flex:1; }
.status { line-height:1.5; }.name { min-height:0; color:#25332B; margin:12px 0 8px; line-height:1.5; overflow-wrap:anywhere; }
.meal-link { padding:0; background:transparent; text-align:left; border:0; border-radius:0; }.meal-link::after { border:0; }
.description { font-size:1em; line-height:1.7; }

.card { background:rgba(255,255,255,0.66); border:1px solid rgba(255,255,255,0.74); border-radius:16px; box-shadow:0 5px 16px rgba(30,71,56,0.03); }

/* Calendar navigation belongs to the whole row, not a second filled CTA. */
.card.card-navigation { display:flex; align-items:center; justify-content:space-between; gap:16px; width:100%; max-width:100%; min-height:72px; margin:0 0 12px; padding:14px 16px; box-sizing:border-box; text-align:left; white-space:normal; font-family:inherit; font-size:1em; font-weight:400; line-height:1.5; color:#25332B; }
.card.card-navigation::after { border:0; }
.card-copy { flex:1; min-width:0; }
.card-navigation .heading { align-items:baseline; justify-content:flex-start; flex-wrap:wrap; gap:4px 12px; }
.card-navigation .meal-title { flex:0 0 auto; }
.card-navigation .name { margin:6px 0 0; font-size:1em; font-weight:400; }
.card-action { display:flex; align-items:center; flex:0 0 auto; gap:4px; color:#28634E; font-size:0.8125em; font-weight:400; background:transparent; }
.card-action-icon { flex:0 0 auto; }
