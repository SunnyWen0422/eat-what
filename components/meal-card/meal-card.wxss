/* Generated token bindings; edit corresponding design/wxss template. */
.card { background:#FFFFFF; border:1rpx solid #D9E1D5; border-radius:32rpx; padding:28rpx; margin-bottom:24rpx; } .heading { display:flex; align-items:center; justify-content:space-between; font-size:1em; font-weight:600; color:#25332B; } .status { font-size:0.857143em; color:#617066; font-weight:400; } .name { display:block; font-size:1.285714em; font-weight:600; margin:24rpx 0 12rpx; color:#28634E; min-height:48rpx; } .description { display:block; font-size:0.928571em; color:#617066; line-height:1.6; }

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:44px; min-height:44px; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:44px; min-height:48px; }

.ew-placeholder { color:#617066; }

button.ew-hit-target, .ew-page button.ew-hit-target { min-height:48px; }
