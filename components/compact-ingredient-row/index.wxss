/* Generated token bindings; edit corresponding design/wxss template. */
.ingredient-row { display:flex; align-items:center; min-height:52px; color:#25332B; }
.ingredient-control { display:flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; height:auto; padding:0; margin:0; border:0; background:transparent; border-radius:8px; font-family:inherit; font-size:inherit; font-weight:400; line-height:1.4; box-sizing:border-box; }
.ingredient-control::after { border:0; }
.ingredient-check,.ingredient-sources,.ingredient-remove { flex:0 0 44px; width:44px; }
.check-box { width:18px; height:18px; display:flex; align-items:center; justify-content:center; border:1px solid #7C8E80; border-radius:5px; }
.is-checked .check-box { background:#EDF3ED; border-color:#28634E; }
.ingredient-main { flex:1; min-width:0; gap:12px; padding:8px 0; text-align:left; justify-content:space-between; color:#25332B; }
.ingredient-name { flex:1; min-width:0; overflow-wrap:anywhere; font-size:.875em; line-height:1.45; }
.ingredient-quantity { flex:0 1 auto; max-width:45%; text-align:right; overflow-wrap:anywhere; font-size:.8125em; line-height:1.45; color:#56645B; }
.remove-disc { width:20px; height:20px; border-radius:50%; background:#A93B30; display:flex; align-items:center; justify-content:center; }
.remove-line { width:10px; height:2px; border-radius:1px; background:#fff; }
.ingredient-row .ingredient-control.ingredient-inactive { background:transparent; color:#25332B; opacity:1; }
