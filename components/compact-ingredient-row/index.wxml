<view class="ingredient-row {{checked ? 'is-checked' : ''}}">
  <button class="ingredient-control ingredient-check {{busy || deleting ? 'ingredient-inactive' : ''}}" disabled="{{busy || deleting}}" catchtap="onCheck" aria-role="checkbox" aria-checked="{{checked}}" aria-label="{{checked ? '移回待买：' : '标为已买：'}}{{rowView.name}}"><view class="check-box"><ui-icon wx:if="{{checked}}" name="check" size="14" /></view></button>
  <button class="ingredient-control ingredient-main {{busy || deleting ? 'ingredient-inactive' : ''}}" disabled="{{busy || deleting}}" catchtap="onEdit" aria-label="编辑{{rowView.name}}用量{{rowView.sourceCount > 1 ? '，先查看来源' : ''}}"><text class="ingredient-name">{{rowView.name}}</text><text wx:if="{{rowView.quantityLabel}}" class="ingredient-quantity">{{rowView.quantityLabel}}</text></button>
  <button wx:if="{{deleting}}" class="ingredient-control ingredient-remove" disabled="{{busy}}" catchtap="onRemove" aria-label="删除{{rowView.name}}"><view class="remove-disc"><view class="remove-line" /></view></button>
  <button wx:else class="ingredient-control ingredient-sources" disabled="{{busy}}" catchtap="onSources" aria-expanded="{{!!row.sourceExpanded}}" aria-label="{{row.sourceExpanded ? '收起' : '查看'}}{{rowView.name}}的来源"><ui-icon name="chevron-right" tone="muted" size="14" /></button>
</view>
