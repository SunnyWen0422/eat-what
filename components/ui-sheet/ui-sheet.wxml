<view wx:if="{{visible}}" class="ew-hit-target ew-mask" style="bottom:{{keyboardHeight}}px" bindtap="close"><view class="ew-hit-target ew-sheet" style="max-height:{{sheetHeight}}px" catchtap="stop" role="dialog" aria-modal="true" aria-label="{{title}}"><view class="ew-between"><text class="ew-title">{{title}}</text><ui-icon-button name="close" label="关闭面板" disabled="{{busy}}" bind:press="close" /></view><scroll-view scroll-y class="sheet-body" style="max-height:{{bodyHeight}}px"><slot /></scroll-view><slot name="footer" /></view></view>
