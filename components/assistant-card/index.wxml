<view class="assistant-card {{view.canConfirm ? 'card-confirmation' : ''}}">
 <text class="card-title">{{view.title}}</text>
 <text wx:if="{{view.targetLabel || view.peopleLabel}}" class="card-meta">{{view.targetLabel}}{{view.peopleLabel ? (view.targetLabel ? ' · ' : '') + view.peopleLabel : ''}}</text>
 <text wx:if="{{view.text}}" class="card-text">{{view.text}}</text>
 <checkbox-group wx:if="{{view.canSelect}}" bindchange="onSelection">
  <label wx:for="{{view.rows}}" wx:key="key" class="card-check-row"><checkbox value="{{item.sourceKey}}" checked="{{item.selected}}" disabled="{{busy || !active}}" color="#28634E" /><view class="card-name"><text class="card-name-text">{{item.name}}</text><text wx:if="{{item.quantityLabel}}" class="card-meta">{{item.quantityLabel}}</text></view></label>
 </checkbox-group>
 <block wx:else><view wx:for="{{view.rows}}" wx:key="key" class="card-row">
  <view class="card-dish-line"><button class="card-dish {{!item.url ? 'card-dish-disabled' : ''}}" disabled="{{!item.url}}" data-key="{{item.key}}" bindtap="onDish" aria-label="{{item.name}}">
   <image wx:if="{{item.image && !failedImages[item.key]}}" class="card-picture" src="{{item.image}}" mode="aspectFill" data-key="{{item.key}}" data-source="{{item.image}}" data-identity="{{item.mediaIdentity}}" binderror="onImageError" />
   <view wx:elif="{{view.type !== 'shopping_preview'}}" class="card-picture card-fallback"><ui-icon name="{{item.placeholderIcon}}" size="32" /></view>
   <view class="card-name"><text class="card-name-text">{{item.name}}</text><text wx:if="{{item.quantityLabel}}" class="card-meta">{{item.quantityLabel}}</text><text wx:if="{{item.priceLabel}}" class="card-meta">参考价 {{item.priceLabel}}</text></view>
   <ui-icon wx:if="{{item.url}}" name="chevron-right" size="16" tone="muted" />
  </button><view class="card-menu-controls" wx:if="{{item.dishId && item.url}}">
   <block wx:if="{{view.type === 'menu' && view.menuActions.current}}">
    <button wx:if="{{item.locked}}" class="card-menu-action" disabled="{{busy || !view.menuActions.enabled}}" data-dish-id="{{item.dishId}}" bindtap="onDishRelease" aria-label="取消本餐保留{{item.name}}">已保留</button>
    <button wx:else class="card-menu-action {{busy || !item.canReplace ? 'card-menu-disabled' : ''}}" disabled="{{busy || !item.canReplace}}" data-dish-id="{{item.dishId}}" bindtap="onDishReplace" aria-label="更换{{item.name}}">换一道</button>
   </block>
   <dish-favorite class="favorite-control" dish-id="{{item.dishId}}" dish-name="{{item.name}}" />
  </view></view>
  <text wx:for="{{item.ingredients}}" wx:for-item="ingredient" wx:key="index" class="card-meta">{{ingredient}}</text>
  <text wx:for="{{item.steps}}" wx:for-item="step" wx:key="index" class="card-text card-step">{{index+1}}. {{step}}</text>
 </view></block>
 <button wx:if="{{view.type === 'menu' && view.menuActions && !view.menuActions.enabled}}" class="card-menu-action card-action" bindtap="onCurrentMenu">{{view.menuActions.showCurrent ? '查看当前餐' : '查看当前餐或完成当前核对'}}</button>
 <button wx:for="{{view.facts}}" wx:key="key" class="card-dish" data-key="{{item.key}}" bindtap="onFact" disabled="{{!item.url}}"><view class="card-name"><text class="card-name-text">{{item.label}}</text><text class="card-meta">{{item.text}}</text></view><ui-icon wx:if="{{item.url}}" name="chevron-right" size="16" tone="muted" /></button>
 <view wx:if="{{active && view.canClarify}}" class="card-choices"><block wx:for="{{view.choices}}" wx:key="id"><picker class="card-choice-picker" wx:if="{{item.requiresDate}}" mode="date" disabled="{{busy}}" data-option-id="{{item.id}}" bindchange="onChoiceDate"><view class="card-choice">{{item.label}}</view></picker><button wx:else class="card-choice" disabled="{{busy}}" data-option-id="{{item.id}}" bindtap="onChoice">{{item.label}}</button></block></view>
 <text wx:if="{{view.expired}}" class="card-meta">这份预览已过期，请重新核对后再确认。</text>
 <ui-button class="card-action" wx:if="{{active && view.canHandoff}}" label="{{view.title}}" variant="secondary" disabled="{{busy}}" bind:action="onHandoff" />
 <ui-button class="card-action" wx:if="{{active && view.canConfirm}}" label="{{view.type === 'calendar_save' ? '确认保存计划' : '确认加入清单'}}" disabled="{{busy}}" bind:action="onConfirm" />
 <ui-button class="card-action" wx:if="{{active && view.expired && view.type === 'shopping_preview'}}" label="重新核对食材" variant="secondary" disabled="{{busy}}" bind:action="onRepreview" />
 <ui-button class="card-action" wx:if="{{view.url}}" label="{{view.actionLabel}}" variant="secondary" bind:action="onOpen" />
 <ui-button class="card-action" wx:if="{{active && view.canUndo}}" label="撤销这次草稿调整" variant="tertiary" disabled="{{busy}}" bind:action="onUndo" />
</view>
