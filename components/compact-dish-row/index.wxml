<view class="dish-row {{mode === 'read' ? 'is-reading' : ''}} {{compactSummary ? 'is-compact-summary' : ''}} {{prominent ? 'is-prominent' : ''}} {{fontScale >= 1.3 ? 'is-large-text' : ''}}" style="animation-duration:{{motionDuration}}ms;transition-duration:{{pressDuration}}ms">
  <button class="dish-main" style="transition-duration:{{pressDuration}}ms" bindtap="onView" aria-label="查看{{dishView.name}}的做法">
    <view class="dish-thumbnail" style="animation-duration:{{motionDuration}}ms">
      <image class="dish-image" wx:if="{{dishView.image && !imageFailed}}" src="{{dishView.image}}" data-source="{{dishView.image}}" data-identity="{{dishView.identity}}" mode="aspectFill" binderror="onImageError" lazy-load />
      <view wx:else class="dish-placeholder" aria-label="{{dishView.meta}}类别占位图"><ui-icon name="{{dishView.placeholderIcon || 'recipe'}}" size="28" /></view>
    </view>
    <view class="dish-copy"><text class="dish-name">{{dishView.name}}</text><view class="dish-summary"><text wx:if="{{feedback}}" class="dish-feedback" aria-live="polite">{{feedback}}</text><text wx:else class="dish-meta"><text class="dish-meta-full">{{compactSummary || fontScale >= 1.3 ? dishView.shortMeta : dishView.meta}}</text><text class="dish-meta-narrow">{{dishView.shortMeta}}</text></text><text wx:if="{{mode === 'read' && selected && !feedback}}" class="dish-selected">已加入</text></view></view>
  </button>
  <view class="dish-actions">
    <button wx:if="{{mode !== 'read'}}" class="{{(busy || disabled) ? 'is-disabled' : ''}} dish-replace" style="transition-duration:{{pressDuration}}ms" disabled="{{busy || disabled}}" loading="{{busy}}" catchtap="onReplace" aria-label="{{mode === 'select' ? (selectionContext === 'menu' ? (selected ? '取消选择' : '选入常用菜单') : (selected ? '查看本餐中的' : '加入本餐')) : (dish.locked ? '取消本餐保留' : '换一道')}}{{dishView.name}}"><ui-icon wx:if="{{compactSummary && fontScale >= 1.3 && mode === 'select'}}" name="{{selected ? 'check' : 'add'}}" size="20" /><text wx:else>{{mode === 'select' ? (selectionContext === 'menu' ? (selected ? '已选' : '选入') : (selected ? '已加入' : '加入')) : (dish.locked ? '已保留' : '换一道')}}</text></button>
    <dish-favorite class="favorite-control" dish-id="{{dishView.id}}" dish-name="{{dishView.name}}" bind:change="onFavoriteChange" />
  </view>
</view>
