/* Generated token bindings; edit corresponding design/wxss template. */
.dish-row { display:flex; flex-wrap:wrap; align-items:center; gap:8px; min-height:80px; min-width:0; padding:10px; margin:8px 0; box-sizing:border-box; background:rgba(255,255,255,0.66); border:1px solid rgba(255,255,255,0.74); border-radius:16px; box-shadow:0 5px 16px rgba(30,71,56,0.03); transition:background-color 100ms ease-out; font-size:inherit; }
.dish-row .dish-main { flex:1 1 160px; width:auto; display:flex; align-items:center; gap:12px; min-width:0; min-height:44px; padding:0; margin:0; border:0; background:transparent; color:#25332B; font-family:inherit; font-size:inherit; font-weight:400; line-height:1.5; text-align:left; box-sizing:border-box; }
.dish-thumbnail, .dish-image { width:56px; height:56px; border-radius:14px; }
.dish-thumbnail { flex:0 0 56px; overflow:hidden; background:#F5F6F0; animation:dish-appear 180ms ease-out; }
.dish-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#EDF3ED; }
.dish-copy { flex:1; min-width:0; }
.dish-name, .dish-meta, .dish-feedback { display:block; overflow-wrap:anywhere; }
.dish-name { font-size:1em; font-weight:600; line-height:1.5; }
.dish-meta { font-size:0.8125em; color:#56645B; line-height:1.5; margin-top:2px; }
.dish-feedback { color:#28634E; font-size:0.8125em; line-height:1.5; }
.dish-selected { color:#28634E; font-size:0.8125em; line-height:1.5; margin-left:auto; }
.dish-row .dish-replace { flex:0 1 auto; width:auto; min-width:44px; min-height:44px; margin:0 0 0 auto; padding:8px; border:1px solid #7C8E80; border-radius:10px; background:rgba(255,255,255,0.88); color:#28634E; font-family:inherit; font-size:0.8125em; font-weight:400; line-height:1.5; overflow-wrap:anywhere; box-sizing:border-box; }
.dish-replace.is-disabled { color:#56645B; background:transparent; }
.dish-main::after, .dish-replace::after { border:0; }
.dish-row:active { background:#EDF3ED; }
@keyframes dish-appear { from { opacity:0; } to { opacity:1; } }
