/* Generated token bindings; edit corresponding design/wxss template. */
.dish-row { display:flex; flex-wrap:wrap; align-items:center; gap:8px; min-height:80px; min-width:0; padding:8px 0; box-sizing:border-box; border-bottom:1px solid #E6EAE1; transition:background-color 100ms ease-out; font-size:inherit; }
.dish-main { flex:1 1 160px; display:flex; align-items:center; gap:12px; min-width:0; min-height:44px; padding:0; margin:0; border:0; background:transparent; color:#25332B; font-family:inherit; font-size:inherit; line-height:1.5; text-align:left; }
.dish-thumbnail, .dish-image { width:64px; height:64px; border-radius:14px; }
.dish-thumbnail { flex:0 0 64px; overflow:hidden; background:#F5F6F0; animation:dish-appear 180ms ease-out; }
.dish-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#EDF3ED; }
.dish-copy { flex:1; min-width:0; }
.dish-name, .dish-meta, .dish-feedback { display:block; overflow-wrap:anywhere; }
.dish-name { font-size:1em; font-weight:600; line-height:1.5; }
.dish-meta { font-size:0.8125em; color:#56645B; line-height:1.5; margin-top:2px; }
.dish-feedback { color:#28634E; font-size:0.8125em; line-height:1.5; }
.dish-selected { color:#28634E; font-size:0.8125em; line-height:1.5; margin-left:auto; }
.dish-replace { flex:0 1 auto; min-width:44px; min-height:44px; margin:0 0 0 auto; padding:8px 4px; border:0; border-radius:10px; background:transparent; color:#28634E; font-family:inherit; font-size:0.8125em; line-height:1.5; overflow-wrap:anywhere; }
.dish-replace.is-disabled { color:#56645B; background:transparent; }
.dish-main::after, .dish-replace::after { border:0; }
.dish-row:active { background:#EDF3ED; }
@keyframes dish-appear { from { opacity:0; } to { opacity:1; } }
