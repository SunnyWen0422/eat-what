<view class="field"><text class="label" aria-hidden="true">{{label}}{{required ? ' *' : ''}}</text><input aria-label="{{ariaLabel}}" placeholder-class="ew-placeholder" disabled="{{disabled}}" type="{{type}}" adjust-position="{{false}}" class="input {{error ? 'invalid' : ''}}" value="{{value}}" placeholder="{{placeholder}}" maxlength="{{maxlength}}" bindinput="input" /><text wx:if="{{error}}" id="{{resolvedErrorId}}" class="error" aria-hidden="true">{{error}}</text></view>
