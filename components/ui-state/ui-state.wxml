<view class="state {{kind}}" role="status" aria-live="polite"><image wx:if="{{illustration || kind === 'loading'}}" class="illustration" src="/assets/illustrations/{{illustration || 'agent-thinking'}}.png" mode="aspectFit" /><view wx:else class="symbol">{{kind === 'error' ? '!' : kind === 'auth' ? '↗' : '○'}}</view><text class="title">{{title}}</text><text class="description">{{description}}</text><button wx:if="{{actionLabel}}" class="action" bindtap="onAction">{{actionLabel}}</button></view>
