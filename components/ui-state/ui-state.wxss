@import "../../styles/theme.wxss";
.state{display:flex;flex-direction:column;align-items:center;gap:12px;padding:24px 16px;color:#56645B;text-align:center}.state.inline{flex-direction:row;flex-wrap:wrap;text-align:left;justify-content:flex-start;align-items:center;padding:16px 0}.state-content{min-width:0}.inline .state-content{flex:1}.title{display:block;font-size:1.142857em;line-height:1.5;font-weight:500;color:#25332B}.description{display:block;font-size:0.928571em;line-height:1.65;margin-top:4px}.illustration{width:96px;height:88px}.action{background:transparent;color:#28634E;font-size:1em;min-width:44px;min-height:44px;margin:0;padding:8px 12px;border:1px solid #D9E1D5;border-radius:10px;line-height:1.5}.action::after{border:0}.spinner{height:18px;width:18px;border:2px solid #D9E1D5;border-top-color:#28634E;border-radius:50%;flex-shrink:0;animation:state-spin 1s linear infinite}@keyframes state-spin{to{transform:rotate(360deg)}}.error .title{color:#A93B30}
