/* Generated token bindings; edit corresponding design/wxss template. */
@import "styles/theme.wxss";
/**app.wxss - 全局样式 **/

page {
  height: 100%;
  background-color: #FFFFFF;
  color: #25332B;
  font-size:14px;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 原生导航之外的可用窗口；操作栏占据真实高度，滚动区自动让位。 */
.mobile-screen {
  height: 100%;
  min-height: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: #F8F7F2;
}
.mobile-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}
.mobile-scroll-content {
  min-width: 0;
  padding:16px 16px 24px;
  box-sizing: border-box;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  padding:0;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius:14rpx;
  padding:24rpx;
  border: 1rpx solid #e3eeea;
}

/* 按钮重置 */
button::after { border: none; }
.btn-primary {
  background: #28634E;
  color: #FFFFFF;
  font-weight: 600;
  border-radius:14rpx;
}

/* 标签 */
.tag-green {
  font-size:0.857143em;
  padding:2rpx 12rpx;
  border-radius:10rpx;
  background: #EDF3ED;
  color: #28634E;
}

/* 骨架屏动画 */
@keyframes shimmer {
  from { background-position: -200% 0; }
  to { background-position: 200% 0; }
}
.skeleton {
  background: linear-gradient(90deg, #D9E1D5 25%, #F8F7F2 50%, #D9E1D5 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding:80rpx 40rpx;
}
.empty-icon { font-size:2.857097em; opacity: 0.5; margin-bottom:20rpx; }
.empty-title { font-size:1.142857em; font-weight: bold; color: #25332B; }
.empty-desc { font-size:0.857143em; color: #56645B; margin-top:10rpx; }

page{background:#F8F7F2;color:#25332B;font-size:14px}
.mobile-screen{background:#F8F7F2}
