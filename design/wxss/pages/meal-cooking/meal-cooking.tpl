@import "../../styles/theme.wxss";
.cooking-step{font-size:{{font.card.em}};line-height:1.8;min-height:120px;padding:{{space.4.px}} 0;white-space:pre-wrap;word-break:break-word;color:{{text}}}

@import "../../styles/workspace.wxss";
.ew-page{background:{{background}}}.ew-heading{margin-bottom:{{space.1.px}}}.ew-tabs{overflow-x:auto;flex-wrap:nowrap;margin:{{space.4.px}} 0}.ew-tabs button{flex:0 0 auto;max-width:240px;white-space:normal}.cooking-step{font-size:{{font.section.em}};line-height:1.75;margin:{{space.4.px}} 0;min-height:180px;word-break:break-word}.ew-card{padding:{{space.4.px}}}.ew-actions{margin-top:{{space.4.px}}}

.dish-switch-scroll { width:100%; min-width:0; }
.cooking-ingredients { padding:16px; margin-bottom:16px; border-radius:16px; background:{{card}}; border:1px solid {{border}}; }
.cooking-ingredients text { display:block; white-space:pre-wrap; overflow-wrap:anywhere; margin-bottom:8px; }
.cooking-page .ew-actions { display:flex; flex-wrap:wrap; gap:12px; }
.cooking-page .ew-actions > ui-button { flex:1 1 120px; min-width:0; }
