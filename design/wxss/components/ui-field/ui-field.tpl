.field { margin:24rpx 0; } .label { display:block; font-size:1.0em; font-weight:600; color:{{text}}; margin-bottom:12rpx; } .input { min-height:44px; padding:20rpx 24rpx; box-sizing:border-box; width:100%; background:#f5f6f0; border:1rpx solid #d9e1d5; border-radius:20rpx; font-size:1.0714em; } .error { color:{{danger}}; font-size:0.9286em; margin-top:12rpx; display:block; } .invalid { border-color:{{danger}}; }
