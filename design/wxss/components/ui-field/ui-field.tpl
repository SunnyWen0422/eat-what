.field { margin:{{space.2.rpx}} 0; } .label { display:block; font-size:{{font.body.em}}; font-weight:600; color:{{text}}; margin-bottom:{{space.0.rpx*1.5}}; } .input { min-height:{{controls.touchSize.px}}; padding:{{space.1.rpx*1.25}} {{space.2.rpx}}; box-sizing:border-box; width:100%; background:#f5f6f0; border:1rpx solid #d9e1d5; border-radius:{{radius.1.rpx}}; font-size:{{font.body.em}}; } .error { color:{{danger}}; font-size:{{font.secondary.em}}; margin-top:{{space.0.rpx*1.5}}; display:block; } .invalid { border-color:{{danger}}; }

/* Fixed CSS pixels protect the actual event node at the 320px baseline. */
.ew-hit-target, .ew-page .ew-hit-target { min-width:{{controls.touchSize.px}}; min-height:{{controls.touchSize.px}}; box-sizing:border-box; }
text.ew-hit-target { display:inline-flex; align-items:center; justify-content:center; }
picker.ew-hit-target { display:block; }
button { min-width:{{controls.touchSize.px}}; min-height:{{controls.primaryHeight.px}}; }

.ew-placeholder { color:{{muted}}; }

button.ew-hit-target, .ew-page button.ew-hit-target { min-height:{{controls.primaryHeight.px}}; }
