.card { background:{{card}}; border:1rpx solid {{border}}; border-radius:32rpx; padding:28rpx; margin-bottom:24rpx; } .heading { display:flex; align-items:center; justify-content:space-between; font-size:1.0714em; font-weight:600; color:{{text}}; } .status { font-size:0.8571em; color:{{muted}}; font-weight:400; } .name { display:block; font-size:1.2143em; font-weight:600; margin:24rpx 0 12rpx; color:{{brand}}; min-height:48rpx; } .description { display:block; font-size:0.9286em; color:{{muted}}; line-height:1.6; }
