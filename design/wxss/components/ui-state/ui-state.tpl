.state { text-align:center; padding:64rpx 32rpx; color:{{muted}}; } .symbol { font-size:2.1429em; color:{{brand}}; margin-bottom:24rpx; } .title { display:block; color:{{text}}; font-size:1.1429em; font-weight:600; } .description { display:block; margin:16rpx 0; font-size:0.9286em; line-height:1.6; } .action { background:{{brandSoft}}; color:{{brand}}; min-height:44px; border-radius:24rpx; font-size:1.0em; margin-top:24rpx; } .action::after { border:0; } .error .symbol { color:{{danger}}; }

.illustration{width:160px;height:145px;display:block;margin:0 auto 16px}
