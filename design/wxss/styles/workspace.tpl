/* Shared current-meal view for Today, result and assistant routes. */
.workspace-screen{background:{{background}}}.workspace-context{flex-wrap:wrap;margin:{{space.4.px}} 0;gap:{{space.1.px}}}.workspace-context button{margin:0;font-size:{{font.body.em}}}.workspace-requirements{min-height:96px;height:96px;font-size:{{font.body.em}};margin-top:{{space.2.px}}}.workspace-dish{padding:{{space.2.px}} 0;border-bottom:1px solid #D9E1D5}.workspace-dish-title{display:flex;align-items:center;gap:{{space.2.px}};width:100%;text-align:left;background:white;font-size:{{font.card.em}};margin:0 0 {{space.1.px}};padding:{{space.1.px}} 0;line-height:1.5}.workspace-success{width:140px;height:125px;display:block;margin:auto}.workspace-screen .ew-heading{font-size:{{font.page.em}}}.workspace-screen .ew-subtitle,.workspace-screen .ew-muted{font-size:{{font.secondary.em}}}.workspace-screen .ew-error,.workspace-screen .ew-notice{font-size:{{font.secondary.em}}}.workspace-screen .mobile-scroll-content{padding-bottom:{{space.6.px}}}.workspace-screen .ew-pill{padding:0 {{space.2.px}}}.workspace-screen .ew-bottom{flex-shrink:0}.workspace-screen textarea{box-sizing:border-box}
@media(max-width:360px){.workspace-context{gap:{{space.0.px}}}.workspace-context .ew-pill{padding:0 {{space.1.px}}}.workspace-dish .ew-row{flex-wrap:wrap}.workspace-screen .mobile-scroll-content{padding:{{space.2.px}}}}
