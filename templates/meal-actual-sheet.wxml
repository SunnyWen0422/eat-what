<ui-sheet visible="{{actualVisible}}" title="记录饮食" busy="{{actualBusy}}" bind:close="closeMealActual">
  <text class="ew-label">{{actualTitle}}</text>
  <text class="ew-muted">只记录实际吃过的内容，用于饮食回顾；保存计划不会计入。</text>
  <view wx:if="{{actualPlanNames}}" class="actual-plan"><text class="ew-label">本餐安排</text><text class="ew-reading">{{actualPlanNames}}</text></view>
  <view wx:if="{{actualPlanChanged}}" class="ew-error">之前显示：{{actualOriginalPlanNames || '原版本'}}。安排已变化，请核对后记录。</view>
  <view wx:if="{{actualError}}" class="ew-notice">{{actualError}}</view>
  <ui-state wx:if="{{actualLoading}}" kind="loading" density="inline" title="正在核对这一餐" />
  <block wx:elif="{{actualUnknown}}"><ui-button label="确认刚才是否保存成功" loading="{{actualBusy}}" bind:action="onActualRetry" /></block>
  <block wx:else>
    <ui-button wx:if="{{actualNeedsReload}}" label="核对最新记录 · 保留输入" variant="secondary" bind:action="onActualReload" />
    <view class="actual-choices">
      <button wx:if="{{actualHasPlan}}" class="ew-hit-target actual-choice {{actualMode === 'byPlan' ? 'selected' : ''}}" data-mode="byPlan" disabled="{{actualBusy || actualPlanChanged || !actualCanRecord}}" bindtap="onActualMode">按这份计划吃了</button>
      <button class="ew-hit-target actual-choice {{actualMode === 'changed' ? 'selected' : ''}}" data-mode="changed" disabled="{{actualBusy || !actualCanRecord}}" bindtap="onActualMode">实际有变化 / 外食</button>
      <button wx:if="{{actualHasPlan}}" class="ew-hit-target actual-choice {{actualMode === 'skipped' ? 'selected' : ''}}" data-mode="skipped" disabled="{{actualBusy}}" bindtap="onActualMode">没按这份计划做</button>
    </view>
    <ui-field wx:if="{{actualMode === 'changed'}}" label="实际吃过的菜品 / 外食" value="{{actualText}}" maxlength="2000" disabled="{{actualBusy || !actualCanRecord}}" bind:change="onActualText" />
    <text wx:if="{{!actualCanRecord}}" class="ew-muted">未来餐次不能提前记录吃过。</text>
  </block>
  <ui-button wx:if="{{!actualLoading && !actualUnknown}}" slot="footer" label="{{actualMode === 'skipped' ? '确认未按计划' : '记录饮食'}}" loading="{{actualBusy}}" disabled="{{actualBusy || actualNeedsReload || (!actualCanRecord && actualMode !== 'skipped') || (actualMode === 'byPlan' && actualPlanChanged)}}" bind:action="onConfirmActual" />
</ui-sheet>
