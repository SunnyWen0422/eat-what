<view class="ew-page ew-dish-surface mobile-screen workspace-screen {{fontScale >= 1.3 ? 'is-large-text' : ''}} mode-{{mode}}" style="font-size:{{fontBase * fontScale}}px">
  <scroll-view class="mobile-scroll" scroll-y enhanced>
    <view class="mobile-scroll-content">
      <view class="workspace-header"><view class="workspace-date" aria-label="{{contextLabel}}"><ui-icon name="calendar" tone="muted" size="16" /><text>{{dateLabel}}</text></view><view class="workspace-title-actions"><button class="ew-hit-target workspace-shopping" bindtap="onOpenShoppingList"><ui-icon name="shopping-basket" size="20" /><text>清单</text></button><button class="ew-hit-target workspace-more" disabled="{{busy}}" bindtap="onToggleExtraActions" aria-label="更多餐单操作"><ui-icon name="more" tone="muted" size="22" /></button></view></view>
      <view class="workspace-title-row"><view class="ew-heading ew-page-title">{{pageTitle}}</view><view class="workspace-title-actions"><button wx:if="{{assistantAvailable}}" class="ew-hit-target workspace-assistant" disabled="{{loading || busy}}" hover-class="workspace-assistant-pressed" bindtap="onOpenConnectedAssistant" aria-label="饮食助手 · {{mealName}}"><view class="workspace-assistant-face"><ui-icon name="agent-spark" size="16" /><text class="workspace-assistant-label">饮食助手</text></view></button></view></view>
      <view class="workspace-meals" aria-label="选择餐次"><button wx:for="{{mealLabels}}" wx:key="*this" class="workspace-meal {{mealIndex === index ? 'is-active' : ''}}" disabled="{{loading || busy}}" aria-pressed="{{mealIndex === index}}" data-index="{{index}}" bindtap="onMealTab">{{item}}</button></view>
      <meal-composition-summary people="{{context.people}}" summary="{{compositionLabel}}" font-scale="{{fontScale}}" busy="{{loading || contextLocked || compositionSaving}}" bind:people="onOpenPeople" bind:composition="onOpenComposition" />
      <view wx:if="{{peopleError}}" class="ew-error" role="alert">{{peopleError}}</view>
      <view wx:if="{{context.date !== todayDate}}" class="workspace-other-day"><text>正在安排{{dateLabel}}</text><button class="ew-hit-target workspace-return-today" disabled="{{busy}}" bindtap="onReturnToday" aria-label="回到今天"><ui-icon name="arrow-left" size="22" /></button></view>
      <ui-state wx:if="{{loading}}" kind="loading" density="inline" title="正在读取这一餐" />
      <block wx:else>
        <view wx:if="{{resultNotice && (!journeyRecovery || journeyRecovery.state !== 'unapplied')}}" class="workspace-notice {{resultNotice.kind}}" aria-role="{{resultNotice.kind === 'error' ? 'alert' : 'status'}}">
          <text>{{resultNotice.text}}</text>
          <button wx:if="{{workspaceNotice.action === 'composition'}}" class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onOpenComposition">调整搭配</button>
          <button wx:if="{{workspaceNotice.action === 'requirements'}}" class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onOpenRequirements">补充要求</button>
          <button wx:if="{{workspaceNotice.action === 'choose'}}" class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onChooseDishes">自己选菜</button>
          <button wx:if="{{savedTarget}}" class="ew-hit-target ew-link" bindtap="onViewSavedMeal">查看这餐</button>
        </view>
        <ui-button wx:if="{{conflictDraftAvailable}}" label="重新应用保留的输入" variant="secondary" bind:action="onRestoreLocalDraft" />
        <ui-button wx:if="{{suggestedTarget}}" label="切换到 {{suggestedTarget.date}} {{suggestedMealLabel}} 并安排" variant="secondary" bind:action="onSuggestedTarget" />
        <view wx:if="{{conversationNotice && !workspaceNotice}}" class="ew-notice" aria-role="status">{{conversationNotice}}</view>
        <view wx:if="{{compositionPreferenceNotice && !workspaceNotice}}" class="ew-notice" aria-role="status">{{compositionPreferenceNotice}}</view>
        <view wx:if="{{hardExclusionsUnavailable}}" class="workspace-exclusions" role="alert">{{hardExclusionSummary}}</view>
        <text wx:if="{{hasHardExclusions}}" class="workspace-exclusions">{{hardExclusionSummary}}</text>
        <view class="workspace-meal-tools"><button class="ew-hit-target workspace-tool" disabled="{{contextLocked}}" bindtap="onOpenFilter" aria-label="{{filterSummary ? '个性化，' + filterSummary : '个性化'}}"><ui-icon name="filter" tone="muted" size="16" /><text>个性化</text><view wx:if="{{filterSummary}}" class="workspace-filter-dot" /></button><button class="ew-hit-target workspace-tool" disabled="{{contextLocked}}" bindtap="onChooseDishes"><ui-icon name="recipes" tone="muted" size="16" /><text>自己选菜</text></button><button class="ew-hit-target workspace-time-button" disabled="{{contextLocked}}" bindtap="onOpenMealSettings" aria-label="用时与食材"><view class="workspace-alarm"><ui-icon name="clock" size="20" /></view></button></view>
        <view wx:if="{{midnightNotice}}" class="ew-notice" role="status">{{midnightNotice}}</view>
        <view wx:if="{{!draft.dishes.length && status === 'empty' && !errorMessage}}" class="workspace-empty"><ui-icon name="servings" size="40" /><text class="workspace-empty-title">不用费心，直接生成这一餐</text><text class="ew-muted">默认已配好，也可以自己调整</text></view>

        <view wx:if="{{draft.dishes.length}}" class="workspace-menu-section menu-state-{{menuState}}">
          <view class="workspace-menu-heading"><button class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onRegenerate"><ui-icon name="refresh" size="16" /><text>换一套</text></button></view>
          <view class="workspace-menu">
            <compact-dish-row class="workspace-recipe-row" mode="{{displayedSavedRecord ? 'read' : 'workspace'}}" prominent="{{true}}" font-scale="{{fontScale}}" wx:for="{{draft.dishes}}" wx:key="id" dish="{{item}}" busy="{{item.actionBusy}}" disabled="{{busy || contextLocked}}" feedback="{{item.actionMessage || ''}}" bind:view="onDishOpen" bind:replace="onReplace" bind:feedback="onDishFeedback" />
          </view>
          <view class="workspace-menu-footer"><text wx:if="{{draft.totalCookMinutes}}" class="ew-muted">已知用时约 {{draft.totalCookMinutes}} 分钟 · 依次制作</text><button wx:if="{{showMenuUndo}}" class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onUndo" aria-label="撤销最近一次菜单修改">撤销换菜</button></view>
          <view wx:if="{{draft.explanations.length}}" class="workspace-reasons"><text wx:for="{{draft.explanations}}" wx:key="*this" class="ew-muted">{{item}}</text></view>
        </view>

        <action-feedback wx:if="{{showActionFeedback}}" feedback="{{actionFeedback}}" busy="{{busy || contextLocked}}" bind:undo="onUndo" />
        <view wx:if="{{linkedPlan}}" class="workspace-next"><button class="ew-hit-target workspace-next-row" bindtap="onShoppingPreview"><ui-icon name="shopping-basket" tone="muted" size="20" /><text class="ew-title">准备食材</text><ui-icon name="chevron-right" tone="muted" size="16" /></button><button class="ew-hit-target workspace-next-row" bindtap="onViewPlan"><ui-icon name="check" tone="muted" size="20" /><text class="ew-title">查看这餐记录</text><ui-icon name="chevron-right" tone="muted" size="16" /></button></view>
        <view wx:if="{{linkedPlan}}" class="workspace-light-actions"><button class="ew-hit-target ew-link" bindtap="onReview">饮食回顾</button></view>

      </block>
    </view>
  </scroll-view>
  <view class="ew-bottom"><ui-button class="workspace-primary-control" label="{{primaryLabel}}" loading="{{busy}}" disabled="{{primaryDisabled || loading}}" bind:action="onPrimaryAction" /></view>
  <ui-sheet visible="{{moreVisible}}" title="餐单操作" busy="{{busy}}" bind:close="onCloseMore">
    <view class="workspace-more-list">
      <picker class="workspace-menu-picker" mode="date" disabled="{{loading || busy}}" value="{{context.date}}" bindchange="onDateTarget" aria-label="安排日期，{{context.date}}"><view class="ew-menu-row"><text class="ew-menu-label">安排日期</text><text class="ew-menu-value">{{context.date}}</text><ui-icon name="chevron-right" tone="muted" size="16" /></view></picker>
      <button class="ew-hit-target ew-menu-row" disabled="{{contextLocked}}" bindtap="onOpenMealSettings"><text class="ew-menu-label">用时与已有食材</text><ui-icon name="chevron-right" tone="muted" size="16" /></button>
      <button wx:if="{{context.requirements}}" class="ew-hit-target ew-menu-row" disabled="{{contextLocked}}" bindtap="onOpenRequirements"><text class="ew-menu-label">本餐要求</text><text class="ew-menu-value">查看与修改</text><ui-icon name="chevron-right" tone="muted" size="16" /></button>
      <button class="ew-hit-target ew-menu-row" disabled="{{contextLocked}}" bindtap="onOpenLongTermPreferences"><text class="ew-menu-label">长期口味偏好</text><ui-icon name="chevron-right" tone="muted" size="16" /></button>
      <button class="ew-hit-target ew-menu-row" disabled="{{busy || !draft.dishes.length}}" bindtap="onSaveReusableMenu"><text class="ew-menu-label">存为常用菜单</text><ui-icon name="chevron-right" tone="muted" size="16" /></button>
      <button class="ew-hit-target ew-menu-row" disabled="{{busy}}" bindtap="onOpenAdvancedAssistant"><text class="ew-menu-label">助手历史</text><ui-icon name="chevron-right" tone="muted" size="16" /></button>
    </view>
  </ui-sheet>
  <ui-sheet visible="{{peopleVisible}}" title="用餐人数" busy="{{busy}}" bind:close="onClosePeople">
    <view class="workspace-people"><view class="workspace-stepper"><button class="ew-hit-target ew-link" aria-label="减少一人" disabled="{{loading || contextLocked || context.people <= 1}}" data-delta="-1" bindtap="onPeopleStep">−</button><input class="workspace-people-input" aria-label="用餐人数，1 至 50 人" type="number" value="{{peopleInput}}" disabled="{{loading || contextLocked}}" bindinput="onPeopleInput" /><text>人</text><button class="ew-hit-target ew-link" aria-label="增加一人" disabled="{{loading || contextLocked || context.people >= 50}}" data-delta="1" bindtap="onPeopleStep">+</button></view></view>
    <view wx:if="{{peopleError}}" class="ew-error" role="alert">{{peopleError}}</view><ui-button slot="footer" label="完成" disabled="{{peopleError}}" bind:action="onClosePeople" />
  </ui-sheet>
  <ui-sheet visible="{{compositionVisible}}" title="本餐搭配" busy="{{compositionSaving || busy}}" bind:close="onCloseComposition">
    <view class="workspace-composition-presets"><button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" data-id="one-meat-two-veg" bindtap="onCompositionPreset">一荤两素</button><button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" data-id="two-meat-one-veg" bindtap="onCompositionPreset">两荤一素</button><button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" data-id="one-meat-one-veg-soup" bindtap="onCompositionPreset">一荤一素一汤</button></view>
    <view class="workspace-composition-row" wx:for="{{compositionRows}}" wx:key="type"><text>{{item.label}}</text><view class="workspace-stepper"><button class="ew-hit-target ew-link" aria-label="减少一道{{item.label}}" disabled="{{compositionSaving || contextLocked || item.minusDisabled}}" data-type="{{item.type}}" data-delta="-1" bindtap="onCompositionStep">−</button><input class="workspace-people-input" aria-label="{{item.label}}数量，0 至 10 道" type="number" value="{{item.count}}" disabled="{{compositionSaving || contextLocked}}" data-type="{{item.type}}" bindinput="onCompositionInput" /><button class="ew-hit-target ew-link" aria-label="增加一道{{item.label}}" disabled="{{compositionSaving || contextLocked || item.plusDisabled}}" data-type="{{item.type}}" data-delta="1" bindtap="onCompositionStep">+</button></view></view>
    <button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" bindtap="onCompositionAuto">恢复按人数自动搭配</button>
    <view wx:if="{{compositionHint || errorMessage}}" class="ew-error" role="alert">{{compositionHint || errorMessage}}</view>
    <ui-button wx:if="{{syncStatus === 'unknown' || syncStatus === 'offline' || syncStatus === 'conflict'}}" label="{{primaryLabel}}" variant="secondary" disabled="{{busy}}" bind:action="onPrimaryAction" />
    <text class="ew-muted">应用后保留此搭配</text>
    <ui-button slot="footer" label="应用搭配" loading="{{compositionSaving}}" disabled="{{compositionApplyDisabled || compositionSaving || contextLocked || peopleError}}" bind:action="onApplyComposition" />
  </ui-sheet>
  <ui-sheet visible="{{requirementsVisible}}" title="本餐要求（选填）" busy="{{voicePhase !== 'idle' || requirementsSaving}}" bind:close="onCancelRequirements">
    <text wx:if="{{hasHardExclusions || hardExclusionsUnavailable}}" class="ew-muted">{{hardExclusionSummary}}</text>
    <textarea class="ew-input workspace-requirements" placeholder-class="ew-placeholder" aria-label="本餐要求（选填）" value="{{requirementsDraft}}" maxlength="2000" placeholder="口味、忌口，或你想保留的菜" bindinput="onRequirementsDraftInput" adjust-position cursor-spacing="24" />
    <view wx:if="{{errorMessage}}" class="ew-notice">{{errorMessage}}</view><view class="ew-actions"><ui-button label="清空本餐要求" variant="tertiary" disabled="{{requirementsSaving}}" bind:action="onClearRequirements" /><ui-button label="继续本餐对话" variant="secondary" disabled="{{contextLocked || requirementsSaving}}" bind:action="onContinueMealConversation" /></view>
    <ui-button slot="footer" label="应用本餐要求" loading="{{requirementsSaving}}" disabled="{{voicePhase !== 'idle' || requirementsSaving || contextLocked}}" bind:action="onApplyRequirements" />
  </ui-sheet>
  <ui-sheet visible="{{settingsVisible}}" title="本餐设置" busy="{{busy}}" bind:close="onCloseMealSettings">
    <ui-field label="{{recommendationPolicyEnabled ? '整餐期望用时（分钟，可留空）' : '整餐用时上限（分钟，可留空）'}}" value="{{recommendationPolicyEnabled ? (settingsContext.expectedTotalCookMinutes || '') : (settingsContext.totalCookMinutes || '')}}" type="number" bind:change="onTimeSetting" />
    <ui-field wx:if="{{recommendationPolicyEnabled && showRequiredTime}}" label="整餐必须在几分钟内（清空可取消）" value="{{settingsContext.totalCookMinutes || ''}}" type="number" bind:change="onRequiredTimeSetting" />
    <ui-field label="已有食材（用顿号分隔）" value="{{ownedText}}" bind:change="onOwnedSetting" />
    <view wx:if="{{settingsError}}" class="ew-error">{{settingsError}}</view><ui-button slot="footer" label="应用本餐设置" bind:action="onApplyMealSettings" />
  </ui-sheet>
  <ui-sheet visible="{{confirmationVisible}}" title="{{confirmationTitle}}" busy="{{busy}}" bind:close="onCloseConfirmation">
    <text class="ew-title">当前菜单 · {{savePeople}} 人</text><text class="ew-reading">{{saveDishSummary}}</text>
    <text class="ew-muted">保存即记录，未来菜单到当天计入回顾</text>
    <text class="ew-title">{{saveDateLabel}}</text><text wx:if="{{saveCrossDayNotice}}" class="ew-muted">{{saveCrossDayNotice}}</text><text class="ew-reading">{{confirmationText}}</text>
    <view wx:if="{{saveTargetLoading}}" class="ew-notice" role="status">正在核对目标安排…</view><view wx:if="{{saveError}}" class="ew-error" role="alert">{{saveError}}</view>
    <ui-button wx:if="{{saveRecoveryPending}}" label="继续完成保存" variant="secondary" disabled="{{busy}}" bind:action="onRetryWorkspace" />
    <ui-button wx:if="{{saveError && !saveRecoveryPending}}" label="重新读取这餐" variant="secondary" disabled="{{busy || saveTargetLoading}}" bind:action="onRefreshSaveTarget" />
    <ui-button slot="footer" label="{{confirmationLabel}}" loading="{{busy}}" disabled="{{busy || saveTargetLocked || saveTargetLoading || saveError || peopleError}}" bind:action="onApproveReplacement" />
  </ui-sheet>
</view>
