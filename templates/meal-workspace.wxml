<view class="ew-page mobile-screen workspace-screen mode-{{mode}}" style="font-size:{{fontBase * fontScale}}px">
  <scroll-view class="mobile-scroll" scroll-y enhanced>
    <view class="mobile-scroll-content">
      <view class="workspace-header"><view class="ew-heading">{{pageTitle}}</view><button class="ew-hit-target ew-link" bindtap="onOpenShoppingList"><ui-icon name="shopping-basket" size="20" /><text>清单</text></button></view>
      <view class="workspace-target">
        <picker class="ew-hit-target workspace-target-field target-date" mode="date" disabled="{{loading || busy}}" value="{{context.date}}" bindchange="onDateTarget"><view class="target-control"><text class="target-label">用餐日期</text><view class="target-value"><text>{{dateLabel}}</text><ui-icon name="chevron-right" tone="muted" size="14" /></view></view></picker>
        <picker class="ew-hit-target workspace-target-field" range="{{mealLabels}}" disabled="{{loading || busy}}" value="{{mealIndex}}" bindchange="onMealTarget"><view class="target-control"><text class="target-label">餐次</text><view class="target-value"><text>{{mealName}}</text><ui-icon name="chevron-right" tone="muted" size="14" /></view></view></picker>
      </view>
      <meal-composition-summary people="{{context.people}}" summary="{{compositionModeLabel + ' · ' + compositionLabel}}" busy="{{loading || contextLocked || compositionSaving}}" bind:people="onOpenPeople" bind:composition="onOpenComposition" />
      <view wx:if="{{peopleError}}" class="ew-error" role="alert">{{peopleError}}</view>
      <button wx:if="{{context.date !== todayDate}}" class="ew-hit-target ew-link ew-text-link" disabled="{{busy}}" bindtap="onReturnToday">回到今天</button>
      <ui-state wx:if="{{loading}}" kind="loading" density="inline" title="正在读取这一餐" />
      <block wx:else>
        <view wx:if="{{syncStatus !== 'synced' || feedbackNotice}}" class="workspace-feedback"><view class="ew-notice">{{syncLabel || feedbackNotice}}</view><ui-button wx:if="{{syncStatus === 'conflict'}}" label="核对最新内容" variant="tertiary" disabled="{{busy}}" bind:action="onLoadLatest" /></view>
        <view wx:if="{{errorMessage && !requirementsVisible}}" class="ew-error" role="alert">{{errorMessage}}</view>
        <ui-button wx:if="{{conflictDraftAvailable}}" label="重新应用保留的输入" variant="secondary" bind:action="onRestoreLocalDraft" />
        <ui-state wx:if="{{status === 'generating'}}" kind="loading" density="inline" title="正在安排这餐" description="{{taskMessage}}" />
        <ui-button wx:if="{{suggestedTarget}}" label="切换到 {{suggestedTarget.date}} {{suggestedMealLabel}} 并安排" variant="secondary" bind:action="onSuggestedTarget" />
        <view wx:if="{{conditionsNotice}}" class="ew-notice" role="status">{{conditionsNotice}}。当前菜单仍保留，按新条件换一套后生效。</view>
        <view wx:if="{{status === 'needs_input' || status === 'needs_regeneration'}}" class="ew-notice">{{taskMessage}}</view>
        <view wx:if="{{generationLimitNotice}}" class="ew-notice" role="status">{{generationLimitNotice}}</view>
        <view wx:if="{{conversationNotice}}" class="ew-notice" role="status">{{conversationNotice}}</view>
        <view wx:if="{{missingCompositionLabel || compositionUnknownNotice}}" class="workspace-shortage" role="status"><text>{{missingCompositionLabel || compositionUnknownNotice}}</text><text class="ew-muted">原菜单仍保留，长期忌口继续生效。</text><button class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onOpenComposition">调整搭配</button></view>
        <view wx:if="{{compositionPreferenceNotice}}" class="ew-notice" role="status">{{compositionPreferenceNotice}}</view>
        <view wx:if="{{hasHardExclusions || hardExclusionsUnavailable}}" class="workspace-exclusions"><text>{{hardExclusionSummary}}</text></view>
        <button class="ew-hit-target workspace-requirements-entry" disabled="{{contextLocked}}" bindtap="onOpenRequirements"><view><text class="ew-title">本餐要求（选填）</text><text class="ew-muted">{{context.requirements || '不填也可以直接生成菜单'}}</text></view><ui-icon name="chevron-right" tone="muted" size="18" /></button>
        <view class="workspace-light-actions workspace-optional-actions"><button class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onOpenFilter">本次筛选{{filterSummary ? ' · ' + filterSummary : ''}}</button><button class="ew-hit-target ew-link" disabled="{{busy}}" bindtap="onToggleAdvanced">{{advancedVisible ? '收起更多设置' : '更多设置'}}</button><button class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onChooseDishes">自己选菜</button></view>
        <view wx:if="{{advancedVisible}}" class="workspace-advanced"><text class="ew-muted">{{compositionLabel || '自动搭配'}}{{context.totalCookMinutes ? ' · 用时上限 ' + context.totalCookMinutes + ' 分钟' : ''}}</text><view class="workspace-light-actions"><button class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onOpenMealSettings">用时与已有食材</button></view></view>
        <view wx:if="{{midnightNotice}}" class="ew-notice" role="status">{{midnightNotice}}</view>
        <view wx:if="{{draft.dishes.length}}" class="workspace-summary"><text class="ew-chip">{{compositionLabel || '本餐搭配'}}</text><text wx:if="{{saveState === 'saved'}}" class="ew-chip">已保存到日历</text><text wx:if="{{saveState === 'changed'}}" class="ew-chip">草稿已调整</text></view>
        <view wx:if="{{savedTarget}}" class="workspace-saved-result" role="status"><text>{{savedMessage}}</text><text wx:if="{{saveState === 'changed'}}" class="ew-muted">当前草稿已调整，日历中的安排仍保留。</text><button class="ew-hit-target ew-link" bindtap="onViewSavedMeal">查看这餐</button><button wx:if="{{canConfirm}}" class="ew-hit-target ew-link" disabled="{{busy}}" bindtap="onConfirmPlan">另存到日历</button></view>
        <view wx:if="{{draft.dishes.length}}" class="workspace-menu-section">
          <view class="ew-section-title">{{status === 'planned' ? '本餐安排' : '这一餐，这样搭。'}}</view>
          <view class="workspace-menu">
            <compact-dish-row wx:for="{{draft.dishes}}" wx:key="id" dish="{{item}}" busy="{{item.actionBusy}}" disabled="{{busy || contextLocked}}" feedback="{{item.actionMessage}}" bind:view="onDishOpen" bind:replace="onReplace" />
          </view>
          <view class="workspace-menu-footer"><text wx:if="{{draft.totalCookMinutes}}" class="ew-muted">已知用时约 {{draft.totalCookMinutes}} 分钟 · 依次制作</text><button class="ew-hit-target ew-link" disabled="{{contextLocked}}" bindtap="onRegenerate">换一套</button><button class="ew-hit-target ew-link" disabled="{{contextLocked || !draft.history.length}}" bindtap="onUndo">撤销</button></view>
          <view wx:if="{{draft.explanations.length}}" class="workspace-reasons"><text wx:for="{{draft.explanations}}" wx:key="*this" class="ew-muted">{{item}}</text></view>
        </view>

        <view wx:if="{{legacyLockNotice}}" class="ew-notice" role="status">{{legacyLockNotice}}</view>
        <action-feedback feedback="{{actionFeedback}}" busy="{{busy || contextLocked}}" bind:undo="onUndo" />
        <view wx:if="{{linkedPlan}}" class="workspace-next"><button class="ew-hit-target workspace-next-row" bindtap="onShoppingPreview"><view><text class="ew-title">准备食材</text><text class="ew-muted">先核对本餐用量，再加入清单</text></view><ui-icon name="chevron-right" tone="muted" size="18" /></button><button class="ew-hit-target workspace-next-row" bindtap="onViewPlan"><view><text class="ew-title">{{actual && actual.status === 'eaten' ? '查看饮食记录' : '记录饮食'}}</text><text class="ew-muted">只记录实际吃过的食物，保存菜单不会自动记录。已记录的用餐可参与近期重复推荐判断，不等于推荐效果已验证。</text></view><ui-icon name="chevron-right" tone="muted" size="18" /></button></view>
        <button class="ew-hit-target ew-link" disabled="{{busy}}" bindtap="onToggleExtraActions">更多餐单操作</button>
        <view wx:if="{{harnessMessage}}" class="ew-notice" role="status">{{harnessTargetLabel}} {{harnessMessage}}<button class="ew-hit-target ew-link" bindtap="onToggleExtraActions">查看任务与恢复</button></view>
        <view wx:if="{{actual && actual.status === 'eaten'}}" class="workspace-light-actions"><button class="ew-hit-target ew-link" bindtap="onReview">饮食回顾</button></view>

      </block>
    </view>
  </scroll-view>
  <view class="ew-bottom"><text wx:if="{{primaryAction === 'onConfirmPlan'}}" class="workspace-save-target ew-muted">{{context.date}} {{mealName}} · 仅保存计划，不记录吃过</text><ui-button class="workspace-primary-control" label="{{primaryLabel}}" loading="{{busy}}" disabled="{{primaryDisabled || loading}}" bind:action="onPrimaryAction" /></view>
  <ui-sheet visible="{{moreVisible}}" title="更多餐单操作" busy="{{busy}}" bind:close="onCloseMore">
    <ui-button label="存为常用菜单" variant="secondary" disabled="{{busy || !draft.dishes.length}}" bind:action="onSaveReusableMenu" />
    <text class="ew-muted">保存可复用模板，日历中的安排与实际记录保留。</text>
    <ui-button label="查看助手历史" variant="tertiary" disabled="{{busy}}" bind:action="onOpenAdvancedAssistant" />
    <text class="ew-title">保存计划与周回顾</text><text class="ew-muted">跨模块操作会先预览并确认。保存计划不会算作实际吃过。</text>
    <ui-button label="预览保存计划与周回顾" variant="secondary" disabled="{{busy || !canConfirm}}" bind:action="onSaveAndReview" />
    <view wx:if="{{harnessMessage}}" class="ew-notice" role="status">{{harnessTargetLabel}} {{harnessMessage}}</view>
    <ui-button wx:if="{{harnessRetryable}}" label="查询并恢复原任务" variant="tertiary" disabled="{{busy}}" bind:action="onRecoverControlledTask" />
    <ui-button wx:if="{{harnessReport}}" label="查看这一周的实际回顾" variant="tertiary" disabled="{{busy}}" bind:action="onControlledReport" />
    <ui-button slot="footer" label="完成" bind:action="onCloseMore" />
  </ui-sheet>
  <ui-sheet visible="{{peopleVisible}}" title="用餐人数" busy="{{busy}}" bind:close="onClosePeople">
    <text class="ew-muted">只用于当前这一餐，手动搭配不会随人数变化。</text>
    <view class="workspace-people"><view class="workspace-stepper"><button class="ew-hit-target ew-link" aria-label="减少一人" disabled="{{loading || contextLocked || context.people <= 1}}" data-delta="-1" bindtap="onPeopleStep">−</button><input class="workspace-people-input" aria-label="用餐人数，1 至 50 人" type="number" value="{{peopleInput}}" disabled="{{loading || contextLocked}}" bindinput="onPeopleInput" /><text>人</text><button class="ew-hit-target ew-link" aria-label="增加一人" disabled="{{loading || contextLocked || context.people >= 50}}" data-delta="1" bindtap="onPeopleStep">+</button></view></view>
    <view wx:if="{{peopleError}}" class="ew-error" role="alert">{{peopleError}}</view><ui-button slot="footer" label="完成" disabled="{{peopleError}}" bind:action="onClosePeople" />
  </ui-sheet>
  <ui-sheet visible="{{compositionVisible}}" title="本餐搭配" busy="{{compositionSaving || busy}}" bind:close="onCloseComposition">
    <text class="ew-title">{{compositionDraftModeLabel}} · 合计 {{compositionTotal}} 道</text>
    <text class="ew-muted">每类 0 至 10 道，一餐合计 1 至 10 道。应用后保留当前菜单，换一套后生效。</text>
    <view class="workspace-composition-presets"><button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" data-id="one-meat-two-veg" bindtap="onCompositionPreset">一荤两素</button><button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" data-id="two-meat-one-veg" bindtap="onCompositionPreset">两荤一素</button><button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" data-id="one-meat-one-veg-soup" bindtap="onCompositionPreset">一荤一素一汤</button></view>
    <view class="workspace-composition-row" wx:for="{{compositionRows}}" wx:key="type"><text>{{item.label}}</text><view class="workspace-stepper"><button class="ew-hit-target ew-link" aria-label="减少一道{{item.label}}" disabled="{{compositionSaving || contextLocked || item.minusDisabled}}" data-type="{{item.type}}" data-delta="-1" bindtap="onCompositionStep">−</button><input class="workspace-people-input" aria-label="{{item.label}}数量，0 至 10 道" type="number" value="{{item.count}}" disabled="{{compositionSaving || contextLocked}}" data-type="{{item.type}}" bindinput="onCompositionInput" /><button class="ew-hit-target ew-link" aria-label="增加一道{{item.label}}" disabled="{{compositionSaving || contextLocked || item.plusDisabled}}" data-type="{{item.type}}" data-delta="1" bindtap="onCompositionStep">+</button></view></view>
    <button class="ew-hit-target ew-link" disabled="{{compositionSaving || contextLocked}}" bindtap="onCompositionAuto">恢复按人数自动搭配</button>
    <view wx:if="{{compositionHint || errorMessage}}" class="ew-error" role="alert">{{compositionHint || errorMessage}}</view>
    <ui-button wx:if="{{syncStatus === 'unknown' || syncStatus === 'offline' || syncStatus === 'conflict'}}" label="{{primaryLabel}}" variant="secondary" disabled="{{busy}}" bind:action="onPrimaryAction" />
    <ui-button slot="footer" label="应用搭配" loading="{{compositionSaving}}" disabled="{{compositionApplyDisabled || compositionSaving || contextLocked || peopleError}}" bind:action="onApplyComposition" />
  </ui-sheet>
  <ui-sheet visible="{{requirementsVisible}}" title="本餐要求（选填）" busy="{{voicePhase !== 'idle' || requirementsSaving}}" bind:close="onCancelRequirements">
    <text class="ew-muted">{{hardExclusionSummary}}</text>
    <textarea class="ew-input workspace-requirements" placeholder-class="ew-placeholder" value="{{requirementsDraft}}" maxlength="2000" placeholder="口味、忌口，或你想保留的菜" bindinput="onRequirementsDraftInput" adjust-position cursor-spacing="24" />
    <view wx:if="{{errorMessage}}" class="ew-notice">{{errorMessage}}</view><view class="workspace-light-actions"><ui-button label="清空本餐要求" variant="tertiary" disabled="{{requirementsSaving}}" bind:action="onClearRequirements" /></view>
    <ui-button label="继续本餐对话" variant="secondary" disabled="{{contextLocked || requirementsSaving}}" bind:action="onContinueMealConversation" />
    <text class="ew-muted">可留空，只影响本餐。应用后才更新，长期忌口仍然保留。</text><ui-button slot="footer" label="应用本餐要求" loading="{{requirementsSaving}}" disabled="{{voicePhase !== 'idle' || requirementsSaving || contextLocked}}" bind:action="onApplyRequirements" />
  </ui-sheet>
  <ui-sheet visible="{{settingsVisible}}" title="本餐设置" busy="{{busy}}" bind:close="onCloseMealSettings">
    <ui-field label="整餐用时上限（分钟，可留空）" value="{{settingsContext && settingsContext.totalCookMinutes != null ? '' + settingsContext.totalCookMinutes : ''}}" type="number" bind:change="onTimeSetting" /><ui-field label="已有食材（用顿号分隔）" value="{{ownedText}}" bind:change="onOwnedSetting" />
    <view wx:if="{{settingsError}}" class="ew-error">{{settingsError}}</view><ui-button slot="footer" label="应用本餐设置" bind:action="onApplyMealSettings" />
  </ui-sheet>
  <include src="meal-actual-sheet.wxml" />
  <ui-sheet visible="{{confirmationVisible}}" title="{{confirmationTitle}}" busy="{{busy}}" bind:close="onCloseConfirmation">
    <text class="ew-title">当前菜单 · {{savePeople}} 人</text><text class="ew-reading">{{saveDishSummary}}</text>
    <view class="workspace-save-fields"><picker class="ew-hit-target" mode="date" aria-label="保存日期，{{saveTarget.date}}" value="{{saveTarget.date}}" disabled="{{saveTargetLocked}}" bindchange="onSaveTargetDate"><view class="ew-hit-target workspace-save-field"><text>保存日期</text><text>{{saveTarget.date}}</text></view></picker><picker class="ew-hit-target" mode="selector" aria-label="保存餐次，{{mealLabels[saveMealIndex]}}" range="{{mealLabels}}" value="{{saveMealIndex}}" disabled="{{saveTargetLocked}}" bindchange="onSaveTargetMeal"><view class="ew-hit-target workspace-save-field"><text>餐次</text><text>{{mealLabels[saveMealIndex]}}</text></view></picker></view>
    <text class="ew-title">{{saveDateLabel}}</text><text wx:if="{{saveCrossDayNotice}}" class="ew-muted">{{saveCrossDayNotice}}</text><text class="ew-reading">{{confirmationText}}</text>
    <view wx:if="{{saveTargetLoading}}" class="ew-notice" role="status">正在核对目标安排…</view><view wx:if="{{saveError}}" class="ew-error" role="alert">{{saveError}}</view>
    <view wx:if="{{saveReplacementApproved}}" class="ew-notice" role="status">请核对原安排和当前菜单，再确认替换。</view>
    <ui-button wx:if="{{saveRecoveryPending}}" label="查询并重试原保存" variant="secondary" disabled="{{busy}}" bind:action="onRetryWorkspace" />
    <ui-button wx:if="{{saveError && !saveRecoveryPending}}" label="重新核对原菜单与目标安排" variant="secondary" disabled="{{busy || saveTargetLoading}}" bind:action="onRefreshSaveTarget" />
    <ui-button slot="footer" label="{{confirmationLabel}}" loading="{{busy}}" disabled="{{busy || saveTargetLocked || saveTargetLoading || saveError || peopleError}}" bind:action="onApproveReplacement" />
  </ui-sheet>
</view>
