# 通义千问 API Key（可选，旧图工作流使用）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DeepSeek Chat API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 模型驱动 Agent（失败时自动降级到本地规则）
ASSISTANT_AGENT_MODE=model
ASSISTANT_MAX_TOOL_ROUNDS=8
ASSISTANT_MAX_TOOL_CALLS=16
ASSISTANT_TASK_TIMEOUT_SECONDS=30
# 可选：会话侧库和辅助索引路径
# ASSISTANT_STORE_PATH=./assistant_sessions.sqlite3
# DISH_META_PATH=./dish_meta.json
# INGREDIENT_MAP_PATH=./ingredient_map.json

# MySQL 数据库（推荐服务只读访问，生产环境请使用只读账户）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=food_reader
DB_PASSWORD=change_me
DB_NAME=food

# 服务监听端口
PORT=8000
